<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog - FitCity</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <script>tailwind.config = { theme: { extend: { colors: { primary: '#16A34A' } } } } }</script>
    <style>body { font-family: 'Inter', sans-serif; background: #F8FAF7; }</style>
</head>
<body>
    <nav class="px-6 py-4 flex justify-between items-center bg-white border-b">
        <a href="/" class="text-xl font-black text-primary">FITCITY</a>
        <a href="/contact" class="text-sm font-semibold text-slate-600">Liên hệ</a>
    </nav>
    <main class="max-w-4xl mx-auto px-6 py-12">
        <h1 class="text-3xl font-black mb-8">Blog FitCity</h1>
        <% if (!posts || posts.length === 0) { %>
        <p class="text-slate-500">Chưa có bài viết nào.</p>
        <% } else { %>
        <div class="grid gap-6">
            <% posts.forEach(p => { %>
            <a href="/blog/<%= p.slug %>" class="block bg-white rounded-xl border border-slate-200 p-6 hover:shadow-md transition-shadow">
                <h2 class="text-xl font-bold text-slate-900"><%= p.title %></h2>
                <% if (p.excerpt) { %><p class="text-slate-600 mt-2 text-sm"><%= p.excerpt %></p><% } %>
                <p class="text-xs text-slate-400 mt-3"><%= new Date(p.publishedAt || p.createdAt).toLocaleDateString('vi-VN') %></p>
            </a>
            <% }) %>
        </div>
        <% } %>
    </main>
</body>
</html>
