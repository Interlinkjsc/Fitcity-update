<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.seoTitle || post.title %> - FitCity</title>
    <% if (post.seoDescription) { %><meta name="description" content="<%= post.seoDescription %>"><% } %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; background: #fff; }</style>
</head>
<body>
    <nav class="px-6 py-4 border-b">
        <a href="/blog" class="text-sm text-primary font-bold">← Blog</a>
    </nav>
    <article class="max-w-3xl mx-auto px-6 py-12">
        <% if (post.imageUrl) { %>
        <img src="<%= post.imageUrl %>" alt="" class="w-full rounded-2xl mb-8 object-cover max-h-80">
        <% } %>
        <h1 class="text-4xl font-black text-slate-900 mb-4"><%= post.title %></h1>
        <p class="text-sm text-slate-400 mb-8"><%= new Date(post.publishedAt || post.createdAt).toLocaleDateString('vi-VN') %></p>
        <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed whitespace-pre-line"><%- post.body || post.excerpt || '' %></div>
    </article>
</body>
</html>
