<%- include('partials/header', { title: 'Hồ sơ cá nhân', activePage: 'profile' }) %>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">Cài đặt Tài khoản</h2>
    <p class="text-slate-500 text-sm mt-1">Quản lý thông tin cá nhân, bảo mật và tài khoản ngân hàng của bạn.</p>
</div>

<div class="max-w-4xl">
    <form action="/auth/profile" method="POST" class="space-y-6">
        <!-- Card: Thông tin cơ bản -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
                <h3 class="font-semibold text-slate-800 flex items-center gap-2">
                    <svg class="h-5 w-5 text-lime-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    Thông tin Cá nhân
                </h3>
            </div>
            
            <div class="p-6">
                <div class="flex flex-col md:flex-row gap-8 items-start mb-8 pb-8 border-b border-slate-100">
                    <!-- Avatar Section -->
                    <div class="relative group mx-auto md:mx-0">
                        <%
                            const _pHasRealAvatar = user.avatar && user.avatar.startsWith('http') && !user.avatar.includes('default-avatar');
                        %>
                        <img src="<%= _pHasRealAvatar ? user.avatar : '/images/default-avatar-client.svg' %>"
                             alt="Avatar"
                             style="width:128px;height:128px;border-radius:12px;border:2px solid #e2e8f0;box-shadow:0 1px 4px rgba(0,0,0,.1);object-fit:cover;background:#EFF6FF;"
                             onerror="this.onerror=null;this.src='/images/default-avatar-client.svg'">
                        <div class="absolute -bottom-2 -right-2 p-2 bg-white rounded-full shadow-md border border-slate-100 text-slate-500 hover:text-lime-600 cursor-pointer transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        </div>
                    </div>
                    
                    <div class="flex-1 space-y-3 text-center md:text-left">
                        <div>
                            <h4 class="text-xl font-bold text-slate-900"><%= user.name %></h4>
                            <p class="text-slate-500 text-sm"><%= user.email %></p>
                        </div>
                        <div class="flex flex-wrap justify-center md:justify-start gap-2 pt-1">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                                <%= user.role %>
                            </span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-600 border border-emerald-100">
                                Active Account
                            </span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Số điện thoại liên hệ</label>
                        <input type="tel" name="phone" value="<%= user.phone %>" 
                               class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white"
                               placeholder="09xx xxx xxx">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-400 mb-1">Số CCCD / Passport (Bị khóa)</label>
                        <div class="relative">
                            <input type="text" value="<%= user.cccdHash || 'Chưa cập nhật' %>" disabled
                                   class="block w-full rounded-md border-slate-200 bg-slate-50 text-slate-400 text-sm py-2 px-3 border font-mono italic">
                            <svg class="absolute right-3 top-2.5 h-4 w-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 00-2 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card: Thông tin Ngân hàng -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
                <h3 class="font-semibold text-slate-800 flex items-center gap-2">
                    <svg class="h-5 w-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                    </svg>
                    Thông tin Nhận lương & Thanh toán
                </h3>
            </div>
            
            <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Ngân hàng</label>
                    <select name="bankName" class="block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-500 text-sm py-2 px-3 border bg-white">
                        <option value="">-- Chọn ngân hàng --</option>
                        <option value="Vietcombank" <%= user.bankInfo && user.bankInfo.bankName === 'Vietcombank' ? 'selected' : '' %>>Vietcombank</option>
                        <option value="Techcombank" <%= user.bankInfo && user.bankInfo.bankName === 'Techcombank' ? 'selected' : '' %>>Techcombank</option>
                        <option value="MB Bank" <%= user.bankInfo && user.bankInfo.bankName === 'MB Bank' ? 'selected' : '' %>>MB Bank</option>
                        <option value="BIDV" <%= user.bankInfo && user.bankInfo.bankName === 'BIDV' ? 'selected' : '' %>>BIDV</option>
                        <option value="TPBank" <%= user.bankInfo && user.bankInfo.bankName === 'TPBank' ? 'selected' : '' %>>TPBank</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Số tài khoản</label>
                    <input type="text" name="accountNumber" value="<%= user.bankInfo ? user.bankInfo.accountNumber : '' %>"
                           class="block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-500 text-sm py-2 px-3 border font-mono"
                           placeholder="Nhập số tài khoản">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Tên chủ tài khoản</label>
                    <input type="text" name="accountName" value="<%= user.bankInfo ? user.bankInfo.accountName : '' %>"
                           class="block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-500 text-sm py-2 px-3 border uppercase"
                           placeholder="NGUYEN VAN A">
                </div>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 pt-4">
            <button type="button" onclick="openChangePassword()" 
                    class="w-full sm:w-auto px-6 py-2.5 text-sm font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-[20px]">lock_reset</span>
                Đổi mật khẩu bảo mật
            </button>
            
            <div class="flex w-full sm:w-auto gap-3">
                <a href="/" class="flex-1 sm:flex-none px-6 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-800 transition-colors flex items-center justify-center">Hủy bỏ</a>
                <button type="submit" class="flex-1 sm:flex-none px-10 py-2.5 bg-lime-500 hover:bg-lime-600 text-slate-900 font-bold rounded-lg shadow-sm transition-all active:scale-95">
                    LƯU HỒ SƠ
                </button>
            </div>
        </div>
    </form>

    <div class="mt-12 pt-6 border-t border-slate-200 flex justify-center">
        <form action="/auth/logout" method="POST" onsubmit="return confirm('Xác nhận đăng xuất khỏi hệ thống?')">
            <button type="submit" class="text-rose-500 hover:text-rose-700 text-sm font-semibold flex items-center gap-2 px-4 py-2 hover:bg-rose-50 rounded-lg transition-colors">
                <span class="material-symbols-outlined text-[18px]">logout</span>
                Đăng xuất tài khoản
            </button>
        </form>
    </div>
</div>

<!-- Password Modal (Standard Admin Pattern) -->
<div id="passwordModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm" onclick="closeChangePassword()"></div>
        <div class="relative bg-white rounded-xl shadow-2xl w-full max-w-md overflow-hidden border border-slate-200">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex justify-between items-center">
                <h3 class="font-bold text-slate-800">Cấp lại mật khẩu mới</h3>
                <button onclick="closeChangePassword()" class="text-slate-400 hover:text-slate-600">&times;</button>
            </div>
            <form id="changePasswordForm" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Mật khẩu hiện tại</label>
                    <input type="password" name="oldPassword" required class="block w-full rounded-md border-slate-300 text-sm py-2 px-3 border">
                </div>
                <div class="border-t border-slate-100 pt-4">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Mật khẩu mới</label>
                    <input type="password" name="newPassword" required minlength="6" class="block w-full rounded-md border-slate-300 text-sm py-2 px-3 border focus:ring-lime-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Xác nhận mật khẩu</label>
                    <input type="password" name="confirmPassword" required minlength="6" class="block w-full rounded-md border-slate-300 text-sm py-2 px-3 border focus:ring-lime-500">
                </div>
                <div class="pt-4 flex gap-3">
                    <button type="button" onclick="closeChangePassword()" class="flex-1 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-md">Hủy</button>
                    <button type="submit" class="flex-1 py-2 text-sm font-bold text-slate-900 bg-lime-500 rounded-md shadow-sm">XÁC NHẬN</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openChangePassword() { document.getElementById('passwordModal').classList.remove('hidden'); }
    function closeChangePassword() { document.getElementById('passwordModal').classList.add('hidden'); }

    document.getElementById('changePasswordForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());
        if (data.newPassword !== data.confirmPassword) { alert('Mật khẩu mới không khớp!'); return; }
        try {
            const res = await fetch('/auth/change-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.status === 'success') { alert('Đổi mật khẩu thành công!'); closeChangePassword(); } 
            else { alert(result.message || 'Có lỗi xảy ra'); }
        } catch (err) { alert('Lỗi kết nối server'); }
    });
</script>

<%- include('partials/footer') %>
