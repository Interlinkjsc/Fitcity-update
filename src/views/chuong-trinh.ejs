<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chương trình tập luyện - FitCity</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap" rel="stylesheet">
    <script>tailwind.config = { theme: { extend: { colors: { primary: '#16A34A' } } } }</script>
    <style>body { font-family: 'Inter', sans-serif; background: #F8FAF7; }</style>
</head>
<body>
    <nav class="px-6 py-4 flex justify-between items-center bg-white border-b border-slate-200 sticky top-0 z-50">
        <a href="/" class="text-xl font-black text-primary">FITCITY</a>
        <div class="flex gap-6 text-sm font-semibold text-slate-600">
            <a href="/chi-nhanh" class="hover:text-primary">Chi nhánh</a>
            <a href="/chuong-trinh" class="text-primary">Chương trình</a>
            <a href="/blog" class="hover:text-primary">Blog</a>
            <a href="/contact" class="hover:text-primary">Liên hệ</a>
        </div>
    </nav>

    <main class="max-w-5xl mx-auto px-6 py-14">
        <h1 class="text-4xl font-black text-slate-900 mb-2">Chương trình Tập luyện</h1>
        <p class="text-slate-500 mb-10">Được thiết kế riêng cho từng độ tuổi và mục tiêu.</p>

        <% if (!programs || programs.length === 0) { %>
        <div class="text-center py-20 text-slate-400">
            <p class="text-5xl mb-4">🏃</p>
            <p class="font-semibold">Đang cập nhật chương trình tập luyện...</p>
        </div>
        <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% programs.forEach(p => { %>
            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col">
                <% if (p.imageUrl) { %>
                <img src="<%= p.imageUrl %>" alt="<%= p.name %>" class="w-full h-44 object-cover">
                <% } else { %>
                <div class="w-full h-44 flex items-center justify-center text-5xl" style="background: <%= p.accent || '#c3d500' %>22;">
                    🏋️
                </div>
                <% } %>
                <div class="p-5 flex flex-col flex-1">
                    <div class="flex items-start justify-between gap-2 mb-2">
                        <h2 class="text-lg font-black text-slate-900"><%= p.name %></h2>
                        <% if (p.ages) { %>
                        <span class="px-2 py-0.5 text-[10px] font-black uppercase rounded-full shrink-0 border" style="color:<%= p.accent || '#16A34A' %>; border-color:<%= p.accent || '#16A34A' %>44; background:<%= p.accent || '#16A34A' %>11;"><%= p.ages %></span>
                        <% } %>
                    </div>
                    <% if (p.tagline) { %>
                    <p class="text-sm font-semibold text-slate-700 mb-2"><%= p.tagline %></p>
                    <% } %>
                    <% if (p.summary) { %>
                    <p class="text-sm text-slate-500 flex-1"><%= p.summary %></p>
                    <% } %>
                    <div class="mt-4">
                        <a href="/#trial" class="inline-block w-full text-center px-4 py-2.5 text-sm font-black text-white rounded-xl hover:brightness-110 transition-all" style="background:<%= p.accent || '#16A34A' %>;">
                            Đăng ký tư vấn
                        </a>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
    </main>

    <footer class="py-10 border-t border-slate-200 bg-white mt-10">
        <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="text-lg font-black text-primary">FITCITY</div>
            <div class="text-[11px] text-slate-400">© 2026 FitCity. Toàn quyền bảo lưu.</div>
        </div>
    </footer>
</body>
</html>
