<%- include('../../partials/header', { title: 'PT nghỉ giữa kỳ', activePage: 'pt-leave' }) %>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">Yêu cầu PT nghỉ giữa kỳ</h2>
    <p class="text-slate-500 text-sm">Duyệt nghỉ và chuyển HĐ sang PT thay thế</p>
</div>

<form method="GET" class="mb-6 flex gap-3 bg-white p-4 rounded-xl border">
    <select name="status" class="border rounded-lg text-sm py-2 px-3">
        <option value="all">Mọi trạng thái</option>
        <option value="Pending" <%= currentFilter.status === 'Pending' ? 'selected' : '' %>>Chờ duyệt</option>
        <option value="Approved" <%= currentFilter.status === 'Approved' ? 'selected' : '' %>>Đã duyệt</option>
        <option value="Rejected" <%= currentFilter.status === 'Rejected' ? 'selected' : '' %>>Từ chối</option>
    </select>
    <button type="submit" class="px-4 py-2 bg-slate-800 text-white text-sm font-bold rounded-lg">Lọc</button>
</form>

<div class="space-y-4">
    <% if (!requests.length) { %><p class="text-slate-400 text-center py-12">Chưa có yêu cầu.</p><% } %>
    <% requests.forEach(req => { %>
    <div class="bg-white rounded-xl border border-slate-200 p-5">
        <div class="flex justify-between items-start mb-3">
            <div>
                <p class="font-bold text-slate-800"><%= req.pt?.name %></p>
                <p class="text-xs text-slate-500"><%= req.branch?.name %> · <%= new Date(req.startDate).toLocaleDateString('vi-VN') %> – <%= new Date(req.endDate).toLocaleDateString('vi-VN') %></p>
            </div>
            <span class="text-[10px] font-bold px-2 py-1 rounded-full <%= req.status === 'Approved' ? 'bg-emerald-100 text-emerald-700' : req.status === 'Rejected' ? 'bg-rose-100 text-rose-700' : 'bg-amber-100 text-amber-700' %>"><%= req.status %></span>
        </div>
        <p class="text-sm text-slate-600 mb-4"><%= req.reason %></p>
        <% if (req.status === 'Approved' && req.replacementPt) { %>
        <p class="text-xs text-emerald-700">PT thay thế: <%= req.replacementPt.name %> · <%= req.contractsReassigned %> HĐ đã chuyển</p>
        <% } %>
        <% if (req.status === 'Pending') { %>
        <form action="/admin/pt-leave-requests/approve/<%= req._id %>" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-3 items-end border-t pt-4">
            <div class="md:col-span-2">
                <label class="text-xs font-semibold text-slate-500">PT thay thế *</label>
                <select name="replacementPtId" required class="w-full border rounded-lg text-sm py-2 mt-1">
                    <option value="">— Chọn PT —</option>
                    <% pts.forEach(p => { if (p._id.toString() !== req.pt._id.toString()) { %>
                    <option value="<%= p._id %>"><%= p.name %></option>
                    <% } }) %>
                </select>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="flex-1 py-2 bg-emerald-600 text-white text-xs font-bold rounded-lg">Duyệt & chuyển HĐ</button>
            </div>
        </form>
        <form action="/admin/pt-leave-requests/reject/<%= req._id %>" method="POST" class="mt-2" onsubmit="return confirm('Từ chối?')">
            <button type="submit" class="text-xs text-rose-600 font-bold">Từ chối</button>
        </form>
        <% } %>
    </div>
    <% }) %>
</div>

<%- include('../../partials/footer') %>
