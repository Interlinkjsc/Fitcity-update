<%- include('../../partials/header', { title: 'Chi tiết Khuyến mãi', activePage: 'coupons' }) %>

<div class="max-w-4xl mx-auto">
    <!-- Header Page -->
    <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <a href="/admin/coupons" class="text-sm text-slate-500 hover:text-lime-600 transition-colors flex items-center gap-1 mb-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Quay lại danh sách Mã giảm giá
            </a>
            <h2 class="text-2xl font-bold text-slate-800">Chi tiết Mã: <span class="text-lime-600 uppercase font-mono"><%= coupon.code %></span></h2>
        </div>
        <div class="flex gap-2">
            <a href="/admin/coupons/edit/<%= coupon._id %>" class="inline-flex items-center justify-center px-4 py-2 bg-blue-50 text-blue-700 hover:bg-blue-100 font-semibold rounded-lg transition-colors shadow-sm">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                Chỉnh sửa
            </a>
        </div>
    </div>

    <!-- 360 View -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <!-- Configuration Card -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="p-6 border-b border-slate-100 flex items-center gap-3">
                <div class="p-2 bg-slate-50 text-slate-600 rounded-lg">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-800">Cấu hình Giảm giá</h3>
            </div>
            <div class="p-6 space-y-5">
                <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                    <span class="text-sm font-medium text-slate-500">Mã Code</span>
                    <span class="font-mono font-bold text-slate-800 bg-slate-100 px-2 py-0.5 rounded"><%= coupon.code %></span>
                </div>
                <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                    <span class="text-sm font-medium text-slate-500">Loại giảm</span>
                    <span class="font-bold text-slate-800 text-sm">
                        <% if (coupon.type === 'Percentage') { %>Phần trăm (%)<% } else if (coupon.type === 'Fixed') { %>Số tiền cố định (VNĐ)<% } else if (coupon.type === 'FreeSessions') { %>Tặng buổi tập<% } else { %><%= coupon.type %><% } %>
                    </span>
                </div>
                <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                    <span class="text-sm font-medium text-slate-500">Giá trị</span>
                    <span class="font-bold text-rose-600 text-lg">
                        <% if (coupon.type === 'FreeSessions') { %>
                            <%= coupon.value %> buổi tập
                        <% } else if (coupon.type === 'Percentage') { %>
                            <%= coupon.value %>%
                        <% } else { %>
                            <%= new Intl.NumberFormat('vi-VN').format(coupon.value) %> đ
                        <% } %>
                    </span>
                </div>
                <% if(coupon.type === 'Percentage') { %>
                <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                    <span class="text-sm font-medium text-slate-500">Giảm tối đa (Max Discount)</span>
                    <span class="font-bold text-slate-800 text-sm"><%= new Intl.NumberFormat('vi-VN').format(coupon.maxDiscount || 0) %> đ</span>
                </div>
                <% } %>
                <div class="flex justify-between items-center">
                    <span class="text-sm font-medium text-slate-500">Người khởi tạo</span>
                    <span class="font-semibold text-slate-700 text-sm"><%= coupon.createdBy ? coupon.createdBy.name : 'System' %></span>
                </div>
            </div>
        </div>

        <!-- Metric Card -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="p-6 border-b border-slate-100 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-emerald-50 text-emerald-600 rounded-lg">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800">Hiệu suất Thực hiện</h3>
                </div>
                <% if(coupon.usageLimit <= 0 || (coupon.endDate && new Date(coupon.endDate) < new Date())) { %>
                    <span class="text-[10px] bg-rose-50 text-rose-600 px-2 py-0.5 rounded-lg font-bold uppercase">Hết hạn</span>
                <% } else { %>
                    <span class="text-[10px] bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded-lg font-bold uppercase">Hoạt động</span>
                <% } %>
            </div>
            <div class="p-6 space-y-6">
                <!-- Usage Indicator -->
                <div>
                    <div class="flex justify-between items-end mb-2">
                        <span class="text-sm font-medium text-slate-500">Giới hạn sử dụng & Tốc độ</span>
                        <span class="text-xl font-black text-slate-800">
                            <%= coupon.usageCount %> <span class="text-sm text-slate-400 font-normal">/ <%= coupon.usageLimit + coupon.usageCount %></span>
                        </span>
                    </div>
                    <div class="h-2.5 w-full bg-slate-100 rounded-full overflow-hidden">
                        <% 
                            let totalLimit = (coupon.usageLimit + coupon.usageCount);
                            let percent = totalLimit > 0 ? (coupon.usageCount / totalLimit) * 100 : 0;
                        %>
                        <div class="h-full <%= percent > 80 ? 'bg-amber-500' : 'bg-emerald-500' %> transition-all" style="width: <%= percent %>%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-slate-400 mt-1.5">
                        <span>Đã sử dụng: <%= coupon.usageCount %></span>
                        <span>Còn lại: <%= coupon.usageLimit %></span>
                    </div>
                </div>

                <div class="space-y-4 pt-4 border-t border-slate-100">
                    <div class="flex justify-between items-center">
                        <span class="text-sm font-medium text-slate-500 flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Ngày bắt đầu
                        </span>
                        <span class="font-semibold text-slate-800 text-sm">
                            <%= coupon.startDate ? new Date(coupon.startDate).toLocaleDateString('vi-VN') : 'Ngay lúc tạo' %>
                        </span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm font-medium text-slate-500 flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Ngày kết thúc
                        </span>
                        <span class="font-semibold text-slate-800 text-sm">
                            <%= coupon.endDate ? new Date(coupon.endDate).toLocaleDateString('vi-VN') : 'Không bao giờ' %>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/footer') %>
