<%- include('../../partials/header', { title: 'Daily Report', activePage: 'daily-reports' }) %>

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">Daily Report nhân sự</h2>
        <p class="text-slate-500 text-sm mt-1">Manager duyệt báo cáo công việc hàng ngày</p>
    </div>
    <a href="/admin/daily-reports/submit" class="px-4 py-2 bg-lime-500 text-slate-900 font-bold rounded-lg text-sm">+ Nộp báo cáo</a>
</div>

<form method="GET" class="mb-6 grid grid-cols-1 sm:grid-cols-5 gap-3 bg-white p-4 rounded-xl border border-slate-200">
    <select name="month" class="border rounded-lg text-sm py-2 px-3">
        <% for (let m = 1; m <= 12; m++) { %><option value="<%= m %>" <%= month === m ? 'selected' : '' %>>Tháng <%= m %></option><% } %>
    </select>
    <select name="year" class="border rounded-lg text-sm py-2 px-3">
        <% for (let y = 2024; y <= new Date().getFullYear()+10; y++) { %><option value="<%= y %>" <%= year === y ? 'selected' : '' %>><%= y %></option><% } %>
    </select>
    <select name="status" class="border rounded-lg text-sm py-2 px-3">
        <option value="all">Mọi trạng thái</option>
        <option value="Pending_Approval" <%= currentFilter.status === 'Pending_Approval' ? 'selected' : '' %>>Chờ duyệt</option>
        <option value="Approved" <%= currentFilter.status === 'Approved' ? 'selected' : '' %>>Đã duyệt</option>
        <option value="Rejected" <%= currentFilter.status === 'Rejected' ? 'selected' : '' %>>Từ chối</option>
    </select>
    <select name="branchId" class="border rounded-lg text-sm py-2 px-3">
        <option value="all">Tất cả CN</option>
        <% branches.forEach(b => { %><option value="<%= b._id %>" <%= currentFilter.branchId === b._id.toString() ? 'selected' : '' %>><%= b.name %></option><% }) %>
    </select>
    <button type="submit" class="py-2 bg-slate-800 text-white text-sm font-bold rounded-lg">Lọc</button>
</form>

<div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-500 uppercase text-[10px]">
            <tr>
                <th class="px-4 py-3 text-left">Ngày</th>
                <th class="px-4 py-3 text-left">Nhân viên</th>
                <th class="px-4 py-3 text-left">Chi nhánh</th>
                <th class="px-4 py-3 text-left">Tóm tắt</th>
                <th class="px-4 py-3 text-left">Trạng thái</th>
                <th class="px-4 py-3 text-right">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            <% if (!reports.length) { %><tr><td colspan="6" class="py-12 text-center text-slate-400">Chưa có báo cáo.</td></tr><% } %>
            <% reports.forEach(r => { %>
            <tr class="hover:bg-slate-50">
                <td class="px-4 py-3"><%= new Date(r.reportDate).toLocaleDateString('vi-VN') %></td>
                <td class="px-4 py-3 font-semibold"><%= r.author?.name %> <span class="text-[10px] text-slate-400"><%= r.author?.role %></span></td>
                <td class="px-4 py-3"><%= r.branch?.name %></td>
                <td class="px-4 py-3 max-w-xs truncate text-slate-600"><%= r.summary %></td>
                <td class="px-4 py-3">
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full <%= r.status === 'Approved' ? 'bg-emerald-100 text-emerald-700' : r.status === 'Rejected' ? 'bg-rose-100 text-rose-700' : 'bg-amber-100 text-amber-700' %>"><%= r.status.replace('_', ' ') %></span>
                </td>
                <td class="px-4 py-3 text-right space-x-2">
                    <%# Bug 23/7 A8: nút xem chi tiết báo cáo (trước & sau khi duyệt) %>
                    <a href="/admin/daily-reports/detail/<%= r._id %>" class="text-indigo-600 text-xs font-bold">Xem chi tiết</a>
                    <% if (r.status === 'Pending_Approval') { %>
                    <form action="/admin/daily-reports/approve/<%= r._id %>" method="POST" class="inline"><button class="text-emerald-600 text-xs font-bold">Duyệt</button></form>
                    <form action="/admin/daily-reports/reject/<%= r._id %>" method="POST" class="inline" onsubmit="return confirm('Từ chối?')"><button class="text-rose-600 text-xs font-bold">Từ chối</button></form>
                    <% } %>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>
<%- include('../../partials/pagination') %>
<%- include('../../partials/footer') %>
