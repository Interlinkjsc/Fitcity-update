<%- include('../../partials/header', { title: isEdit ? 'Chỉnh sửa Khách hàng' : 'Thêm Khách hàng', activePage: 'clients' }) %>

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-800"><%= isEdit ? 'Cập nhật hồ sơ khách hàng' : 'Tạo hồ sơ khách hàng mới' %></h2>
        <p class="text-slate-500 text-sm mt-1">
            <a href="/admin/clients/list" class="text-blue-600 hover:underline">Quay lại danh sách</a> /
            <span><%= isEdit ? 'Chỉnh sửa' : 'Tạo mới' %></span>
        </p>
    </div>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm max-w-4xl overflow-hidden pb-8">
    <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
        <h3 class="font-semibold text-slate-800">Thông tin tài khoản hội viên</h3>
    </div>

    <form action="/admin/clients/<%= isEdit ? 'update/' + clientData._id : 'store' %>" method="POST" class="p-6 md:p-8 space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Họ và Tên <span class="text-red-500">*</span></label>
                <input type="text" id="name" name="name" required minlength="2" maxlength="80" value="<%= clientData && clientData.name ? clientData.name : '' %>"
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white"
                    placeholder="Nguyễn Văn A">
            </div>

            <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email <span class="text-red-500">*</span></label>
                <input type="email" id="email" name="email" required maxlength="120" value="<%= clientData && clientData.email ? clientData.email : '' %>"
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white"
                    placeholder="client@example.com">
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-slate-700 mb-1">Mật khẩu <%= isEdit ? '(chỉ nhập khi đổi mật khẩu)' : '<span class="text-red-500">*</span>' %></label>
                <input type="password" id="password" name="password" minlength="6" maxlength="128" <%= isEdit ? '' : 'required' %>
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white"
                    placeholder="Tối thiểu 6 ký tự">
            </div>

            <div>
                <label for="phone" class="block text-sm font-medium text-slate-700 mb-1">Số điện thoại</label>
                <input type="text" id="phone" name="phone" pattern="^(0|\+84)[35789][0-9]{8}$" value="<%= clientData && clientData.phone ? clientData.phone : '' %>"
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white"
                    placeholder="09xx...">
            </div>

            <div class="sm:col-span-2">
                <label for="branch" class="block text-sm font-medium text-slate-700 mb-1">Chi nhánh <span class="text-red-500">*</span></label>
                <select id="branch" name="branch" required
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white">
                    <option value="">— Chọn chi nhánh —</option>
                    <% const branchList = typeof branches !== 'undefined' && branches ? branches : []; %>
                    <% branchList.forEach(function (b) { 
                        const sel = clientData && clientData.branch && String(clientData.branch) === String(b._id) ? 'selected' : '';
                    %>
                    <option value="<%= b._id %>" <%= sel %>><%= b.name %></option>
                    <% }); %>
                </select>
                <p class="text-xs text-slate-500 mt-1">Bắt buộc để đồng bộ vận hành và ký hợp đồng (R4).</p>
            </div>

            <div>
                <label for="dob" class="block text-sm font-medium text-slate-700 mb-1">Ngày sinh</label>
                <input type="date" id="dob" name="dob"
                    value="<%= clientData && clientData.dob ? new Date(clientData.dob).toISOString().split('T')[0] : '' %>"
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white">
            </div>

            <%# Bug 6/7 #11: cac truong theo form hop dong mau %>
            <div>
                <label for="cccdNumber" class="block text-sm font-medium text-slate-700 mb-1">Số CCCD / Hộ chiếu</label>
                <input type="text" id="cccdNumber" name="cccdNumber" value="<%= clientData && clientData.cccdNumber ? clientData.cccdNumber : '' %>"
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white">
            </div>
            <div>
                <label for="cccdIssueDate" class="block text-sm font-medium text-slate-700 mb-1">Ngày cấp CCCD</label>
                <input type="date" id="cccdIssueDate" name="cccdIssueDate"
                    value="<%= clientData && clientData.cccdIssueDate ? new Date(clientData.cccdIssueDate).toISOString().split('T')[0] : '' %>"
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white">
            </div>
            <div>
                <label for="cccdIssuePlace" class="block text-sm font-medium text-slate-700 mb-1">Nơi cấp CCCD</label>
                <input type="text" id="cccdIssuePlace" name="cccdIssuePlace" value="<%= clientData && clientData.cccdIssuePlace ? clientData.cccdIssuePlace : '' %>"
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white">
            </div>
            <div>
                <label for="gender" class="block text-sm font-medium text-slate-700 mb-1">Giới tính</label>
                <select id="gender" name="gender" class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white">
                    <option value="">-- Chọn --</option>
                    <% ['Nam','Nữ','Khác'].forEach(g => { %>
                    <option value="<%= g %>" <%= clientData && clientData.gender === g ? 'selected' : '' %>><%= g %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Người liên hệ khẩn cấp</label>
                <input type="text" name="emergencyContact[name]" placeholder="Họ tên"
                    value="<%= clientData && clientData.emergencyContact && clientData.emergencyContact.name ? clientData.emergencyContact.name : '' %>"
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">SĐT khẩn cấp / Quan hệ</label>
                <div class="grid grid-cols-2 gap-2">
                    <input type="tel" name="emergencyContact[phone]" placeholder="SĐT"
                        value="<%= clientData && clientData.emergencyContact && clientData.emergencyContact.phone ? clientData.emergencyContact.phone : '' %>"
                        class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white">
                    <input type="text" name="emergencyContact[relationship]" placeholder="VD: Bố / Mẹ"
                        value="<%= clientData && clientData.emergencyContact && clientData.emergencyContact.relationship ? clientData.emergencyContact.relationship : '' %>"
                        class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white">
                </div>
            </div>

            <div>
                <label for="status" class="block text-sm font-medium text-slate-700 mb-1">Trạng thái tài khoản</label>
                <select id="status" name="status" class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white">
                    <option value="Active" <%= clientData && clientData.status === 'Active' ? 'selected' : '' %>>Hoạt động</option>
                    <option value="Suspended" <%= clientData && clientData.status === 'Suspended' ? 'selected' : '' %>>Tạm khóa</option>
                    <option value="Resigned" <%= clientData && clientData.status === 'Resigned' ? 'selected' : '' %>>Ngưng sử dụng</option>
                </select>
            </div>

            <div class="sm:col-span-2">
                <label for="address" class="block text-sm font-medium text-slate-700 mb-1">Địa chỉ</label>
                <input type="text" id="address" name="address" maxlength="255" value="<%= clientData && clientData.address ? clientData.address : '' %>"
                    class="block w-full rounded-md border-slate-300 shadow-sm focus:border-lime-500 focus:ring focus:ring-lime-500 text-sm py-2 px-3 border bg-white"
                    placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố">
            </div>

            <div class="sm:col-span-2 p-4 rounded-lg border border-slate-200 bg-slate-50">
                <p class="text-xs text-slate-500 leading-relaxed">
                    Khi tạo mới khách hàng từ trang này, hệ thống sẽ lưu với vai trò <span class="font-semibold text-slate-700">Client</span>.
                    Các thông tin mở rộng như hợp đồng, reward và lịch tập sẽ được cập nhật ở module tương ứng.
                </p>
            </div>
        </div>

        <div class="flex justify-end gap-3 pt-6 border-t border-slate-100">
            <a href="/admin/clients/list" class="px-5 py-2 text-sm font-medium rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors">Hủy</a>
            <button type="submit" class="px-5 py-2 text-sm font-medium rounded-md bg-lime-500 text-slate-900 border border-transparent shadow hover:bg-lime-600 focus:outline-none focus:ring-2 focus:ring-lime-500 transition-colors">
                <%= isEdit ? 'Lưu thay đổi' : 'Tạo khách hàng' %>
            </button>
        </div>
    </form>
</div>

<%- include('../../partials/footer') %>
