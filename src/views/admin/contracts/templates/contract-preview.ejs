<script>
    function scaleContent() {
        const page = document.getElementById('page1-div');
        if (!page) return;
        const padding = 40; // 20px padding left + 20px padding right
        const availableWidth = window.innerWidth - padding;
        const originalWidth = parseInt(page.style.width);
        if (availableWidth < originalWidth) {
            const scale = availableWidth / originalWidth;
            page.style.transform = `scale(${scale})`;
            page.style.transformOrigin = 'top center';
            page.style.marginBottom = `${(scale - 1) * parseInt(page.style.height) + 20}px`;
        } else {
            page.style.transform = 'none';
            page.style.marginBottom = '20px';
        }
    }
    document.addEventListener("DOMContentLoaded", function() {
        if (window.location.search.includes('modal=true')) {
            document.body.classList.add('is-modal');
        }
        scaleContent();
    });
    window.addEventListener('resize', scaleContent);
</script>
