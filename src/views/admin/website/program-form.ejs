<%- include('../../partials/header', { title: title, activePage: 'website' }) %>

<div class="mb-6">
    <nav class="text-sm text-slate-500 mb-2"><a href="/admin/website" class="hover:text-slate-800">Website</a> / <a href="/admin/website/programs" class="hover:text-slate-800">Chương trình</a> / <%= program ? 'Sửa' : 'Thêm mới' %></nav>
    <h2 class="text-2xl font-bold text-slate-800"><%= title %></h2>
</div>

<form action="/admin/website/programs/<%= program ? 'update/' + program._id : 'store' %>" method="POST" class="max-w-2xl space-y-5">
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Tên chương trình <span class="text-red-500">*</span></label>
                <input type="text" name="name" value="<%= program ? program.name : '' %>" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Độ tuổi</label>
                <input type="text" name="ages" value="<%= program ? program.ages : '' %>" placeholder="VD: 3–12 tuổi" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
            </div>
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Tagline</label>
            <input type="text" name="tagline" value="<%= program ? program.tagline : '' %>" placeholder="Câu slogan ngắn gọn" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Mô tả ngắn</label>
            <textarea name="summary" rows="2" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm"><%= program ? program.summary : '' %></textarea>
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Nội dung chi tiết</label>
            <textarea name="body" rows="6" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm"><%= program ? program.body : '' %></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">URL ảnh</label>
                <input type="text" name="imageUrl" value="<%= program ? program.imageUrl : '' %>" placeholder="https://..." class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Màu nhấn (hex)</label>
                <input type="text" name="accent" value="<%= program ? program.accent : '#c3d500' %>" placeholder="#c3d500" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Thứ tự</label>
                <input type="number" name="sort" value="<%= program ? program.sort : 0 %>" min="0" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
            </div>
            <div class="flex items-end pb-2">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="published" <%= !program || program.published ? 'checked' : '' %> class="w-4 h-4 rounded border-slate-300">
                    <span class="text-sm font-semibold text-slate-700">Hiển thị trên website</span>
                </label>
            </div>
        </div>
    </div>
    <div class="flex gap-3">
        <button type="submit" class="px-6 py-2.5 bg-lime-600 hover:bg-lime-700 text-white font-bold text-sm rounded-lg shadow-sm">Lưu</button>
        <a href="/admin/website/programs" class="px-6 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm rounded-lg">Huỷ</a>
    </div>
</form>

<%- include('../../partials/footer') %>
