<%- include('../../partials/header', { title: 'Chi nhánh Website', activePage: 'website' }) %>

<div class="mb-6 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">Chi nhánh Website</h2>
        <p class="text-slate-500 text-sm mt-1">Quản lý danh sách chi nhánh hiển thị trên website công khai.</p>
    </div>
    <a href="/admin/website/branches/create" class="flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold rounded-lg shadow-sm transition-all">
        <span class="material-symbols-outlined text-[18px]">add</span> Thêm chi nhánh
    </a>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
                <th class="text-left px-4 py-3 font-semibold text-slate-600">Tên chi nhánh</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-600 hidden md:table-cell">Địa chỉ</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-600 hidden md:table-cell">Điện thoại</th>
                <th class="text-center px-4 py-3 font-semibold text-slate-600">Trạng thái</th>
                <th class="text-right px-4 py-3 font-semibold text-slate-600">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            <% if (branches.length === 0) { %>
            <tr><td colspan="5" class="text-center text-slate-400 py-8 italic">Chưa có chi nhánh nào. <a href="/admin/website/branches/create" class="text-blue-600 underline">Thêm ngay</a></td></tr>
            <% } %>
            <% branches.forEach(b => { %>
            <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 font-bold text-slate-800">
                    <%= b.name %>
                    <% if (b.isMain) { %><span class="ml-1 px-1.5 py-0.5 bg-blue-100 text-blue-700 text-[10px] font-black uppercase rounded">Chính</span><% } %>
                </td>
                <td class="px-4 py-3 text-slate-600 hidden md:table-cell"><%= b.address || '—' %></td>
                <td class="px-4 py-3 text-slate-600 hidden md:table-cell"><%= b.phone || '—' %></td>
                <td class="px-4 py-3 text-center">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase <%= b.published ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500' %>">
                        <%= b.published ? 'Hiển thị' : 'Ẩn' %>
                    </span>
                </td>
                <td class="px-4 py-3 text-right">
                    <a href="/admin/website/branches/edit/<%= b._id %>" class="inline-flex items-center gap-1 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg transition-all mr-1">
                        <span class="material-symbols-outlined text-[14px]">edit</span>
                    </a>
                    <form action="/admin/website/branches/delete/<%= b._id %>" method="POST" class="inline" onsubmit="return confirm('Xoá chi nhánh này?')">
                        <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-bold rounded-lg transition-all">
                            <span class="material-symbols-outlined text-[14px]">delete</span>
                        </button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<%- include('../../partials/footer') %>
