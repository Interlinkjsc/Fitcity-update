<%- include('../../partials/header', { title: title, activePage: 'website' }) %>

<div class="mb-6">
    <nav class="text-sm text-slate-500 mb-2"><a href="/admin/website" class="hover:text-slate-800">Website</a> / <a href="/admin/website/posts" class="hover:text-slate-800">Bài viết</a> / <%= post ? 'Sửa' : 'Thêm mới' %></nav>
    <h2 class="text-2xl font-bold text-slate-800"><%= title %></h2>
</div>

<form action="/admin/website/posts/<%= post ? 'update/' + post._id : 'store' %>" method="POST" class="max-w-2xl space-y-5">
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Tiêu đề <span class="text-red-500">*</span></label>
            <input type="text" name="title" value="<%= post ? post.title : '' %>" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Tóm tắt</label>
            <textarea name="excerpt" rows="2" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm"><%= post ? post.excerpt : '' %></textarea>
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Nội dung</label>
            <textarea name="body" rows="12" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm font-mono"><%= post ? post.body : '' %></textarea>
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">URL ảnh bìa</label>
            <input type="text" name="heroImage" value="<%= post ? post.heroImage : '' %>" placeholder="https://..." class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Tags (cách nhau bằng dấu phẩy)</label>
            <input type="text" name="tags" value="<%= post ? post.tags.join(', ') : '' %>" placeholder="gymkid, thể thao, trẻ em" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Trạng thái</label>
            <select name="status" class="border border-slate-300 rounded-lg px-3 py-2 text-sm">
                <option value="draft" <%= !post || post.status === 'draft' ? 'selected' : '' %>>Bản nháp</option>
                <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Đăng ngay</option>
            </select>
        </div>
    </div>
    <div class="flex gap-3">
        <button type="submit" class="px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm rounded-lg shadow-sm">Lưu</button>
        <a href="/admin/website/posts" class="px-6 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm rounded-lg">Huỷ</a>
    </div>
</form>

<%- include('../../partials/footer') %>
