<%- include('../../partials/header', { title: 'Chương trình Website', activePage: 'website' }) %>

<div class="mb-6 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">Chương trình Website</h2>
        <p class="text-slate-500 text-sm mt-1">GymKid, PilatesKid, BoxingKid và các chương trình trên website.</p>
    </div>
    <a href="/admin/website/programs/create" class="flex items-center gap-2 px-4 py-2 bg-lime-600 hover:bg-lime-700 text-white text-sm font-bold rounded-lg shadow-sm transition-all">
        <span class="material-symbols-outlined text-[18px]">add</span> Thêm chương trình
    </a>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
                <th class="text-left px-4 py-3 font-semibold text-slate-600">Tên chương trình</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-600 hidden md:table-cell">Độ tuổi</th>
                <th class="text-left px-4 py-3 font-semibold text-slate-600 hidden md:table-cell">Tagline</th>
                <th class="text-center px-4 py-3 font-semibold text-slate-600">Trạng thái</th>
                <th class="text-right px-4 py-3 font-semibold text-slate-600">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            <% if (programs.length === 0) { %>
            <tr><td colspan="5" class="text-center text-slate-400 py-8 italic">Chưa có chương trình nào.</td></tr>
            <% } %>
            <% programs.forEach(p => { %>
            <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 font-bold text-slate-800"><%= p.name %></td>
                <td class="px-4 py-3 text-slate-600 hidden md:table-cell"><%= p.ages || '—' %></td>
                <td class="px-4 py-3 text-slate-500 hidden md:table-cell text-xs"><%= p.tagline ? p.tagline.substring(0, 60) : '—' %></td>
                <td class="px-4 py-3 text-center">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase <%= p.published ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500' %>">
                        <%= p.published ? 'Hiển thị' : 'Ẩn' %>
                    </span>
                </td>
                <td class="px-4 py-3 text-right">
                    <a href="/admin/website/programs/edit/<%= p._id %>" class="inline-flex items-center px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg mr-1">
                        <span class="material-symbols-outlined text-[14px]">edit</span>
                    </a>
                    <form action="/admin/website/programs/delete/<%= p._id %>" method="POST" class="inline" onsubmit="return confirm('Xoá chương trình này?')">
                        <button type="submit" class="inline-flex items-center px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-bold rounded-lg">
                            <span class="material-symbols-outlined text-[14px]">delete</span>
                        </button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<%- include('../../partials/footer') %>
