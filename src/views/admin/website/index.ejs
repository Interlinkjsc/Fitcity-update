<%- include('../../partials/header', { title: 'Quản lý Website', activePage: 'website' }) %>

<div class="mb-6 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">Quản lý Website FitCity</h2>
        <p class="text-slate-500 text-sm mt-1">Chỉnh sửa nội dung website công khai — lưu là hiển thị ngay.</p>
    </div>
    <a href="/" target="_blank" class="flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-bold rounded-lg transition-all">
        <span class="material-symbols-outlined text-[18px]">open_in_new</span> Xem Website
    </a>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <a href="/admin/website/branches" class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:border-blue-300 transition-all">
        <div class="text-3xl font-black text-blue-600"><%= stats.branches %></div>
        <div class="text-sm font-bold text-slate-700 mt-1">Chi nhánh</div>
        <div class="text-xs text-slate-400 mt-0.5">thêm/sửa/xoá địa điểm</div>
    </a>
    <a href="/admin/website/programs" class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:border-lime-300 transition-all">
        <div class="text-3xl font-black text-lime-600"><%= stats.programs %></div>
        <div class="text-sm font-bold text-slate-700 mt-1">Chương trình</div>
        <div class="text-xs text-slate-400 mt-0.5">GymKid · PilatesKid…</div>
    </a>
    <a href="/admin/website/posts" class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:border-amber-300 transition-all">
        <div class="text-3xl font-black text-amber-600"><%= stats.posts %></div>
        <div class="text-sm font-bold text-slate-700 mt-1">Bài đã đăng</div>
        <div class="text-xs text-slate-400 mt-0.5"><%= stats.drafts %> bản nháp</div>
    </a>
    <a href="/admin/website/settings" class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:border-slate-300 transition-all">
        <div class="text-3xl font-black text-slate-600">⚙</div>
        <div class="text-sm font-bold text-slate-700 mt-1">Cài đặt</div>
        <div class="text-xs text-slate-400 mt-0.5">liên hệ · hero · SEO</div>
    </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <a href="/admin/website/branches/create" class="flex items-center gap-3 bg-white border border-dashed border-blue-300 rounded-xl p-4 hover:bg-blue-50 transition-all">
        <span class="material-symbols-outlined text-2xl text-blue-500">add_location_alt</span>
        <span class="text-sm font-bold text-blue-700">Thêm chi nhánh mới</span>
    </a>
    <a href="/admin/website/programs/create" class="flex items-center gap-3 bg-white border border-dashed border-lime-300 rounded-xl p-4 hover:bg-lime-50 transition-all">
        <span class="material-symbols-outlined text-2xl text-lime-500">add_circle</span>
        <span class="text-sm font-bold text-lime-700">Thêm chương trình mới</span>
    </a>
    <a href="/admin/website/posts/create" class="flex items-center gap-3 bg-white border border-dashed border-amber-300 rounded-xl p-4 hover:bg-amber-50 transition-all">
        <span class="material-symbols-outlined text-2xl text-amber-500">edit_note</span>
        <span class="text-sm font-bold text-amber-700">Viết bài mới</span>
    </a>
</div>

<%- include('../../partials/footer') %>
