<%- include('../../partials/header', { title: 'Cài đặt Website', activePage: 'website-settings' }) %>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">Cài đặt Website</h2>
    <p class="text-slate-500 text-sm mt-1">Thay đổi logo, màu sắc, thông tin liên hệ và nội dung trang chủ</p>
</div>

<form method="POST" action="/admin/website/settings" class="space-y-8 max-w-3xl">

    <!-- LOGO -->
    <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h3 class="font-bold text-slate-800 mb-4">Logo</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Key logo sáng (header)</label>
                <input type="text" name="logo_key" value="<%= settings.logo_key || '' %>" placeholder="vd: brand/logo.webp"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
                <p class="text-xs text-slate-400 mt-1">Key file trong R2 storage</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Key logo tối (footer)</label>
                <input type="text" name="logo_dark_key" value="<%= settings.logo_dark_key || '' %>" placeholder="vd: brand/logo-dark.webp"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
        </div>
    </div>

    <!-- MÀU CHỦ ĐẠO -->
    <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h3 class="font-bold text-slate-800 mb-4">Màu chủ đạo</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Màu Forest (chủ đạo xanh)</label>
                <div class="flex items-center gap-3">
                    <input type="color" name="brand_forest" value="<%= settings.brand_forest || '#1a2e1a' %>"
                        class="w-12 h-10 rounded border border-slate-300 cursor-pointer">
                    <input type="text" id="brand_forest_text" value="<%= settings.brand_forest || '#1a2e1a' %>"
                        class="flex-1 border border-slate-300 rounded-lg text-sm py-2 px-3 font-mono focus:ring-2 focus:ring-lime-500 outline-none"
                        oninput="document.querySelector('[name=brand_forest]').value=this.value">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Màu Orange (nhấn cam/xanh lá)</label>
                <div class="flex items-center gap-3">
                    <input type="color" name="brand_orange" value="<%= settings.brand_orange || '#ccff00' %>"
                        class="w-12 h-10 rounded border border-slate-300 cursor-pointer">
                    <input type="text" id="brand_orange_text" value="<%= settings.brand_orange || '#ccff00' %>"
                        class="flex-1 border border-slate-300 rounded-lg text-sm py-2 px-3 font-mono focus:ring-2 focus:ring-lime-500 outline-none"
                        oninput="document.querySelector('[name=brand_orange]').value=this.value">
                </div>
            </div>
        </div>
    </div>

    <!-- THÔNG TIN LIÊN HỆ -->
    <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h3 class="font-bold text-slate-800 mb-4">Thông tin liên hệ</h3>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Hotline</label>
                <input type="text" name="hotline" value="<%= settings.hotline || '' %>" placeholder="vd: 090.4554.333"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                <input type="email" name="email" value="<%= settings.email || '' %>" placeholder="vd: fitcityofficial@gmail.com"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Facebook URL</label>
                <input type="url" name="facebook" value="<%= settings.facebook || '' %>" placeholder="vd: https://facebook.com/fitcity"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
        </div>
    </div>

    <!-- NỘI DUNG TRANG -->
    <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h3 class="font-bold text-slate-800 mb-4">Nội dung trang</h3>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Tiêu đề Hero trang chủ</label>
                <input type="text" name="home_hero_heading" value="<%= settings.home_hero_heading || '' %>"
                    placeholder="vd: ĐÃ KHAI TRƯƠNG..."
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Footer tagline (1 dòng)</label>
                <input type="text" name="footer_tagline" value="<%= settings.footer_tagline || '' %>"
                    placeholder="vd: Nơi trẻ khỏe mạnh, tự tin và yêu vận động"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
                <p class="text-xs text-slate-400 mt-1">Để trống để dùng mặc định 4 dòng</p>
            </div>
        </div>
    </div>

    <div class="flex gap-3">
        <button type="submit" class="px-6 py-2.5 bg-lime-500 hover:bg-lime-600 text-slate-900 font-bold rounded-lg text-sm">
            Lưu thay đổi
        </button>
        <a href="http://160.25.81.177/" target="_blank" class="px-6 py-2.5 border border-slate-300 text-slate-700 font-semibold rounded-lg text-sm hover:bg-slate-50">
            Xem website ↗
        </a>
    </div>
</form>

<script>
// Sync color picker → text input
document.querySelectorAll('input[type=color]').forEach(picker => {
    const name = picker.name;
    const textInput = document.getElementById(name + '_text');
    if (textInput) {
        picker.addEventListener('input', () => textInput.value = picker.value);
    }
});
</script>

<%- include('../../partials/footer') %>
