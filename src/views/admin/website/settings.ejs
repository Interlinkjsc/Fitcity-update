<%- include('../../partials/header', { title: 'Cài đặt Website', activePage: 'website-settings' }) %>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">Cài đặt Website</h2>
    <p class="text-slate-500 text-sm mt-1">Thay đổi logo, màu sắc, thông tin liên hệ và nội dung trang chủ</p>
</div>

<form method="POST" action="/admin/website/settings" class="space-y-8 max-w-3xl">

    <!-- LOGO -->
    <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h3 class="font-bold text-slate-800 mb-4">Logo</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Key logo sáng (header)</label>
                <input type="text" name="logo_key" value="<%= settings.logo_key || '' %>" placeholder="vd: brand/logo.webp"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
                <p class="text-xs text-slate-400 mt-1">Key file trong R2 storage</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Key logo tối (footer)</label>
                <input type="text" name="logo_dark_key" value="<%= settings.logo_dark_key || '' %>" placeholder="vd: brand/logo-dark.webp"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
        </div>
    </div>

    <!-- MÀU CHỦ ĐẠO -->
    <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h3 class="font-bold text-slate-800 mb-4">Màu chủ đạo</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Màu Forest (chủ đạo xanh)</label>
                <div class="flex items-center gap-3">
                    <input type="color" name="brand_forest" value="<%= settings.brand_forest || '#1a2e1a' %>"
                        class="w-12 h-10 rounded border border-slate-300 cursor-pointer">
                    <input type="text" id="brand_forest_text" value="<%= settings.brand_forest || '#1a2e1a' %>"
                        class="flex-1 border border-slate-300 rounded-lg text-sm py-2 px-3 font-mono focus:ring-2 focus:ring-lime-500 outline-none"
                        oninput="document.querySelector('[name=brand_forest]').value=this.value">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Màu Orange (nhấn cam/xanh lá)</label>
                <div class="flex items-center gap-3">
                    <input type="color" name="brand_orange" value="<%= settings.brand_orange || '#ccff00' %>"
                        class="w-12 h-10 rounded border border-slate-300 cursor-pointer">
                    <input type="text" id="brand_orange_text" value="<%= settings.brand_orange || '#ccff00' %>"
                        class="flex-1 border border-slate-300 rounded-lg text-sm py-2 px-3 font-mono focus:ring-2 focus:ring-lime-500 outline-none"
                        oninput="document.querySelector('[name=brand_orange]').value=this.value">
                </div>
            </div>
        </div>
    </div>

    <!-- THÔNG TIN LIÊN HỆ -->
    <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h3 class="font-bold text-slate-800 mb-4">Thông tin liên hệ</h3>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Hotline</label>
                <input type="text" name="hotline" value="<%= settings.hotline || '' %>" placeholder="vd: 090.4554.333"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                <input type="email" name="email" value="<%= settings.email || '' %>" placeholder="vd: fitcityofficial@gmail.com"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Facebook URL</label>
                <input type="url" name="facebook" value="<%= settings.facebook || '' %>" placeholder="vd: https://facebook.com/fitcity"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
        </div>
    </div>

    <!-- NỘI DUNG TRANG -->
    <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h3 class="font-bold text-slate-800 mb-4">Nội dung trang</h3>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Tiêu đề Hero trang chủ</label>
                <input type="text" name="home_hero_heading" value="<%= settings.home_hero_heading || '' %>"
                    placeholder="vd: ĐÃ KHAI TRƯƠNG..."
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Footer tagline (1 dòng)</label>
                <input type="text" name="footer_tagline" value="<%= settings.footer_tagline || '' %>"
                    placeholder="vd: Nơi trẻ khỏe mạnh, tự tin và yêu vận động"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
                <p class="text-xs text-slate-400 mt-1">Để trống để dùng mặc định 4 dòng</p>
            </div>
        </div>
    </div>

    <div class="flex gap-3">
        <button type="submit" class="px-6 py-2.5 bg-lime-500 hover:bg-lime-600 text-slate-900 font-bold rounded-lg text-sm">
            Lưu thay đổi
        </button>
        <a href="http://160.25.81.177/" target="_blank" class="px-6 py-2.5 border border-slate-300 text-slate-700 font-semibold rounded-lg text-sm hover:bg-slate-50">
            Xem website ↗
        </a>
    </div>
</form>

<!-- ẢNH WEBSITE THEO VỊ TRÍ (SLOT) — upload hiển thị ngay, không cần rebuild -->
<div class="bg-white rounded-xl border border-slate-200 p-6 max-w-3xl mt-8">
    <h3 class="font-bold text-slate-800 mb-1">Ảnh website</h3>
    <p class="text-xs text-slate-400 mb-4">Chọn vị trí, upload ảnh (JPG/PNG/WEBP ≤ 5MB) — website hiển thị ảnh mới ngay lập tức. Gỡ ảnh để quay về ảnh mặc định.</p>

    <form method="POST" action="/admin/website/settings/slot-images" enctype="multipart/form-data"
        class="flex flex-col sm:flex-row gap-3 sm:items-end border-b border-slate-100 pb-5 mb-5">
        <div class="flex-1">
            <label class="block text-sm font-medium text-slate-700 mb-1">Vị trí ảnh</label>
            <input type="text" name="slotId" list="known-slots" required placeholder="vd: home-featured"
                class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 outline-none">
            <datalist id="known-slots">
                <% (typeof knownSlots !== 'undefined' ? knownSlots : []).forEach(sl => { %>
                <option value="<%= sl.id %>"><%= sl.label %></option>
                <% }) %>
            </datalist>
        </div>
        <div class="flex-1">
            <label class="block text-sm font-medium text-slate-700 mb-1">File ảnh</label>
            <input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp" required
                class="w-full text-sm text-slate-600 file:mr-3 file:px-4 file:py-2 file:rounded-lg file:border-0 file:bg-lime-100 file:text-lime-800 file:font-semibold file:text-xs">
        </div>
        <button type="submit" class="px-5 py-2.5 bg-lime-500 hover:bg-lime-600 text-slate-900 font-bold rounded-lg text-sm shrink-0">
            Upload ảnh
        </button>
    </form>

    <% const rows = (typeof slotImages !== 'undefined' ? slotImages : []); %>
    <% if (rows.length === 0) { %>
    <p class="text-sm text-slate-400 italic">Chưa có ảnh nào được thay — website đang dùng toàn bộ ảnh mặc định.</p>
    <% } else { %>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="text-slate-400 border-b text-xs uppercase">
                    <th class="py-2 pr-3">Ảnh</th>
                    <th class="py-2 pr-3">Vị trí</th>
                    <th class="py-2 pr-3">File</th>
                    <th class="py-2 text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <% rows.forEach(r => { %>
                <tr class="border-b border-slate-50">
                    <td class="py-2 pr-3"><img src="/uploads/<%= r.mediaKey %>" class="w-16 h-10 object-cover rounded border border-slate-200" onerror="this.style.display='none'"></td>
                    <td class="py-2 pr-3 font-mono text-xs font-semibold text-slate-700"><%= r.slotId %></td>
                    <td class="py-2 pr-3 text-xs text-slate-400"><%= r.mediaKey %></td>
                    <td class="py-2 text-right">
                        <form method="POST" action="/admin/website/settings/slot-images/delete" class="inline" onsubmit="return confirm('Gỡ ảnh vị trí <%= r.slotId %>? Website sẽ dùng lại ảnh mặc định.')">
                            <input type="hidden" name="slotId" value="<%= r.slotId %>">
                            <button type="submit" class="text-xs px-3 py-1.5 text-red-600 border border-red-200 rounded-lg hover:bg-red-50 font-semibold">Gỡ ảnh</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } %>
</div>

<!-- ZALO ZNS — thông báo check-in/check-out cho khách -->
<div class="bg-white rounded-xl border border-slate-200 p-6 max-w-3xl mt-8">
    <h3 class="font-bold text-slate-800 mb-1">Zalo ZNS (thông báo check-in / check-out)</h3>
    <% const zs = (typeof zaloStatus !== 'undefined' && zaloStatus) ? zaloStatus : {}; %>
    <p class="text-xs text-slate-400 mb-1">
        Mẫu check-in: <span class="font-mono font-semibold"><%= zs.templateCheckin || 'chưa cấu hình' %></span>
        · Mẫu check-out: <span class="font-mono font-semibold"><%= zs.templateCheckout || 'chưa cấu hình' %></span>
    </p>
    <p class="text-xs mb-4">
        <% if (zs.hasToken) { %><span class="text-emerald-600 font-semibold">● Đã có token</span><% } else { %><span class="text-red-500 font-semibold">● Chưa có token</span><% } %>
        <% if (zs.expiresAt) { %><span class="text-slate-400"> · hạn dùng đến <%= new Date(zs.expiresAt).toLocaleString('vi-VN') %></span><% } %>
        <% if (zs.hasAppCreds && zs.hasRefresh) { %><span class="text-emerald-600"> · tự động gia hạn: BẬT</span><% } else { %><span class="text-amber-500"> · tự động gia hạn: TẮT (cần App ID + Secret + refresh token)</span><% } %>
    </p>

    <form method="POST" action="/admin/website/settings/zalo" class="space-y-3">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Access token (CỦA OA — không phải token đăng nhập cá nhân)</label>
            <textarea name="zaloAccessToken" rows="2" placeholder="Dán access token OA mới vào đây..."
                class="w-full border border-slate-300 rounded-lg text-xs py-2 px-3 font-mono focus:ring-2 focus:ring-lime-500 outline-none"></textarea>
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Refresh token (khuyến nghị — để hệ thống tự gia hạn)</label>
            <textarea name="zaloRefreshToken" rows="2" placeholder="Dán refresh token (hiện cùng chỗ với access token)..."
                class="w-full border border-slate-300 rounded-lg text-xs py-2 px-3 font-mono focus:ring-2 focus:ring-lime-500 outline-none"></textarea>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">App ID</label>
                <input type="text" name="zaloAppId" placeholder="Dãy số App ID"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 font-mono focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Secret key</label>
                <input type="password" name="zaloAppSecret" placeholder="App secret key" autocomplete="new-password"
                    class="w-full border border-slate-300 rounded-lg text-sm py-2 px-3 font-mono focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
        </div>
        <p class="text-[11px] text-slate-400">Chỉ cần điền ô muốn cập nhật — ô bỏ trống sẽ giữ giá trị cũ. Lấy token tại <span class="font-mono">developers.zalo.me/tools/explorer</span> (chọn loại <b>Official Account</b>).</p>
        <div class="flex gap-3">
            <button type="submit" class="px-5 py-2.5 bg-lime-500 hover:bg-lime-600 text-slate-900 font-bold rounded-lg text-sm">Lưu cấu hình Zalo</button>
            <button type="button" id="zalo-test-btn" class="px-5 py-2.5 border border-slate-300 text-slate-700 font-semibold rounded-lg text-sm hover:bg-slate-50">Kiểm tra kết nối</button>
        </div>
    </form>
    <div id="zalo-test-result" class="mt-4 hidden text-sm rounded-lg p-4 whitespace-pre-wrap font-mono text-xs"></div>
</div>

<script>
// Sync color picker → text input
document.querySelectorAll('input[type=color]').forEach(picker => {
    const name = picker.name;
    const textInput = document.getElementById(name + '_text');
    if (textInput) {
        picker.addEventListener('input', () => textInput.value = picker.value);
    }
});

// Zalo ZNS: kiểm tra kết nối
document.getElementById('zalo-test-btn')?.addEventListener('click', async function () {
    const box = document.getElementById('zalo-test-result');
    box.classList.remove('hidden');
    box.className = 'mt-4 text-xs rounded-lg p-4 whitespace-pre-wrap font-mono bg-slate-50 border border-slate-200 text-slate-600';
    box.textContent = 'Đang kiểm tra với Zalo...';
    try {
        const res = await fetch('/admin/website/settings/zalo/test', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await res.json();
        if (data.ok) {
            let msg = '✅ TOKEN HỢP LỆ — ZNS sẵn sàng gửi.\n';
            if (data.quota) msg += 'Quota: ' + JSON.stringify(data.quota) + '\n';
            for (const [k, t] of Object.entries(data.templates || {})) {
                msg += '\nMẫu ' + k + ' (' + (t.id || '?') + '): ' + (t.error ? ('⚠️ ' + t.error) : (t.name + ' — trạng thái ' + t.status + '\n  Tham số: ' + (t.params || []).join(', ')));
            }
            box.className = 'mt-4 text-xs rounded-lg p-4 whitespace-pre-wrap font-mono bg-emerald-50 border border-emerald-200 text-emerald-800';
            box.textContent = msg;
        } else {
            box.className = 'mt-4 text-xs rounded-lg p-4 whitespace-pre-wrap font-mono bg-red-50 border border-red-200 text-red-700';
            box.textContent = '❌ ' + (data.reason || 'Không kiểm tra được.');
        }
    } catch (e) {
        box.className = 'mt-4 text-xs rounded-lg p-4 whitespace-pre-wrap font-mono bg-red-50 border border-red-200 text-red-700';
        box.textContent = '❌ Lỗi gọi kiểm tra: ' + e.message;
    }
});
</script>

<%- include('../../partials/footer') %>
