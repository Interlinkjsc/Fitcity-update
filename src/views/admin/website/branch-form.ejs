<%- include('../../partials/header', { title: title, activePage: 'website' }) %>

<div class="mb-6">
    <nav class="text-sm text-slate-500 mb-2"><a href="/admin/website" class="hover:text-slate-800">Website</a> / <a href="/admin/website/branches" class="hover:text-slate-800">Chi nhánh</a> / <%= branch ? 'Sửa' : 'Thêm mới' %></nav>
    <h2 class="text-2xl font-bold text-slate-800"><%= title %></h2>
</div>

<form action="/admin/website/branches/<%= branch ? 'update/' + branch._id : 'store' %>" method="POST" class="max-w-2xl space-y-5">
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Tên chi nhánh <span class="text-red-500">*</span></label>
                <input type="text" name="name" value="<%= branch ? branch.name : '' %>" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Điện thoại</label>
                <input type="text" name="phone" value="<%= branch ? branch.phone : '' %>" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Địa chỉ</label>
            <input type="text" name="address" value="<%= branch ? branch.address : '' %>" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Quận/Huyện</label>
                <input type="text" name="district" value="<%= branch ? branch.district : '' %>" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Thành phố</label>
                <input type="text" name="city" value="<%= branch ? branch.city : '' %>" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Giờ mở cửa</label>
                <input type="text" name="hours" value="<%= branch ? branch.hours : '' %>" placeholder="VD: 06:00 – 22:00" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Số HLV</label>
                <input type="text" name="coach" value="<%= branch ? branch.coach : '' %>" placeholder="VD: 12 HLV" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
            </div>
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Chỉ số nổi bật</label>
            <input type="text" name="metric" value="<%= branch ? branch.metric : '' %>" placeholder="VD: 500m² · 200 hội viên" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">URL ảnh đại diện</label>
            <input type="text" name="imageUrl" value="<%= branch ? branch.imageUrl : '' %>" placeholder="https://..." class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Thứ tự sắp xếp</label>
                <input type="number" name="sort" value="<%= branch ? branch.sort : 0 %>" min="0" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
            </div>
        </div>
        <div class="flex items-center gap-6 pt-2">
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="isMain" <%= branch && branch.isMain ? 'checked' : '' %> class="w-4 h-4 rounded border-slate-300">
                <span class="text-sm font-semibold text-slate-700">Chi nhánh chính</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="published" <%= !branch || branch.published ? 'checked' : '' %> class="w-4 h-4 rounded border-slate-300">
                <span class="text-sm font-semibold text-slate-700">Hiển thị trên website</span>
            </label>
        </div>
    </div>

    <div class="flex gap-3">
        <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-lg shadow-sm transition-all">Lưu</button>
        <a href="/admin/website/branches" class="px-6 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm rounded-lg transition-all">Huỷ</a>
    </div>
</form>

<%- include('../../partials/footer') %>
