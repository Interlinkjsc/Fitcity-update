<%- include('../../partials/header', { title: 'CMS Website', activePage: 'cms' }) %>

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">CMS Website</h2>
        <p class="text-slate-500 text-sm mt-1">Banner, blog, SEO trang chủ</p>
    </div>
    <% if (typeof canManageCms === 'undefined' || canManageCms) { %>
    <a href="/admin/cms/create" class="px-4 py-2 bg-green-600 text-white text-sm font-bold rounded-lg hover:bg-green-700">+ Thêm nội dung</a>
    <% } else { %>
    <span title="Bạn không có quyền chỉnh sửa CMS" class="px-4 py-2 bg-slate-200 text-slate-400 text-sm font-bold rounded-lg cursor-not-allowed">+ Thêm nội dung</span>
    <% } %>
</div>

<form method="GET" class="mb-6 flex gap-3 bg-white p-4 rounded-xl border border-slate-200">
    <select name="type" class="border border-slate-300 rounded-lg text-sm py-2 px-3">
        <option value="all" <%= currentType === 'all' ? 'selected' : '' %>>Tất cả loại</option>
        <option value="banner" <%= currentType === 'banner' ? 'selected' : '' %>>Banner</option>
        <option value="post" <%= currentType === 'post' ? 'selected' : '' %>>Bài viết</option>
        <option value="seo" <%= currentType === 'seo' ? 'selected' : '' %>>SEO</option>
        <option value="section" <%= currentType === 'section' ? 'selected' : '' %>>Section</option>
    </select>
    <button type="submit" class="py-2 px-4 bg-slate-800 text-white text-sm font-bold rounded-lg">Lọc</button>
</form>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-500 uppercase text-[10px] tracking-widest">
            <tr>
                <th class="px-4 py-3 text-left">Tiêu đề</th>
                <th class="px-4 py-3 text-left">Loại</th>
                <th class="px-4 py-3 text-left">Key / Slug</th>
                <th class="px-4 py-3 text-center">Xuất bản</th>
                <th class="px-4 py-3 text-right">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            <% if (!items || items.length === 0) { %>
            <tr><td colspan="5" class="p-8 text-center text-slate-400">Chưa có nội dung CMS.</td></tr>
            <% } else { %>
            <% items.forEach(item => { %>
            <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 font-medium text-slate-800"><%= item.title %></td>
                <td class="px-4 py-3"><span class="px-2 py-0.5 rounded bg-slate-100 text-xs font-bold"><%= item.type %></span></td>
                <td class="px-4 py-3 text-slate-500 text-xs"><%= item.key || item.slug || '—' %></td>
                <td class="px-4 py-3 text-center">
                    <% if (item.published) { %><span class="text-emerald-600 font-bold text-xs">Đã publish</span><% } else { %><span class="text-slate-400 text-xs">Nháp</span><% } %>
                </td>
                <td class="px-4 py-3 text-right space-x-2">
                    <% if (item.type === 'post' && item.published && item.slug) { %>
                    <a href="/blog/<%= item.slug %>" target="_blank" class="text-blue-600 text-xs font-bold">Xem</a>
                    <% } %>
                    <% if (typeof canManageCms === 'undefined' || canManageCms) { %>
                    <a href="/admin/cms/edit/<%= item._id %>" class="text-lime-600 text-xs font-bold">Sửa</a>
                    <form action="/admin/cms/delete/<%= item._id %>" method="POST" class="inline" onsubmit="return confirm('Xóa nội dung này?')">
                        <button type="submit" class="text-red-600 text-xs font-bold">Xóa</button>
                    </form>
                    <% } else { %>
                    <span title="Bạn không có quyền chỉnh sửa CMS" class="text-slate-300 text-xs font-bold cursor-not-allowed">Sửa</span>
                    <span title="Bạn không có quyền chỉnh sửa CMS" class="text-slate-300 text-xs font-bold cursor-not-allowed">Xóa</span>
                    <% } %>
                </td>
            </tr>
            <% }) %>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('../../partials/footer') %>
