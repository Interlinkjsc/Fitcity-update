<%- include('../../partials/header', { title: 'Chấm công nhân viên', activePage: 'timesheets' }) %>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">Chấm công ca dạy</h2>
    <p class="text-slate-500 text-sm mt-1">Duyệt ca PT / Sales / Manager — SRS Sprint 2</p>
</div>

<form method="GET" class="mb-6 grid grid-cols-1 sm:grid-cols-5 gap-3 bg-white p-4 rounded-xl border border-slate-200">
    <select name="month" class="border border-slate-300 rounded-lg text-sm py-2 px-3">
        <% for (let m = 1; m <= 12; m++) { %>
        <option value="<%= m %>" <%= month === m ? 'selected' : '' %>>Tháng <%= m %></option>
        <% } %>
    </select>
    <select name="year" class="border border-slate-300 rounded-lg text-sm py-2 px-3">
        <% for (let y = 2024; y <= 2027; y++) { %>
        <option value="<%= y %>" <%= year === y ? 'selected' : '' %>><%= y %></option>
        <% } %>
    </select>
    <select name="status" class="border border-slate-300 rounded-lg text-sm py-2 px-3">
        <option value="all">Mọi trạng thái</option>
        <option value="Open" <%= currentFilter.status === 'Open' ? 'selected' : '' %>>Đang mở</option>
        <option value="Pending_Approval" <%= currentFilter.status === 'Pending_Approval' ? 'selected' : '' %>>Chờ duyệt</option>
        <option value="Approved" <%= currentFilter.status === 'Approved' ? 'selected' : '' %>>Đã duyệt</option>
        <option value="Rejected" <%= currentFilter.status === 'Rejected' ? 'selected' : '' %>>Từ chối</option>
    </select>
    <% if (typeof currentFilter.branchId !== 'undefined' && branches) { %>
    <select name="branchId" class="border border-slate-300 rounded-lg text-sm py-2 px-3" <%= typeof isManager !== 'undefined' && isManager ? 'disabled' : '' %>>
        <option value="all">Tất cả chi nhánh</option>
        <% branches.forEach(b => { %>
        <option value="<%= b._id %>" <%= currentFilter.branchId === b._id.toString() ? 'selected' : '' %>><%= b.name %></option>
        <% }) %>
    </select>
    <% } %>
    <button type="submit" class="py-2 bg-slate-800 text-white text-sm font-bold rounded-lg">Lọc</button>
</form>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-500 uppercase text-[10px] tracking-widest">
            <tr>
                <th class="px-4 py-3 text-left">Nhân viên</th>
                <th class="px-4 py-3 text-left">Chi nhánh</th>
                <th class="px-4 py-3 text-left">Check-in</th>
                <th class="px-4 py-3 text-left">Check-out</th>
                <th class="px-4 py-3 text-left">Trạng thái</th>
                <th class="px-4 py-3 text-right">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            <% if (!entries.length) { %>
            <tr><td colspan="6" class="px-4 py-12 text-center text-slate-400">Không có bản ghi chấm công.</td></tr>
            <% } %>
            <% entries.forEach(entry => { %>
            <tr class="hover:bg-slate-50">
                <td class="px-4 py-3">
                    <p class="font-bold text-slate-800"><%= entry.staff ? entry.staff.name : '—' %></p>
                    <p class="text-[10px] text-slate-400 uppercase"><%= entry.staff ? entry.staff.role : '' %></p>
                </td>
                <td class="px-4 py-3"><%= entry.branch ? entry.branch.name : '—' %></td>
                <td class="px-4 py-3 text-xs"><%= new Date(entry.checkIn).toLocaleString('vi-VN') %></td>
                <td class="px-4 py-3 text-xs"><%= entry.checkOut ? new Date(entry.checkOut).toLocaleString('vi-VN') : '—' %></td>
                <td class="px-4 py-3">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= entry.status === 'Approved' ? 'bg-emerald-100 text-emerald-700' : entry.status === 'Pending_Approval' ? 'bg-amber-100 text-amber-700' : entry.status === 'Rejected' ? 'bg-rose-100 text-rose-700' : 'bg-blue-100 text-blue-700' %>">
                        <%= entry.status.replace('_', ' ') %>
                    </span>
                </td>
                <td class="px-4 py-3 text-right space-x-2">
                    <% if (entry.status === 'Pending_Approval' && entry.checkOut) { %>
                    <form action="/admin/timesheets/approve/<%= entry._id %>" method="POST" class="inline">
                        <input type="hidden" name="month" value="<%= month %>">
                        <button type="submit" class="text-emerald-600 hover:underline text-xs font-bold">Duyệt</button>
                    </form>
                    <form action="/admin/timesheets/reject/<%= entry._id %>" method="POST" class="inline" onsubmit="return confirm('Từ chối ca này?')">
                        <button type="submit" class="text-rose-600 hover:underline text-xs font-bold">Từ chối</button>
                    </form>
                    <% } else { %>
                    <span class="text-slate-300 text-xs">—</span>
                    <% } %>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<%- include('../../partials/footer') %>
