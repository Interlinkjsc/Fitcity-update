<%- include('../../partials/header', { title: 'Gán phần thưởng', activePage: 'rewards' }) %>

<div class="mb-6 flex items-center gap-3">
    <a href="/admin/rewards" class="p-2 rounded-lg border border-slate-200 hover:bg-slate-50 transition-colors">
        <span class="material-symbols-outlined text-slate-500 text-[18px]">arrow_back</span>
    </a>
    <div>
        <h2 class="text-xl font-bold text-slate-800">Gán Reward cho Khách hàng</h2>
        <p class="text-slate-500 text-xs mt-0.5">Điền thông tin và nhấn LƯU để gán phần thưởng.</p>
    </div>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 max-w-2xl">
    <form action="/admin/rewards/store" method="POST" class="space-y-5">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Khách hàng <span class="text-red-500">*</span></label>
                <select name="clientId" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-lime-500 outline-none">
                    <option value="">-- Chọn khách hàng --</option>
                    <% clients.forEach(c => { %>
                        <option value="<%= c._id %>"><%= c.name %> (<%= c.email %>)</option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Loại Reward <span class="text-red-500">*</span></label>
                <select name="type" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-lime-500 outline-none">
                    <option value="Voucher">Voucher</option>
                    <option value="FreeSession">Buổi tập miễn phí</option>
                    <option value="Discount">Giảm giá</option>
                    <option value="Gift">Quà tặng</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Tiêu đề <span class="text-red-500">*</span></label>
                <input type="text" name="title" required placeholder="VD: Giảm 20% gói Gym"
                    class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-lime-500 outline-none">
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Giá trị (VNĐ)</label>
                <input type="number" name="value" min="0" value="0"
                    class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-lime-500 outline-none">
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Hết hạn <span class="text-red-500">*</span></label>
                <input type="date" name="expiresAt" required
                    class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-lime-500 outline-none">
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Mô tả</label>
                <input type="text" name="description" placeholder="Chi tiết reward"
                    class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-lime-500 outline-none">
            </div>
        </div>

        <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Ghi chú nội bộ</label>
            <textarea name="notes" rows="2" placeholder="Ghi chú cho Admin"
                class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-lime-500 outline-none resize-none"></textarea>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit"
                class="px-6 py-2.5 bg-lime-500 hover:bg-lime-600 text-slate-900 font-bold rounded-lg text-sm transition-colors shadow-sm flex items-center gap-2">
                <span class="material-symbols-outlined text-[16px]">save</span>
                LƯU
            </button>
            <a href="/admin/rewards"
                class="px-6 py-2.5 border border-slate-300 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-colors">
                Hủy
            </a>
        </div>

    </form>
</div>

<%- include('../../partials/footer') %>
