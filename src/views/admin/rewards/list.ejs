<%- include('../../partials/header', { title: 'Phần thưởng', activePage: 'rewards' }) %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-gift"></i> Quản lý Voucher & Reward</h1>
        <a href="/admin/rewards/create" class="btn btn-success"><i class="fas fa-plus"></i> Gán Reward</a>
    </div>

    <!-- Filters -->
    <form method="GET" class="row g-3 mb-4">
        <div class="col-md-3">
            <select name="type" class="form-select">
                <option value="">-- Loại --</option>
                <option value="Voucher" <%= filters.type === 'Voucher' ? 'selected' : '' %>>Voucher</option>
                <option value="FreeSession" <%= filters.type === 'FreeSession' ? 'selected' : '' %>>Buổi tập miễn phí</option>
                <option value="Discount" <%= filters.type === 'Discount' ? 'selected' : '' %>>Giảm giá</option>
                <option value="Gift" <%= filters.type === 'Gift' ? 'selected' : '' %>>Quà tặng</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">-- Trạng thái --</option>
                <option value="Active" <%= filters.status === 'Active' ? 'selected' : '' %>>Active</option>
                <option value="Used" <%= filters.status === 'Used' ? 'selected' : '' %>>Đã dùng</option>
                <option value="Expired" <%= filters.status === 'Expired' ? 'selected' : '' %>>Hết hạn</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Lọc</button>
        </div>
    </form>

    <!-- Rewards Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Khách hàng</th>
                    <th>Loại</th>
                    <th>Tiêu đề</th>
                    <th>Giá trị</th>
                    <th>Trạng thái</th>
                    <th>Hết hạn</th>
                    <th>Người gán</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <% if (rewards && rewards.length > 0) { %>
                    <% rewards.forEach((r, i) => { %>
                    <tr>
                        <td><%= i + 1 %></td>
                        <td><%= r.client ? r.client.name : 'N/A' %></td>
                        <td>
                            <% if (r.type === 'Voucher') { %>
                                <span class="badge bg-primary">Voucher</span>
                            <% } else if (r.type === 'FreeSession') { %>
                                <span class="badge bg-success">Free Session</span>
                            <% } else if (r.type === 'Discount') { %>
                                <span class="badge bg-warning text-dark">Discount</span>
                            <% } else { %>
                                <span class="badge bg-info">Gift</span>
                            <% } %>
                        </td>
                        <td><%= r.title %></td>
                        <td><%= r.value ? r.value.toLocaleString('vi-VN') + 'đ' : '-' %></td>
                        <td>
                            <% if (r.status === 'Active') { %>
                                <span class="badge bg-success">Active</span>
                            <% } else if (r.status === 'Used') { %>
                                <span class="badge bg-secondary">Đã dùng</span>
                            <% } else { %>
                                <span class="badge bg-danger">Hết hạn</span>
                            <% } %>
                        </td>
                        <td><%= new Date(r.expiresAt).toLocaleDateString('vi-VN') %></td>
                        <td><%= r.assignedBy ? r.assignedBy.name : 'System' %></td>
                        <td>
                            <a href="/admin/rewards/detail/<%= r._id %>" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a>
                            <form action="/admin/rewards/delete/<%= r._id %>" method="POST" class="d-inline" onsubmit="return confirm('Xóa reward này?')">
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="9" class="text-center text-muted">Chưa có reward nào</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../../partials/footer') %>
