<%- include('../../partials/header', { title: 'Chi tiết phần thưởng', activePage: 'rewards' }) %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="fas fa-gift"></i> Chi tiết Reward</h1>
        <a href="/admin/rewards" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Khách hàng:</strong> <%= reward.client ? reward.client.name : 'N/A' %></p>
                    <p><strong>Email:</strong> <%= reward.client ? reward.client.email : '-' %></p>
                    <p><strong>SĐT:</strong> <%= reward.client && reward.client.phone ? reward.client.phone : '-' %></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Loại:</strong>
                        <% if (reward.type === 'Voucher') { %>
                            <span class="badge bg-primary">Voucher</span>
                        <% } else if (reward.type === 'FreeSession') { %>
                            <span class="badge bg-success">Free Session</span>
                        <% } else if (reward.type === 'Discount') { %>
                            <span class="badge bg-warning text-dark">Discount</span>
                        <% } else { %>
                            <span class="badge bg-info">Gift</span>
                        <% } %>
                    </p>
                    <p><strong>Trạng thái:</strong>
                        <% if (reward.status === 'Active') { %>
                            <span class="badge bg-success">Active</span>
                        <% } else if (reward.status === 'Used') { %>
                            <span class="badge bg-secondary">Đã dùng</span>
                        <% } else { %>
                            <span class="badge bg-danger">Hết hạn</span>
                        <% } %>
                    </p>
                    <p><strong>Người gán:</strong> <%= reward.assignedBy ? reward.assignedBy.name : 'System' %></p>
                </div>
            </div>
            <hr>
            <div class="row">
                <div class="col-md-4">
                    <p><strong>Tiêu đề:</strong> <%= reward.title %></p>
                </div>
                <div class="col-md-4">
                    <p><strong>Giá trị:</strong> <%= reward.value ? reward.value.toLocaleString('vi-VN') + 'đ' : '-' %></p>
                </div>
                <div class="col-md-4">
                    <p><strong>Hết hạn:</strong> <%= new Date(reward.expiresAt).toLocaleDateString('vi-VN') %></p>
                </div>
            </div>
            <% if (reward.description) { %>
                <p><strong>Mô tả:</strong> <%= reward.description %></p>
            <% } %>
            <% if (reward.notes) { %>
                <p><strong>Ghi chú:</strong> <%= reward.notes %></p>
            <% } %>
            <% if (reward.coupon) { %>
                <p><strong>Coupon liên kết:</strong> <code><%= reward.coupon.code %></code> (<%= reward.coupon.type %> - <%= reward.coupon.value %>)</p>
            <% } %>
            <% if (reward.usedAt) { %>
                <p><strong>Ngày sử dụng:</strong> <%= new Date(reward.usedAt).toLocaleString('vi-VN') %></p>
            <% } %>
            <p class="text-muted mt-2"><small>Tạo lúc: <%= new Date(reward.createdAt).toLocaleString('vi-VN') %></small></p>
        </div>
    </div>
</div>

<%- include('../../partials/footer') %>
