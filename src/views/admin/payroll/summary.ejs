<!-- Payment Modal -->
<div id="paymentModal" class="fixed inset-0 z-50 hidden flex justify-center items-center bg-slate-900/50 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6 transform transition-all">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-slate-800">Thanh toán lương</h3>
            <button type="button" onclick="closePaymentModal()" class="text-slate-400 hover:text-slate-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        
        <div class="mb-4 text-sm text-slate-600">Nhân sự: <span id="paymentStaffName" class="font-bold text-slate-800"></span></div>
        <div class="mb-6 text-sm text-slate-600 border-b border-slate-100 pb-4 flex justify-between items-center">
            <span>Lương Dự kiến (Gốc + HH):</span>
            <span id="paymentExpectedTotal" class="font-bold text-emerald-600 text-lg"></span>
        </div>
        
        <form id="paymentForm" action="" method="POST">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Thưởng thêm (Bonus) (VNĐ)</label>
                    <input type="number" name="bonus" value="0" min="0" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-lime-500 font-mono text-blue-600">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Thuế TNCN (VNĐ)</label>
                    <input type="number" name="tax" value="0" min="0" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-lime-500 font-mono text-red-600">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Bảo hiểm XH (VNĐ)</label>
                    <input type="number" name="insurance" value="0" min="0" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-lime-500 font-mono text-red-600">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Khấu trừ khác / Phạt kỷ luật (VNĐ)</label>
                    <input type="number" id="paymentOtherDeductions" name="deductions" value="0" min="0" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-lime-500 font-mono text-red-600">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Ghi chú thanh toán</label>
                    <textarea name="note" rows="2" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-lime-500" placeholder="VD: CK VCB ngày 5/4..."></textarea>
                </div>
            </div>
            
            <div class="mt-8 flex justify-end gap-3">
                <button type="button" onclick="closePaymentModal()" class="px-5 py-2 rounded-lg font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200">Huỷ bỏ</button>
                <button type="submit" class="px-5 py-2 rounded-lg font-semibold text-white bg-emerald-600 hover:bg-emerald-700 shadow-lg shadow-emerald-200">Xác nhận Đã Trả</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openPaymentModal(payrollId, staffName, expectedTotal, bonus, deductions, tax, insurance) {
        document.getElementById('paymentStaffName').innerText = staffName;
        document.getElementById('paymentExpectedTotal').innerText = new Intl.NumberFormat('vi-VN').format(Math.round(expectedTotal));
        document.getElementById('paymentForm').action = '/admin/payroll/mark-paid/' + payrollId;
        
        // Set initial values
        document.querySelector('input[name="bonus"]').value = bonus || 0;
        document.querySelector('input[name="tax"]').value = tax || 0;
        document.querySelector('input[name="insurance"]').value = insurance || 0;
        document.getElementById('paymentOtherDeductions').value = deductions || 0;

        document.getElementById('paymentModal').classList.remove('hidden');
    }
    
    function closePaymentModal() {
        document.getElementById('paymentModal').classList.add('hidden');
    }
</script>

