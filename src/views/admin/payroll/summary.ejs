<%- include('../../partials/header', { title: 'Bảng lương & Hoa hồng PT/Sales', activePage: 'payroll' }) %>

<!-- Page Header -->
<div class="mb-6">
    <h2 class="text-2xl font-extrabold text-slate-800 tracking-tight">Thanh toán Lương & Thưởng</h2>
    <p class="text-slate-500 mt-1 text-sm flex items-center gap-2">
        <span class="material-symbols-outlined text-base text-slate-400">calendar_month</span>
        Kỳ quyết toán: Tháng <%= month %> / <%= year %> — <span class="text-indigo-600 font-bold">2 kỳ (ngày 5 & 15)</span>
        <% if (typeof ptPayrollMode !== 'undefined' && ptPayrollMode) { %>
        — PT: <span class="font-bold text-amber-600"><%= ptPayrollMode === 'contract' ? 'Hợp đồng' : ptPayrollMode === 'timesheet' ? 'Chấm công' : 'Hybrid' %></span>
        <% if (ptPayrollMode !== 'contract') { %>(<%= new Intl.NumberFormat('vi-VN').format(timesheetRatePerShift || 120000) %>/ca)<% } %>
        <% } %>
    </p>
</div>

<!-- Bộ lọc -->
<div class="mb-6 bg-white rounded-xl border border-slate-200 shadow-sm p-5">
    <form method="GET" action="/admin/payroll" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-4 items-end">
        <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5 uppercase">Tên nhân sự</label>
            <input type="text" name="staffName" value="<%= typeof staffName !== 'undefined' ? staffName : '' %>" placeholder="Tìm theo tên..." class="w-full border border-slate-200 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 bg-slate-50">
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5 uppercase">Vai trò</label>
            <select name="role" class="w-full border border-slate-200 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 bg-slate-50 font-medium">
                <option value="All" <%= typeof role !== 'undefined' && role === 'All' ? 'selected' : '' %>>Tất cả</option>
                <option value="PT" <%= typeof role !== 'undefined' && role === 'PT' ? 'selected' : '' %>>HLV (PT)</option>
                <option value="Sales" <%= typeof role !== 'undefined' && role === 'Sales' ? 'selected' : '' %>>Sales</option>
                <option value="Marketing" <%= typeof role !== 'undefined' && role === 'Marketing' ? 'selected' : '' %>>Marketing</option>
                <option value="Manager" <%= typeof role !== 'undefined' && role === 'Manager' ? 'selected' : '' %>>Quản lý</option>
                <option value="Accountant" <%= typeof role !== 'undefined' && role === 'Accountant' ? 'selected' : '' %>>Kế toán</option>
                <option value="CEO" <%= typeof role !== 'undefined' && role === 'CEO' ? 'selected' : '' %>>CEO</option>
                <option value="Admin" <%= typeof role !== 'undefined' && role === 'Admin' ? 'selected' : '' %>>Admin</option>
            </select>
        </div>
        <% if (typeof isManager === 'undefined' || !isManager) { %>
        <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5 uppercase">Chi nhánh</label>
            <select name="branchId" class="w-full border border-slate-200 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500">
                <option value="all">Tất cả</option>
                <% if (typeof branches !== 'undefined') { branches.forEach(b => { %>
                <option value="<%= b._id %>" <%= (typeof branchId !== 'undefined' && branchId == b._id.toString()) ? 'selected' : '' %>><%= b.name %></option>
                <% }) } %>
            </select>
        </div>
        <% } %>
        <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5 uppercase">Trạng thái TT</label>
            <select name="payStatus" class="w-full border border-slate-200 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500">
                <option value="all" <%= (typeof payStatus !== 'undefined' && payStatus === 'all') ? 'selected' : '' %>>Tất cả</option>
                <option value="paid" <%= payStatus === 'paid' ? 'selected' : '' %>>Đã trả đủ 2 kỳ</option>
                <option value="pending" <%= payStatus === 'pending' ? 'selected' : '' %>>Còn kỳ chưa trả</option>
            </select>
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5 uppercase">Tháng</label>
            <select name="month" class="w-full border border-slate-200 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 bg-slate-50 font-medium">
                <% for(let m=1; m<=12; m++) { %><option value="<%= m %>" <%= m == month ? 'selected' : '' %>>Tháng <%= m %></option><% } %>
            </select>
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5 uppercase">Năm</label>
            <select name="year" class="w-full border border-slate-200 rounded-lg text-sm py-2 px-3 focus:ring-2 focus:ring-lime-500 bg-slate-50 font-medium">
                <% for(let y=2024; y<=2027; y++) { %><option value="<%= y %>" <%= y == year ? 'selected' : '' %>><%= y %></option><% } %>
            </select>
        </div>
        <div class="flex gap-2 sm:col-span-2">
            <button type="submit" class="flex-1 px-4 py-2 bg-slate-800 text-white font-bold rounded-lg hover:bg-slate-900 text-sm">Áp dụng</button>
            <a href="/admin/payroll" class="px-4 py-2 border border-slate-300 text-slate-600 font-semibold rounded-lg hover:bg-slate-50 text-sm text-center">Xóa lọc</a>
        </div>
    </form>
</div>

<div class="flex flex-wrap items-center justify-end gap-2 mb-6">
    <div class="flex items-center gap-2">
        <a href="/admin/payroll/export-csv?month=<%= month %>&year=<%= year %>&role=<%= typeof role !== 'undefined' ? role : 'All' %>&branchId=<%= typeof branchId !== 'undefined' ? branchId : 'all' %>&payStatus=<%= typeof payStatus !== 'undefined' ? payStatus : 'all' %>" class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-50 transition-all inline-flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm">download</span> CSV
        </a>
        <% if (typeof canManagePayroll === 'undefined' || canManagePayroll) { %>
        <form method="POST" action="/admin/payroll/auto-suggest" class="inline-block" onsubmit="return confirm('Hệ thống sẽ tạo 2 kỳ lương (ngày 5 & 15) cho tất cả nhân viên đang hoạt động. Tiếp tục?');">
            <input type="hidden" name="month" value="<%= month %>">
            <input type="hidden" name="year" value="<%= year %>">
            <button type="submit" class="px-3 py-2 bg-indigo-600 text-white rounded-lg text-xs font-bold hover:bg-indigo-700 transition-all inline-flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm">bolt</span> Đề xuất 2 Kỳ
            </button>
        </form>
        <% } else { %>
        <span title="Bạn không có quyền phê duyệt / thanh toán lương" class="px-3 py-2 bg-slate-200 text-slate-400 rounded-lg text-xs font-bold inline-flex items-center gap-1.5 cursor-not-allowed">
            <span class="material-symbols-outlined text-sm">bolt</span> Đề xuất 2 Kỳ
        </span>
        <% } %>
        <button onclick="window.print()" class="px-3 py-2 bg-slate-900 text-white rounded-lg text-xs font-bold hover:bg-slate-800 transition-all inline-flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm">print</span> In
        </button>
    </div>
</div>
<!-- Print Styles -->
<style>
    @media print {
        aside, nav, .sidebar, [class*="complementary"],
        button, a[href*="export-csv"], form[action*="auto-suggest"],
        .flex.gap-3 { display: none !important; }
        main { margin: 0 !important; padding: 0 !important; width: 100% !important; }
        body { background: white !important; }
        .shadow-xl, .shadow-lg, .shadow-sm { box-shadow: none !important; }
    }
</style>

<!-- KPI Cards — toàn bộ nhân sự theo bộ lọc (không chỉ trang hiện tại) -->
<%
    const stats = typeof summaryStats !== 'undefined' ? summaryStats : { totalBaseSalary: 0, totalCommission: 0, totalPaid: 0, totalUnpaid: 0, staffCount: 0 };
%>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5 mb-8">
    <div class="bg-slate-700 p-5 rounded-2xl text-white shadow-lg">
        <p class="text-slate-300 text-[10px] font-bold uppercase tracking-widest mb-1">Nhân sự (lọc)</p>
        <h3 class="text-2xl font-black"><%= stats.staffCount %></h3>
    </div>
    <div class="bg-indigo-600 p-5 rounded-2xl text-white shadow-xl shadow-indigo-100 relative overflow-hidden group">
        <div class="relative z-10">
            <p class="text-indigo-100 text-[10px] font-bold uppercase tracking-widest opacity-80 mb-1">Tổng Lương Cứng</p>
            <h3 class="text-xl font-black"><%= new Intl.NumberFormat('vi-VN').format(Math.round(stats.totalBaseSalary)) %> <small class="text-xs font-normal">VNĐ</small></h3>
        </div>
        <div class="absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform">
            <svg class="h-20 w-20" fill="currentColor" viewBox="0 0 24 24"><path d="M21 18v1c0 1.1-.9 2-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14c1.1 0 2 .9 2 2v1h-9a2 2 0 00-2 2v8a2 2 0 002 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"></path></svg>
        </div>
    </div>
    
    <div class="bg-amber-500 p-5 rounded-2xl text-white shadow-xl shadow-amber-100 relative overflow-hidden group">
        <div class="relative z-10">
            <p class="text-amber-100 text-[10px] font-bold uppercase tracking-widest opacity-80 mb-1">Tổng Hoa Hồng</p>
            <h3 class="text-xl font-black"><%= new Intl.NumberFormat('vi-VN').format(Math.round(stats.totalCommission)) %> <small class="text-xs font-normal">VNĐ</small></h3>
        </div>
        <div class="absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform">
            <svg class="h-20 w-20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path></svg>
        </div>
    </div>

    <div class="bg-emerald-500 p-5 rounded-2xl text-white shadow-xl shadow-emerald-100 relative overflow-hidden group">
        <div class="relative z-10">
            <p class="text-emerald-100 text-[10px] font-bold uppercase tracking-widest opacity-80 mb-1">Đã Thanh Toán</p>
            <h3 class="text-xl font-black"><%= new Intl.NumberFormat('vi-VN').format(Math.round(stats.totalPaid)) %> <small class="text-xs font-normal">VNĐ</small></h3>
        </div>
        <div class="absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform">
            <svg class="h-20 w-20" fill="currentColor" viewBox="0 0 24 24"><path d="M12.89 11.1c-1.78-.59-2.64-.96-2.64-1.9 0-1.02 1.11-1.39 1.81-1.39 1.31 0 1.79.99 1.9 1.34l1.58-.67c-.15-.45-.82-1.92-2.54-2.16V5h-2v1.3c-2.04.45-3.05 1.87-3.05 3.22 0 1.87 1.52 2.82 3.51 3.48 1.64.54 2.29 1.14 2.29 2.02 0 1.18-1.12 1.78-2.15 1.78-1.81 0-2.35-1.45-2.48-1.85l-1.64.67C7.86 16.68 8.92 17.76 10 18.05V20h2v-1.35c1.49-.3 3.05-1.26 3.05-3.53 0-1.79-1.21-2.82-2.16-3.02z"></path></svg>
        </div>
    </div>

    <div class="bg-rose-500 p-5 rounded-2xl text-white shadow-xl shadow-rose-100 relative overflow-hidden group">
        <div class="relative z-10">
            <p class="text-rose-100 text-[10px] font-bold uppercase tracking-widest opacity-80 mb-1">Chưa Thanh Toán</p>
            <h3 class="text-xl font-black"><%= new Intl.NumberFormat('vi-VN').format(Math.round(stats.totalUnpaid)) %> <small class="text-xs font-normal">VNĐ</small></h3>
        </div>
        <div class="absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform">
            <svg class="h-20 w-20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"></path></svg>
        </div>
    </div>
</div>

<!-- Main Table — 2 dòng/nhân viên -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-12">
    <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
        <h4 class="font-bold text-slate-800">Bảng Lương Chi Tiết — 2 Kỳ/Tháng</h4>
        <div class="flex gap-2">
            <span class="text-xs font-bold text-slate-400 bg-slate-200 px-3 py-1 rounded-full uppercase">Tháng <%= month %></span>
            <span class="text-xs font-bold text-indigo-500 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100">Kỳ 1: Ngày 5 · Kỳ 2: Ngày 15</span>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="bg-slate-50 text-slate-500 text-[11px] font-bold uppercase tracking-widest border-b border-slate-200">
                    <th class="px-5 py-3 min-w-[180px]">Nhân viên</th>
                    <th class="px-3 py-3 text-center w-[70px]">Kỳ</th>
                    <th class="px-3 py-3 text-center w-[100px]">Ngày TT</th>
                    <th class="px-3 py-3 text-right">Lương cứng</th>
                    <th class="px-3 py-3 text-right">Hoa hồng</th>
                    <th class="px-3 py-3 text-right">Khấu trừ</th>
                    <th class="px-3 py-3 text-right">Thực nhận</th>
                    <th class="px-3 py-3 text-center w-[120px]">Trạng thái</th>
                    <th class="px-3 py-3 text-center w-[100px]">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if(payrollData && payrollData.length > 0) { %>
                    <% payrollData.forEach((p, idx) => { %>
                        <%
                            let roleVN = p.staff.role;
                            if(p.staff.role === 'PT') roleVN = 'HLV';
                            if(p.staff.role === 'Sales') roleVN = 'KD';
                            if(p.staff.role === 'Manager') roleVN = 'QL';

                            const periods = [
                                { num: 1, record: p.period1, payDay: 5 },
                                { num: 2, record: p.period2, payDay: 15 }
                            ];
                        %>
                        <% periods.forEach((pr, pIdx) => { %>
                            <tr class="hover:bg-slate-50/80 transition-colors group <%= pIdx === 0 ? 'border-t-2 border-slate-200' : '' %>">
                                <!-- Nhân viên: chỉ hiện ở dòng đầu (rowspan visual) -->
                                <% if(pIdx === 0) { %>
                                    <td class="px-5 py-3" rowspan="2">
                                        <div class="flex items-center gap-3">
                                            <div class="size-9 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 overflow-hidden shrink-0">
                                                <% if(p.staff.avatar) { %>
                                                    <img src="<%= p.staff.avatar %>" alt="Ảnh" class="w-full h-full object-cover">
                                                <% } else { %>
                                                    <span class="material-symbols-outlined text-lg">person</span>
                                                <% } %>
                                            </div>
                                            <div>
                                                <p class="text-sm font-semibold text-slate-800 leading-tight"><%= p.staff.name %></p>
                                                <p class="text-[10px] text-slate-400 uppercase tracking-wider">
                                                    <%= roleVN %> · <%= p.detailCount %> <%= p.staff.role === 'PT' ? 'đơn vị' : 'HĐ' %>
                                                    <% if (p.staff.role === 'PT' && p.commissionSource) { %>
                                                    · <span class="text-amber-600"><%= p.commissionSource %></span>
                                                    <% } %>
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                <% } %>

                                <!-- Kỳ -->
                                <td class="px-3 py-3 text-center">
                                    <span class="inline-block whitespace-nowrap px-2.5 py-0.5 rounded-full text-[11px] font-bold border <%= pr.num === 1 ? 'bg-blue-50 text-blue-700 border-blue-200' : 'bg-violet-50 text-violet-700 border-violet-200' %>">
                                        Kỳ <%= pr.num %>
                                    </span>
                                </td>

                                <!-- Ngày đề xuất -->
                                <td class="px-3 py-3 text-center text-xs font-medium text-slate-600">
                                    <% if(pr.record && pr.record.suggestedPayDate) { %>
                                        <%= new Date(pr.record.suggestedPayDate).toLocaleDateString('vi-VN') %>
                                    <% } else { %>
                                        <% 
                                            let nextM = parseInt(month) + 1;
                                            let nextY = parseInt(year);
                                            if(nextM > 12) { nextM = 1; nextY++; }
                                        %>
                                        <%= pr.payDay %>/<%= nextM %>/<%= nextY %>
                                    <% } %>
                                </td>

                                <!-- Lương cứng -->
                                <td class="px-3 py-3 text-right text-xs font-medium text-slate-700 tabular-nums">
                                    <%= new Intl.NumberFormat('vi-VN').format(Math.round(pr.record ? pr.record.baseSalary : p.halfBase)) %>
                                </td>

                                <!-- Hoa hồng -->
                                <td class="px-3 py-3 text-right text-xs font-bold tabular-nums <%= (pr.record ? pr.record.commission : p.halfCommission) > 0 ? 'text-amber-600' : 'text-slate-400' %>">
                                    +<%= new Intl.NumberFormat('vi-VN').format(Math.round(pr.record ? pr.record.commission : p.halfCommission)) %>
                                </td>

                                <!-- Khấu trừ -->
                                <td class="px-3 py-3 text-right text-xs font-medium text-rose-500 tabular-nums">
                                    -<%= new Intl.NumberFormat('vi-VN').format(Math.round(pr.record ? pr.record.deductions : p.halfPenalty)) %>
                                </td>

                                <!-- Thực nhận -->
                                <td class="px-3 py-3 text-right">
                                    <span class="text-xs font-bold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded tabular-nums">
                                        <%= new Intl.NumberFormat('vi-VN').format(Math.round(pr.record ? pr.record.totalSalary : (p.halfBase + p.halfCommission - p.halfPenalty))) %>
                                    </span>
                                </td>

                                <!-- Trạng thái -->
                                <td class="px-3 py-3 text-center">
                                    <% if(pr.record) { %>
                                        <% if(pr.record.status === 'Paid') { %>
                                            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                                                <span class="size-1.5 rounded-full bg-emerald-500"></span> Đã trả
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">
                                                <span class="size-1.5 rounded-full bg-amber-500 animate-pulse"></span> Chờ trả
                                            </span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="text-[11px] font-bold text-slate-400 border border-slate-200 px-2 py-0.5 rounded-full">Chưa tạo</span>
                                    <% } %>
                                </td>

                                <!-- Thao tác -->
                                <td class="px-3 py-3 text-center">
                                    <% if(pr.record) { %>
                                        <% if(pr.record.status === 'Pending') { %>
                                            <% if (typeof canManagePayroll === 'undefined' || canManagePayroll) { %>
                                            <div class="flex flex-col gap-1 items-center">
                                            <button type="button"
                                                data-payroll-id="<%= pr.record._id %>"
                                                data-staff-name="<%= p.staff.name %> — Kỳ <%= pr.num %>"
                                                data-total-salary="<%= pr.record.totalSalary %>"
                                                data-bonus="<%= pr.record.bonus %>"
                                                data-deductions="<%= pr.record.deductions %>"
                                                data-tax="<%= pr.record.tax || 0 %>"
                                                data-insurance="<%= pr.record.insurance || 0 %>"
                                                onclick="openPaymentModal(this.dataset.payrollId, this.dataset.staffName, this.dataset.totalSalary, this.dataset.bonus, this.dataset.deductions, this.dataset.tax, this.dataset.insurance)"
                                                class="px-3 py-1 bg-blue-600 text-white rounded-lg text-[11px] font-bold hover:bg-blue-700 transition-all">
                                                Thanh toán
                                            </button>
                                            <% if (pr.num === 1) { %>
                                            <form action="/admin/payroll/recalculate" method="POST" class="inline-block" onsubmit="return confirm('Tính lại hoa hồng theo hợp đồng mới nhất?')">
                                                <input type="hidden" name="staffId" value="<%= p.staff._id %>">
                                                <input type="hidden" name="month" value="<%= month %>">
                                                <input type="hidden" name="year" value="<%= year %>">
                                                <button type="submit" class="px-3 py-1 bg-amber-500 text-white rounded-lg text-[10px] font-bold hover:bg-amber-600 transition-all" title="Cập nhật hoa hồng dựa trên hợp đồng mới nhất trong tháng">
                                                    ↻ Tính lại
                                                </button>
                                            </form>
                                            <% } %>
                                            </div>
                                            <% } else { %>
                                            <span title="Bạn không có quyền phê duyệt / thanh toán lương" class="px-3 py-1 bg-slate-200 text-slate-400 rounded-lg text-[11px] font-bold cursor-not-allowed">Thanh toán</span>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-emerald-500 text-[11px] font-bold">✓ Đã trả</span>
                                        <% } %>
                                    <% } else { %>
                                        <% if (typeof canManagePayroll === 'undefined' || canManagePayroll) { %>
                                        <form action="/admin/payroll/approve" method="POST" class="inline-block">
                                            <input type="hidden" name="staffId" value="<%= p.staff._id %>">
                                            <input type="hidden" name="month" value="<%= month %>">
                                            <input type="hidden" name="year" value="<%= year %>">
                                            <input type="hidden" name="commission" value="<%= p.commission %>">
                                            <button type="submit" class="px-3 py-1 bg-emerald-600 text-white rounded-lg text-[11px] font-bold hover:bg-emerald-700 transition-all">
                                                Phê duyệt
                                            </button>
                                        </form>
                                        <% } else { %>
                                        <span title="Bạn không có quyền phê duyệt / thanh toán lương" class="px-3 py-1 bg-slate-200 text-slate-400 rounded-lg text-[11px] font-bold cursor-not-allowed">Phê duyệt</span>
                                        <% } %>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="9" class="px-6 py-12 text-center text-slate-400 italic bg-slate-50/20">
                            Không tìm thấy nhân viên nào trong kỳ tính lương này.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
