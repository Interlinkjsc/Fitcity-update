<%- include('../../partials/header', { title: 'Lịch dạy PT', activePage: 'slots' }) %>

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">Lịch dạy PT</h2>
        <p class="text-slate-500 text-sm mt-1">Danh sách slot lịch dạy của PT — yêu cầu đặt/đổi lịch đang chờ xử lý</p>
    </div>
    <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-blue-50 text-blue-700 text-sm font-semibold rounded-full border border-blue-200">
        <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
        <%= (pendingSlots && pendingSlots.length) || 0 %> yêu cầu
    </span>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Thời gian yêu cầu</th>
                    <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Slot dạy</th>
                    <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">PT</th>
                    <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Khách hàng</th>
                    <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Loại</th>
                    <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Chi nhánh</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if (pendingSlots && pendingSlots.length > 0) { %>
                    <% pendingSlots.forEach(s => { %>
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 whitespace-nowrap text-slate-600">
                                <%= s.pending && s.pending.requestedAt ? new Date(s.pending.requestedAt).toLocaleString('vi-VN') : '-' %>
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-slate-800 font-medium">
                                <%= new Date(s.startTime).toLocaleString('vi-VN') %>
                            </td>
                            <td class="px-4 py-3 text-slate-800"><%= s.pt ? s.pt.name : '-' %></td>
                            <td class="px-4 py-3 text-slate-600"><%= s.pending && s.pending.client ? s.pending.client.name : '-' %></td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-semibold bg-amber-100 text-amber-700 border border-amber-200">
                                    <%= s.pending && s.pending.type ? s.pending.type : 'Book' %>
                                </span>
                            </td>
                            <td class="px-4 py-3 text-slate-600"><%= s.branch ? s.branch.name : '-' %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td class="px-4 py-12 text-center text-slate-400 text-sm" colspan="6">
                            <span class="material-symbols-outlined text-4xl block mb-2 text-slate-300">calendar_month</span>
                            Không có yêu cầu lịch dạy nào đang chờ xử lý.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../../partials/pagination') %>
<%- include('../../partials/footer') %>
