<%- include('../../partials/header', { title: 'Chi tiết Chi nhánh', activePage: 'branches' }) %>

<div class="max-w-5xl mx-auto">
    <!-- Header Page -->
    <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <a href="/admin/branches/list" class="text-sm text-slate-500 hover:text-lime-600 transition-colors flex items-center gap-1 mb-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Quay lại danh sách Chi nhánh
            </a>
            <h2 class="text-2xl font-bold text-slate-800">Cơ sở: <%= branch.name %></h2>
        </div>
        <div class="flex gap-2">
            <a href="/admin/branches/edit/<%= branch._id %>" class="inline-flex items-center justify-center px-4 py-2 bg-blue-50 text-blue-700 hover:bg-blue-100 font-semibold rounded-lg transition-colors shadow-sm">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                Chỉnh sửa
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Column -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Basic Information Card -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-6 border-b border-slate-100 flex items-center gap-3">
                    <div class="p-2 bg-indigo-50 text-indigo-600 rounded-lg">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800">Thông tin Cơ sở</h3>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8">
                        <div>
                            <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Tên Chi nhánh</span>
                            <div class="font-bold text-slate-800 text-base"><%= branch.name %></div>
                        </div>
                        <div>
                            <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Số điện thoại Hotline</span>
                            <div class="font-medium text-slate-700 text-base flex items-center gap-2">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                <%= branch.phone || 'Chưa cập nhật' %>
                            </div>
                        </div>
                        <div class="md:col-span-2">
                            <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Địa chỉ</span>
                            <div class="font-medium text-slate-700 text-base flex items-start gap-2">
                                <svg class="w-5 h-5 text-slate-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                <%= branch.address %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Management Card -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-6 border-b border-slate-100 flex items-center gap-3">
                    <div class="p-2 bg-amber-50 text-amber-600 rounded-lg">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800">Quản lý trực tiếp (Manager)</h3>
                </div>
                <div class="p-6">
                    <% if (branch.manager) { %>
                        <div class="flex items-center gap-4">
                            <% if(branch.manager.avatar) { %>
                                <img src="<%= branch.manager.avatar %>" alt="Manager Avatar" class="h-16 w-16 rounded-full object-cover border border-slate-200">
                            <% } else { %>
                                <div class="h-16 w-16 rounded-full bg-slate-100 flex items-center justify-center border border-slate-200">
                                    <svg class="h-8 w-8 text-slate-400" fill="currentColor" viewBox="0 0 24 24"><path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                                </div>
                            <% } %>
                            <div>
                                <h4 class="text-xl font-bold text-slate-800 mb-1"><%= branch.manager.name %></h4>
                                <div class="flex flex-col gap-1 text-sm text-slate-600">
                                    <span class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                        <%= branch.manager.email %>
                                    </span>
                                    <% if (branch.manager.phone) { %>
                                    <span class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                        <%= branch.manager.phone %>
                                    </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-slate-100">
                            <a href="/admin/users/detail/<%= branch.manager._id %>" class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">→ Phân tích hiệu suất Quản lý (KPI/Doanh thu)</a>
                        </div>
                    <% } else { %>
                        <div class="flex items-center gap-3 p-4 bg-orange-50 border border-orange-100 rounded-lg">
                            <svg class="w-6 h-6 text-orange-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                            <p class="text-sm text-orange-800 font-medium">Chi nhánh này hiện tại chưa có Quản lý. Hãy phân công Quản lý ngay để đảm bảo vận hành.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Sidebar Section -->
        <div class="space-y-6">
            <!-- Key Metrics -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-5 border-b border-slate-100">
                    <h3 class="text-base font-bold text-slate-800">Chỉ số Hoạt động</h3>
                </div>
                <div class="p-5 space-y-4">
                    <!-- Staff Count -->
                    <div class="space-y-2">
                        <div class="flex justify-between items-end">
                            <span class="text-sm font-medium text-slate-600">Tổng nhân sự</span>
                            <span class="text-2xl font-black text-slate-800"><%= staffCount %></span>
                        </div>
                        <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                            <div class="h-full bg-indigo-500 rounded-full" style="width: 100%"></div>
                        </div>
                        <div class="flex justify-between text-xs text-slate-500 pt-1">
                            <span>PT: <strong class="text-slate-700"><%= ptCount %></strong></span>
                            <span>Sales: <strong class="text-slate-700"><%= salesCount %></strong></span>
                        </div>
                    </div>

                    <div class="border-t border-slate-100 my-4"></div>

                    <!-- Active Contracts Count -->
                    <div class="space-y-2">
                        <div class="flex justify-between items-center mb-1">
                            <div class="flex items-center gap-1.5 text-sm font-medium text-slate-600">
                                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Hợp đồng Active
                            </div>
                            <span class="text-xl font-bold border border-emerald-200 bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-md"><%= activeContractsCount %></span>
                        </div>
                        <p class="text-xs text-slate-500 leading-relaxed">
                            Tổng số lượng hợp đồng khách hàng đang trong trạng thái "Active" ở chi nhánh này.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="bg-slate-50 rounded-xl border border-slate-200 p-5">
                <h3 class="text-base font-bold text-slate-800 mb-4">Lối tắt thao tác</h3>
                <div class="space-y-2">
                    <a href="/admin/users/list?branch=<%= branch._id %>" class="flex items-center justify-between p-3 bg-white border border-slate-200 rounded-lg hover:border-lime-500 hover:shadow-sm transition-all group">
                        <span class="text-sm font-medium text-slate-700 group-hover:text-lime-700">Xem danh sách Nhân viên</span>
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </a>
                    <a href="/admin/contracts/list" class="flex items-center justify-between p-3 bg-white border border-slate-200 rounded-lg hover:border-lime-500 hover:shadow-sm transition-all group">
                        <span class="text-sm font-medium text-slate-700 group-hover:text-lime-700">Quản lý Hợp đồng</span>
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </a>
                    <!-- NOTE: Expenses or revenues by branch would be linked here ideally -->
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/footer') %>
