<%- include('../../partials/header', { title: isEdit ? 'Sửa checklist' : 'Tạo checklist', activePage: 'checklists' }) %>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800"><%= isEdit ? 'Sửa công việc' : 'Tạo công việc checklist' %></h2>
    <a href="/admin/checklists" class="text-sm text-blue-600 hover:underline">Quay lại danh sách</a>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm max-w-2xl p-6 md:p-8">
    <form action="<%= isEdit ? '/admin/checklists/update/' + task._id : '/admin/checklists/store' %>" method="POST" class="space-y-5">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Tiêu đề <span class="text-red-500">*</span></label>
            <input type="text" name="title" required value="<%= task.title || '' %>" class="w-full border border-slate-300 rounded-lg py-2 px-3 text-sm">
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Mô tả</label>
            <textarea name="description" rows="3" class="w-full border border-slate-300 rounded-lg py-2 px-3 text-sm"><%= task.description || '' %></textarea>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Chi nhánh</label>
                <select name="branchId" class="w-full border border-slate-300 rounded-lg py-2 px-3 text-sm">
                    <option value="">Không chọn</option>
                    <% branches.forEach(b => { %>
                    <option value="<%= b._id %>" <%= task.branch && task.branch.toString() === b._id.toString() ? 'selected' : '' %>><%= b.name %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Giao cho</label>
                <select name="assigneeId" class="w-full border border-slate-300 rounded-lg py-2 px-3 text-sm">
                    <option value="">Chưa giao</option>
                    <% staff.forEach(s => { %>
                    <option value="<%= s._id %>" <%= task.assignee && task.assignee.toString() === s._id.toString() ? 'selected' : '' %>><%= s.name %> (<%= s.role %>)</option>
                    <% }) %>
                </select>
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Hạn hoàn thành</label>
                <input type="date" name="dueDate" value="<%= task.dueDate ? new Date(task.dueDate).toISOString().slice(0,10) : '' %>" class="w-full border border-slate-300 rounded-lg py-2 px-3 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Ưu tiên</label>
                <select name="priority" class="w-full border border-slate-300 rounded-lg py-2 px-3 text-sm">
                    <option value="Low" <%= task.priority === 'Low' ? 'selected' : '' %>>Thấp</option>
                    <option value="Medium" <%= !task.priority || task.priority === 'Medium' ? 'selected' : '' %>>Trung bình</option>
                    <option value="High" <%= task.priority === 'High' ? 'selected' : '' %>>Cao</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Trạng thái</label>
                <select name="status" class="w-full border border-slate-300 rounded-lg py-2 px-3 text-sm">
                    <option value="Todo" <%= !task.status || task.status === 'Todo' ? 'selected' : '' %>>Chưa làm</option>
                    <option value="In_Progress" <%= task.status === 'In_Progress' ? 'selected' : '' %>>Đang làm</option>
                    <option value="Done" <%= task.status === 'Done' ? 'selected' : '' %>>Hoàn thành</option>
                </select>
            </div>
        </div>
        <div class="flex gap-3 pt-4">
            <button type="submit" class="px-6 py-2.5 bg-green-600 text-white font-bold rounded-lg text-sm hover:bg-green-700">Lưu</button>
            <a href="/admin/checklists" class="px-6 py-2.5 bg-slate-100 text-slate-700 font-bold rounded-lg text-sm">Hủy</a>
        </div>
    </form>
</div>

<%- include('../../partials/footer') %>
