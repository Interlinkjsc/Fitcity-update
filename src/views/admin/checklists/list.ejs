<%- include('../../partials/header', { title: 'Checklist công việc', activePage: 'checklists' }) %>

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">Checklist công việc</h2>
        <p class="text-slate-500 text-sm mt-1">Kiểm soát tiến độ — SRS CEO / Manager</p>
    </div>
    <a href="/admin/checklists/create" class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white text-sm font-bold rounded-lg hover:bg-green-700 shadow-sm">
        + Thêm công việc
    </a>
</div>

<form method="GET" class="mb-6 grid grid-cols-1 sm:grid-cols-4 gap-3 bg-white p-4 rounded-xl border border-slate-200">
    <select name="status" class="border border-slate-300 rounded-lg text-sm py-2 px-3">
        <option value="all">Tất cả trạng thái</option>
        <option value="Todo" <%= currentFilter.status === 'Todo' ? 'selected' : '' %>>Chưa làm</option>
        <option value="In_Progress" <%= currentFilter.status === 'In_Progress' ? 'selected' : '' %>>Đang làm</option>
        <option value="Done" <%= currentFilter.status === 'Done' ? 'selected' : '' %>>Hoàn thành</option>
    </select>
    <select name="branchId" class="border border-slate-300 rounded-lg text-sm py-2 px-3">
        <option value="all">Tất cả chi nhánh</option>
        <% branches.forEach(b => { %>
        <option value="<%= b._id %>" <%= currentFilter.branchId === b._id.toString() ? 'selected' : '' %>><%= b.name %></option>
        <% }) %>
    </select>
    <select name="assigneeId" class="border border-slate-300 rounded-lg text-sm py-2 px-3">
        <option value="all">Mọi người được giao</option>
        <% staff.forEach(s => { %>
        <option value="<%= s._id %>" <%= currentFilter.assigneeId === s._id.toString() ? 'selected' : '' %>><%= s.name %> (<%= s.role %>)</option>
        <% }) %>
    </select>
    <button type="submit" class="py-2 bg-slate-800 text-white text-sm font-bold rounded-lg">Lọc</button>
</form>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-500 uppercase text-[10px] tracking-widest">
            <tr>
                <th class="px-4 py-3 text-left">Công việc</th>
                <th class="px-4 py-3 text-left">Người nhận</th>
                <th class="px-4 py-3 text-left">Chi nhánh</th>
                <th class="px-4 py-3 text-left">Hạn</th>
                <th class="px-4 py-3 text-left">Ưu tiên</th>
                <th class="px-4 py-3 text-left">Trạng thái</th>
                <th class="px-4 py-3 text-right">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            <% if (!tasks.length) { %>
            <tr><td colspan="7" class="px-4 py-12 text-center text-slate-400">Chưa có công việc checklist.</td></tr>
            <% } %>
            <% tasks.forEach(task => { %>
            <tr class="hover:bg-slate-50">
                <td class="px-4 py-3">
                    <p class="font-bold text-slate-800"><%= task.title %></p>
                    <% if (task.description) { %><p class="text-xs text-slate-500 mt-0.5"><%= task.description %></p><% } %>
                </td>
                <td class="px-4 py-3"><%= task.assignee ? task.assignee.name : '—' %></td>
                <td class="px-4 py-3"><%= task.branch ? task.branch.name : '—' %></td>
                <td class="px-4 py-3 text-xs"><%= task.dueDate ? new Date(task.dueDate).toLocaleDateString('vi-VN') : '—' %></td>
                <td class="px-4 py-3"><span class="text-[10px] font-black uppercase"><%= task.priority %></span></td>
                <td class="px-4 py-3">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= task.status === 'Done' ? 'bg-emerald-100 text-emerald-700' : task.status === 'In_Progress' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600' %>">
                        <%= task.status %>
                    </span>
                </td>
                <td class="px-4 py-3 text-right space-x-2">
                    <a href="/admin/checklists/edit/<%= task._id %>" class="text-blue-600 hover:underline text-xs font-bold">Sửa</a>
                    <form action="/admin/checklists/delete/<%= task._id %>" method="POST" class="inline" onsubmit="return confirm('Xóa công việc này?')">
                        <button type="submit" class="text-rose-600 hover:underline text-xs font-bold">Xóa</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<%- include('../../partials/footer') %>
