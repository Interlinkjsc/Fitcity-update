<%- include('../../partials/header', { title: isEdit ? 'Cập nhật Vi phạm' : 'Ghi nhận Vi phạm', activePage: 'violations' }) %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-800"><%= isEdit ? 'Cập nhật Vi phạm' : 'Ghi nhận Vi phạm' %></h2>
        <p class="text-slate-500 text-sm mt-1">
            <a href="/admin/violations" class="text-blue-600 hover:underline">Quản lý kỷ luật</a> / <%= isEdit ? 'Chỉnh sửa' : 'Tạo mới' %>
        </p>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden max-w-2xl">
    <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
        <h3 class="font-semibold text-slate-800 flex items-center gap-2">
            <span class="material-symbols-outlined text-rose-500">warning</span>
            Thông tin chi tiết
        </h3>
    </div>
    
    <form action="/admin/violations/<%= isEdit ? 'update/' + violation._id : 'store' %>" method="POST" class="p-6 space-y-6">
        <div>
            <label for="staffInput" class="block text-sm font-medium text-slate-700 mb-2">Nhân sự vi phạm <span class="text-red-500">*</span></label>
            <div class="relative" id="staffDropdownContainer">
                <div class="relative group">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 group-focus-within:text-rose-500 transition-colors pointer-events-none">
                        <span class="material-symbols-outlined text-[20px]">person_search</span>
                    </span>
                    <input type="text" id="staffInput" placeholder="Tìm tên, email hoặc vai trò..." 
                        class="w-full pl-11 pr-12 text-sm border-slate-200 rounded-xl focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 py-3 outline-none transition-all shadow-sm bg-slate-50/50"
                        autocomplete="off"
                        value="<%= isEdit && violation.staffInfo ? (violation.staffInfo.name + ' (' + violation.staffInfo.role + ')') : '' %>"
                        required>
                    
                    <div id="selectionStatus" class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                        <span class="material-symbols-outlined text-emerald-500 hidden" id="validIcon">check_circle</span>
                        <span class="material-symbols-outlined text-slate-300" id="invalidIcon">help_outline</span>
                    </div>
                </div>

                <!-- Custom Dropdown Menu -->
                <div id="staffCustomDropdown" class="absolute z-[100] w-full mt-2 bg-white border border-slate-200 rounded-xl shadow-2xl hidden max-h-72 overflow-y-auto overscroll-contain transition-all duration-200 opacity-0 scale-95 origin-top">
                    <div class="p-2 space-y-1" id="staffListItems">
                        <% staff.forEach(s => { %>
                            <button type="button" class="staff-option w-full text-left px-4 py-3 rounded-lg hover:bg-slate-50 transition-colors flex items-center justify-between group" 
                                data-id="<%= s._id %>" 
                                data-display="<%= s.name %> (<%= s.role %>)">
                                <div>
                                    <div class="font-bold text-slate-800 text-sm group-hover:text-rose-600 transition-colors"><%= s.name %></div>
                                    <div class="text-[11px] text-slate-500"><%= s.role %> • <%= s.email %></div>
                                </div>
                                <span class="material-symbols-outlined text-slate-300 group-hover:text-rose-400 opacity-0 group-hover:opacity-100 transition-all text-sm">add_circle</span>
                            </button>
                        <% }) %>
                    </div>
                    <div id="noResults" class="p-8 text-center hidden">
                        <span class="material-symbols-outlined text-slate-300 text-4xl mb-2">person_off</span>
                        <p class="text-xs text-slate-500">Không tìm thấy nhân viên nào phù hợp</p>
                    </div>
                </div>

                <!-- Hidden input để gửi ID lên server -->
                <input type="hidden" name="staff" id="staffId" value="<%= isEdit && violation.staff ? violation.staff : '' %>" required>
            </div>
            <p id="staffError" class="mt-2 text-[11px] text-rose-500 font-medium hidden flex items-center gap-1">
                <span class="material-symbols-outlined text-xs">info</span>
                Vui lòng chọn nhân sự từ danh sách hiển thị.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label for="type" class="block text-sm font-medium text-slate-700 mb-1">Loại vi phạm <span class="text-red-500">*</span></label>
                <select name="type" id="type" required class="w-full text-sm border-slate-300 rounded-md focus:ring-rose-500 focus:border-rose-500">
                    <% const types = ['Đi trễ', 'Vắng mặt không phép', 'Thái độ không tốt', 'Vi phạm nội quy', 'Khác']; %>
                    <% types.forEach(t => { %>
                        <option value="<%= t %>" <%= isEdit && violation.type === t ? 'selected' : '' %>><%= t %></option>
                    <% }) %>
                </select>
            </div>
            
            <div>
                <label for="date" class="block text-sm font-medium text-slate-700 mb-1">Ngày vi phạm <span class="text-red-500">*</span></label>
                <input type="date" name="date" id="date" required 
                    value="<%= isEdit && violation.date ? new Date(violation.date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>"
                    class="w-full text-sm border-slate-300 rounded-md focus:ring-rose-500 focus:border-rose-500">
            </div>
        </div>

        <div>
            <label for="penaltyAmount" class="block text-sm font-medium text-slate-700 mb-1">Số tiền phạt (VNĐ) <span class="text-red-500">*</span></label>
            <div class="relative">
                <input type="number" name="penaltyAmount" id="penaltyAmount" required min="0" 
                    value="<%= isEdit ? violation.penaltyAmount : 0 %>"
                    class="w-full text-sm border-slate-300 rounded-md focus:ring-rose-500 focus:border-rose-500 pl-3 pr-12">
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <span class="text-slate-500 sm:text-sm">VNĐ</span>
                </div>
            </div>
            <p class="mt-1 text-xs text-slate-500">Số tiền này sẽ được trừ trực tiếp vào đợt tính lương tiếp theo của nhân sự.</p>
        </div>

        <div>
            <label for="description" class="block text-sm font-medium text-slate-700 mb-1">Chi tiết vi phạm <span class="text-red-500">*</span></label>
            <textarea name="description" id="description" rows="3" required placeholder="Ghi chú chi tiết về sự việc..."
                class="w-full text-sm border-slate-300 rounded-md focus:ring-rose-500 focus:border-rose-500"><%= isEdit ? violation.description : '' %></textarea>
        </div>

        <% if (isEdit) { %>
            <div>
                <label for="status" class="block text-sm font-medium text-slate-700 mb-1">Trạng thái xử lý</label>
                <select name="status" id="status" class="w-full text-sm border-slate-300 rounded-md focus:ring-rose-500 focus:border-rose-500">
                    <option value="Pending" <%= violation.status === 'Pending' ? 'selected' : '' %>>Chưa trừ (Pending)</option>
                    <option value="Applied_To_Payroll" <%= violation.status === 'Applied_To_Payroll' ? 'selected' : '' %>>Đã trừ lương</option>
                    <option value="Cancelled" <%= violation.status === 'Cancelled' ? 'selected' : '' %>>Đã hủy (Không tính phạt)</option>
                </select>
                <p class="mt-1 text-xs text-amber-600">Lưu ý: Không thể hoàn tác trạng thái nếu vi phạm đã được tính vào lương.</p>
            </div>
        <% } %>

        <div class="flex justify-end gap-3 pt-6 border-t border-slate-100">
            <a href="/admin/violations" class="px-5 py-2 text-sm font-medium rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors">
                Hủy bỏ
            </a>
            <button type="submit" class="px-5 py-2 text-sm font-medium rounded-md bg-rose-600 text-white hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-rose-500 transition-colors shadow-sm">
                <%= isEdit ? 'Lưu cập nhật' : 'Ghi nhận vi phạm' %>
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const staffInput = document.getElementById('staffInput');
        const staffId = document.getElementById('staffId');
        const dropdown = document.getElementById('staffCustomDropdown');
        const options = document.querySelectorAll('.staff-option');
        const noResults = document.getElementById('noResults');
        const validIcon = document.getElementById('validIcon');
        const invalidIcon = document.getElementById('invalidIcon');
        const staffError = document.getElementById('staffError');
        const form = document.querySelector('form');
        
        let isDropdownVisible = false;

        function showDropdown() {
            dropdown.classList.remove('hidden');
            setTimeout(() => {
                dropdown.style.opacity = '1';
                dropdown.style.transform = 'scale(1)';
            }, 10);
            isDropdownVisible = true;
        }

        function hideDropdown() {
            dropdown.style.opacity = '0';
            dropdown.style.transform = 'scale(0.95)';
            setTimeout(() => {
                dropdown.classList.add('hidden');
            }, 200);
            isDropdownVisible = false;
        }

        function validateCurrentValue() {
            const currentVal = staffInput.value;
            let found = false;
            options.forEach(opt => {
                if (opt.dataset.display === currentVal) {
                    staffId.value = opt.dataset.id;
                    found = true;
                }
            });

            if (found) {
                validIcon.classList.remove('hidden');
                invalidIcon.classList.add('hidden');
                staffError.classList.add('hidden');
                staffInput.classList.add('border-emerald-500');
                staffInput.classList.remove('border-slate-200');
            } else {
                staffId.value = '';
                validIcon.classList.add('hidden');
                invalidIcon.classList.remove('hidden');
                staffInput.classList.remove('border-emerald-500');
                staffInput.classList.add('border-slate-200');
            }
        }

        staffInput.addEventListener('focus', showDropdown);
        
        staffInput.addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            let hasResults = false;

            if (!isDropdownVisible) showDropdown();

            options.forEach(opt => {
                const text = opt.dataset.display.toLowerCase();
                if (text.includes(term)) {
                    opt.classList.remove('hidden');
                    hasResults = true;
                } else {
                    opt.classList.add('hidden');
                }
            });

            if (hasResults) {
                noResults.classList.add('hidden');
            } else {
                noResults.classList.remove('hidden');
            }

            validateCurrentValue();
        });

        // Click chọn option
        options.forEach(opt => {
            opt.addEventListener('click', function() {
                staffInput.value = this.dataset.display;
                staffId.value = this.dataset.id;
                validateCurrentValue();
                hideDropdown();
            });
        });

        // Click bên ngoài để đóng
        document.addEventListener('click', function(e) {
            if (!document.getElementById('staffDropdownContainer').contains(e.target)) {
                hideDropdown();
            }
        });

        // Chặn submit nếu chưa chọn
        form.addEventListener('submit', function(e) {
            validateCurrentValue();
            if (!staffId.value) {
                e.preventDefault();
                staffError.classList.remove('hidden');
                staffInput.classList.add('border-rose-500');
                staffInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });

        // Khởi tạo trạng thái ban đầu nếu có giá trị
        if (staffInput.value) validateCurrentValue();
    });
</script>

<%- include('../../partials/footer') %>
