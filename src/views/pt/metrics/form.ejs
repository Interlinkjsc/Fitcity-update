<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../../partials/pt-head', { title: 'Cập nhật chỉ số - FitCity PT' }) %>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32">
    <%- include('../../partials/flash') %>
    <header class="p-8 pb-4">
        <div class="flex items-center gap-5">
            <div class="w-16 h-16 rounded-2xl overflow-hidden border border-slate-200 bg-slate-100">
                <img alt="Client" class="w-full h-full object-cover" src="<%= client.avatar || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(client.name || 'Client') + '&background=333&color=fff') %>"/>
            </div>
            <div>
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Cập nhật InBody</h1>
                <p class="text-slate-500 text-sm mt-1">Khách: <span class="text-slate-900 font-bold"><%= client.name %></span></p>
            </div>
        </div>
        <a href="/pt/metrics" class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-all mt-4 inline-block">Quay lại</a>
    </header>

    <main class="px-8">
    <form method="POST" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Core Stats -->
        <article class="glass border border-slate-200 p-8 rounded-3xl space-y-6 shadow-sm">
            <h4 class="text-xs font-black uppercase tracking-widest text-primary mb-4 border-b border-primary/20 pb-4">Chỉ số Cơ bản</h4>
            <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Cân nặng (kg)</label>
                <input type="number" step="0.1" name="weight" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 text-slate-900 focus:outline-none focus:border-primary/50 transition-all">
            </div>
            <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Chiều cao (cm)</label>
                <input type="number" step="1" name="height" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 text-slate-900 focus:outline-none focus:border-primary/50 transition-all">
            </div>
            <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Body Fat (%)</label>
                <input type="number" step="0.1" name="bodyFat" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 text-slate-900 focus:outline-none focus:border-primary/50 transition-all">
            </div>
        </article>

        <!-- Composition -->
        <article class="glass border border-slate-200 p-8 rounded-3xl space-y-6 shadow-sm">
            <h4 class="text-xs font-black uppercase tracking-widest text-primary mb-4 border-b border-primary/20 pb-4">Thành phần Cơ thể</h4>
            <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Lượng cơ (kg)</label>
                <input type="number" step="0.1" name="muscleMass" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 text-slate-900 focus:outline-none focus:border-primary/50 transition-all">
            </div>
            <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Mỡ nội tạng (Level)</label>
                <input type="number" step="1" name="visceralFat" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 text-slate-900 focus:outline-none focus:border-primary/50 transition-all">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Nước (%)</label>
                    <input type="number" step="0.1" name="water" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 text-slate-900 focus:outline-none focus:border-primary/50 transition-all">
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Protein (%)</label>
                    <input type="number" step="0.1" name="protein" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 text-slate-900 focus:outline-none focus:border-primary/50 transition-all">
                </div>
            </div>
            <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Khoáng chất (kg)</label>
                <input type="number" step="0.1" name="minerals" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 text-slate-900 focus:outline-none focus:border-primary/50 transition-all">
            </div>
            <div class="p-6 bg-primary/5 border border-primary/10 rounded-2xl">
                <p class="text-[10px] font-bold text-primary italic uppercase">Lưu ý chuyên môn:</p>
                <p class="text-[11px] text-slate-500 leading-relaxed mt-2">Dữ liệu sẽ được vẽ thành biểu đồ Radar để khách hàng theo dõi trực quan kết quả tập luyện hàng tháng.</p>
            </div>
        </article>

        <!-- Measurements -->
        <article class="glass border border-slate-200 p-8 rounded-3xl space-y-6 shadow-sm">
            <h4 class="text-xs font-black uppercase tracking-widest text-primary mb-4 border-b border-primary/20 pb-4">Số đo Tuyến tính (cm)</h4>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Vòng ngực</label>
                    <input type="number" step="0.5" name="chest" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Vòng eo</label>
                    <input type="number" step="0.5" name="waist" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Vòng mông</label>
                    <input type="number" step="0.5" name="hips" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Bắp tay</label>
                    <input type="number" step="0.5" name="bicep" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-sm focus:outline-none">
                </div>
            </div>
            <div class="space-y-4">
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 ml-1">Ghi chú / Nhận xét PT</label>
                    <textarea name="notes" rows="3" placeholder="Lưu ý về sức khỏe, mục tiêu tháng tới..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary/50 transition-all"></textarea>
                </div>
            </div>
            <div class="pt-2">
                <button type="submit" class="w-full py-5 bg-primary text-white font-black rounded-2xl shadow-xl shadow-primary/10 uppercase tracking-tighter hover:brightness-110 active:scale-95 transition-all">
                    Lưu kết quả InBody
                </button>
            </div>
        </article>
    </form>

    </main>
    <%- include('../../partials/nav_pt', { activePage: 'metrics' }) %>
</body>
</html>
