<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../../partials/pt-head', { title: 'Chỉ số cơ thể - FitCity PT' }) %>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32">
    <%- include('../../partials/flash') %>
    <header class="flex justify-between items-start p-6 mb-2">
        <div>
            <h1 class="screen-title">Chỉ số cơ thể <span class="text-primary tracking-normal">(InBody)</span></h1>
            <p class="text-slate-500 text-sm mt-2">Chọn khách hàng để cập nhật và xem lịch sử chỉ số.</p>
        </div>
        <a href="/pt" aria-label="Về dashboard PT" class="w-12 h-12 glass rounded-full flex items-center justify-center hover:bg-slate-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
            <span class="material-symbols-outlined">close</span>
        </a>
    </header>

    <main class="px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <% if (clients && clients.length > 0) { %>
                <% clients.forEach(client => { %>
                    <div class="glass border border-slate-200 rounded-[32px] overflow-hidden hover:border-primary/20 transition-all shadow-sm">
                        <div class="p-6">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="h-12 w-12 rounded-2xl overflow-hidden border border-slate-200 bg-slate-100">
                                    <img alt="Client Avatar" class="w-full h-full object-cover" src="<%= client.avatar || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(client.name || 'Client') + '&background=333&color=fff') %>"/>
                                </div>
                                <div>
                                    <h3 class="text-lg font-extrabold text-slate-900"><%= client.name %></h3>
                                    <p class="text-slate-500 text-xs font-bold uppercase tracking-widest"><%= client.activePackageName || 'Khách hàng' %></p>
                                </div>
                            </div>

                            <div class="flex gap-2">
                                <a href="/pt/metrics/add/<%= client._id %>" class="flex-1 px-4 py-3 bg-primary text-white rounded-xl text-xs font-black uppercase tracking-widest hover:brightness-95 transition-all">
                                    Cập nhật
                                </a>
                                <a href="/pt/metrics/history/<%= client._id %>" class="px-4 py-3 bg-white border border-slate-200 rounded-xl text-xs font-black uppercase tracking-widest text-slate-700 hover:bg-slate-50 transition-all">
                                    Lịch sử
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-full glass border border-dashed border-slate-300 rounded-2xl p-12 text-center text-slate-400">
                    Bạn hiện không có khách hàng nào để cập nhật chỉ số.
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../../partials/nav_pt', { activePage: 'metrics' }) %>
</body>
</html>
