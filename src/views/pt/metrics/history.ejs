<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../../partials/pt-head', { title: 'Lịch sử InBody - FitCity PT' }) %>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32">
    <%- include('../../partials/flash') %>
    <header class="p-6 pb-3">
        <div>
            <h1 class="screen-title">Lịch sử <span class="text-primary tracking-normal">InBody</span></h1>
            <p class="text-slate-500 text-sm mt-2">
                Khách hàng: <span class="text-slate-900 font-semibold"><%= client ? client.name : 'N/A' %></span>
            </p>
        </div>
    </header>

    <main class="px-6">
        <div class="mb-4">
            <a href="/pt/metrics" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-2xl text-xs font-black uppercase tracking-widest text-slate-600 hover:bg-slate-50 transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                Quay lại danh sách
            </a>
        </div>

        <% if (metrics && metrics.length > 0) { %>
            <div class="overflow-x-auto glass rounded-[32px] border border-slate-200 shadow-sm">
                <table class="w-full text-sm">
                    <thead class="border-b border-slate-200 text-slate-500 uppercase text-[11px] tracking-wider">
                        <tr>
                            <th class="px-4 py-3 text-left">Ngày</th>
                            <th class="px-4 py-3 text-right">Cân nặng</th>
                            <th class="px-4 py-3 text-right">Body Fat</th>
                            <th class="px-4 py-3 text-right">Cơ</th>
                            <th class="px-4 py-3 text-right">BMI</th>
                            <th class="px-4 py-3 text-left">Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        <% metrics.forEach(metric => { %>
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-4 py-3 font-medium"><%= new Date(metric.date || metric.createdAt).toLocaleDateString('vi-VN') %></td>
                                <td class="px-4 py-3 text-right"><%= metric.weight || 0 %> kg</td>
                                <td class="px-4 py-3 text-right"><%= metric.bodyFat || 0 %>%</td>
                                <td class="px-4 py-3 text-right"><%= metric.muscleMass || 0 %> kg</td>
                                <td class="px-4 py-3 text-right font-bold <%= (metric.bmi || 0) > 25 ? 'text-orange-600' : 'text-primary' %>"><%= metric.bmi || 0 %></td>
                                <td class="px-4 py-3 text-slate-500"><%= metric.notes || '-' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="glass rounded-[32px] border border-slate-200 p-12 text-center text-slate-400">
                <span class="material-symbols-outlined text-5xl mb-3">monitoring</span>
                <p>Chưa có dữ liệu InBody cho khách hàng này.</p>
            </div>
        <% } %>
    </main>

    <%- include('../../partials/nav_pt', { activePage: 'metrics' }) %>
</body>
</html>
