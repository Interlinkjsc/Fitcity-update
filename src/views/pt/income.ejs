<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Thu nhập - FitCity PT</title>
    <%- include('../partials/pt-head') %>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32">
    <%- include('../partials/flash') %>

    <header class="flex justify-between items-start p-8 mb-2">
        <div>
            <h1 class="text-2xl font-black tracking-tighter uppercase italic text-slate-900">Thu nhập <span class="text-primary">& Lương</span></h1>
            <p class="text-slate-500 text-[10px] font-bold uppercase tracking-widest mt-1">Lịch sử thanh toán & Sao kê</p>
        </div>
        <a href="/pt" aria-label="Về dashboard PT" class="size-12 glass rounded-2xl flex items-center justify-center hover:bg-white transition-all shadow-sm border border-slate-200">
            <span class="material-symbols-outlined text-slate-500">close</span>
        </a>
    </header>

    <main class="px-6 space-y-6">
        <section class="glass p-8 rounded-[40px] border border-slate-200 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 right-0 size-32 bg-primary/5 rounded-full blur-3xl"></div>
            
            <form method="GET" action="/pt/income" class="relative z-10 space-y-6">
                <div class="flex items-center gap-4">
                    <div class="flex-1 space-y-1.5">
                        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Chọn thời gian</label>
                        <div class="flex gap-2">
                            <div class="relative flex-1">
                                <select name="month" class="w-full appearance-none bg-white border border-slate-200 rounded-2xl text-xs font-black py-4 px-5 focus:border-primary outline-none transition-all">
                                    <% for(let m=1; m<=12; m++) { %>
                                        <option value="<%= m %>" <%= m == month ? 'selected' : '' %>>Tháng <%= m %></option>
                                    <% } %>
                                </select>
                                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-300 pointer-events-none text-lg">expand_more</span>
                            </div>
                            <div class="relative flex-1">
                                <select name="year" class="w-full appearance-none bg-white border border-slate-200 rounded-2xl text-xs font-black py-4 px-5 focus:border-primary outline-none transition-all">
                                    <% for(let y=2024; y<=new Date().getFullYear()+5; y++) { %>
                                        <option value="<%= y %>" <%= y == year ? 'selected' : '' %>><%= y %></option>
                                    <% } %>
                                </select>
                                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-300 pointer-events-none text-lg">expand_more</span>
                            </div>
                            <button type="submit" class="bg-slate-900 text-primary p-4 rounded-2xl hover:scale-105 active:scale-95 transition-all shadow-lg shadow-slate-900/20">
                                <span class="material-symbols-outlined">search</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-3 pt-4 border-t border-slate-100">
                    <div class="p-4 rounded-3xl bg-slate-50 border border-slate-100">
                        <p class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-1">Tổng cộng</p>
                        <p class="text-sm font-black text-slate-900"><%= (total/1000).toLocaleString() %>K</p>
                    </div>
                    <div class="p-4 rounded-3xl bg-emerald-50 border border-emerald-100">
                        <p class="text-[9px] font-black uppercase tracking-widest text-emerald-600/60 mb-1">Đã nhận</p>
                        <p class="text-sm font-black text-emerald-700"><%= (paid/1000).toLocaleString() %>K</p>
                    </div>
                    <div class="p-4 rounded-3xl bg-amber-50 border border-amber-100">
                        <p class="text-[9px] font-black uppercase tracking-widest text-amber-600/60 mb-1">Chờ nhận</p>
                        <p class="text-sm font-black text-amber-700"><%= (pending/1000).toLocaleString() %>K</p>
                    </div>
                </div>
            </form>
        </section>

        <section class="bg-white rounded-[32px] border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                <h2 class="font-black uppercase tracking-tighter">Bảng lương — Tháng <%= month %>/<%= year %></h2>
                <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">2 kỳ</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-slate-50 text-slate-500 text-[11px] font-bold uppercase tracking-widest border-b border-slate-200">
                            <th class="px-6 py-4">Kỳ</th>
                            <th class="px-4 py-4">Ngày TT đề xuất</th>
                            <th class="px-4 py-4 text-right">Lương cứng</th>
                            <th class="px-4 py-4 text-right">Hoa hồng</th>
                            <th class="px-4 py-4 text-right">Thưởng</th>
                            <th class="px-4 py-4 text-right">Khấu trừ</th>
                            <th class="px-4 py-4 text-right">Thực nhận</th>
                            <th class="px-4 py-4 text-center">Trạng thái</th>
                            <th class="px-4 py-4">Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (records && records.length > 0) { %>
                            <% records.forEach(r => { %>
                                <tr class="hover:bg-slate-50/70 transition-colors">
                                    <td class="px-6 py-4 font-black">Kỳ <%= r.period %></td>
                                    <td class="px-4 py-4 text-sm text-slate-600"><%= r.suggestedPayDate ? new Date(r.suggestedPayDate).toLocaleDateString('vi-VN') : '—' %></td>
                                    <td class="px-4 py-4 text-right font-mono text-sm"><%= new Intl.NumberFormat('vi-VN').format(r.baseSalary || 0) %></td>
                                    <td class="px-4 py-4 text-right font-mono text-sm text-amber-700"><%= new Intl.NumberFormat('vi-VN').format(r.commission || 0) %></td>
                                    <td class="px-4 py-4 text-right font-mono text-sm text-blue-700"><%= new Intl.NumberFormat('vi-VN').format(r.bonus || 0) %></td>
                                    <td class="px-4 py-4 text-right font-mono text-sm text-rose-700"><%= new Intl.NumberFormat('vi-VN').format(r.deductions || 0) %></td>
                                    <td class="px-4 py-4 text-right font-black text-emerald-700"><%= new Intl.NumberFormat('vi-VN').format(r.totalSalary || 0) %></td>
                                    <td class="px-4 py-4 text-center">
                                        <span class="text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-lg border
                                            <%= r.status === 'Paid' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200' %>">
                                            <%= r.status %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-4 text-xs text-slate-500"><%= r.note || '' %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" class="px-6 py-12 text-center text-slate-400 italic bg-slate-50/20">Chưa có bản ghi lương trong tháng này.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <%- include('../partials/nav_pt', { activePage: 'metrics' }) %>
</body>
</html>

