<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../../partials/pt-head', { title: 'Thiết lập Hợp đồng - FitCity PT' }) %>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32" x-data="{
    step: 1,
    totalSteps: 4,
    clientId: '',
    clientLabel: 'Chưa chọn hội viên',
    clientInfo: '',
    createNew: false,
    newClientName: '',
    branchId: '',
    branchLabel: 'Chọn chi nhánh',
    mode: 'template',
    selectedPkgId: '',
    selectedPkgName: 'Chưa chọn gói',
    selectedPkgPrice: 0,
    selectedPkgSessions: 0,
    selectedPkgDetails: '',
    customPkgName: '',
    customPkgDuration: 3,
    customPkgSessions: 10,
    discount: 0,
    paymentStatus: 'Unpaid',
    paymentStatusLabel: 'Chưa thu',

    nextStep() {
        if (this.step === 1 && !this.createNew && !this.clientId) { alert('Vui lòng chọn hội viên!'); return; }
        if (this.step === 1 && this.createNew && !this.newClientName) { alert('Vui lòng nhập tên hội viên mới!'); return; }
        if (this.step === 2) {
            if (this.mode === 'template' && !this.selectedPkgId) { alert('Vui lòng chọn gói tập!'); return; }
            if (this.mode === 'custom' && (!this.customPkgName || !this.selectedPkgPrice || this.customPkgSessions < 1)) { alert('Vui lòng điền đủ thông tin gói tùy chỉnh (tên, giá/buổi, số buổi)!'); return; }
            if (this.mode === 'template' && this.selectedPkgSessions < 1) { alert('Gói tập phải có số buổi lớn hơn 0!'); return; }
        }
        if (this.step < this.totalSteps) this.step++;
    },
    prevStep() {
        if (this.step > 1) this.step--;
    },
    get contractSessions() {
        return this.mode === 'template'
            ? (parseInt(this.selectedPkgSessions) || 0)
            : (parseInt(this.customPkgSessions) || 0);
    },
    get contractBase() {
        const unit = parseInt(this.selectedPkgPrice) || 0;
        return unit * this.contractSessions;
    },
    get totalPrice() {
        const disc = parseInt(this.discount) || 0;
        return Math.max(0, Math.round((this.contractBase - disc) * 1.1));
    }
}">
    <header class="p-8 pb-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <a href="/pt" class="size-10 bg-white border border-slate-200 rounded-xl flex items-center justify-center text-slate-500 hover:text-slate-900 transition-all shadow-sm">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
            </a>
            <div>
                <h1 class="text-xl font-extrabold text-slate-900 tracking-tight leading-none uppercase italic">Hợp Đồng</h1>
                <p class="text-slate-500 text-[9px] mt-1 uppercase tracking-widest font-black">Bước <span x-text="step"></span> / 4</p>
            </div>
        </div>
        <!-- Mini Stepper -->
        <div class="flex gap-1.5">
            <template x-for="i in totalSteps">
                <div class="h-1.5 rounded-full transition-all duration-500" 
                    :class="i <= step ? 'w-6 bg-primary' : 'w-2 bg-slate-200'"></div>
            </template>
        </div>
    </header>

    <main class="px-8 mt-4">
        <form action="/pt/contracts/store" method="POST" id="ptContractForm">
            
            <!-- STEP 1: CLIENT & BRANCH -->
            <div x-show="step === 1" x-transition.opacity.duration.300ms class="space-y-6">
                <section class="glass p-8 rounded-[40px] space-y-6 shadow-sm border-slate-200/60">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="size-8 rounded-full bg-primary/10 text-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-sm">person</span>
                        </div>
                        <h3 class="font-black text-xs uppercase tracking-widest text-slate-400">Thông tin cơ bản</h3>
                    </div>

                    <div class="space-y-2">
                        <!-- Toggle tabs - TRONG outer x-data (body), đảm bảo createNew ghi vào đúng scope -->
                        <div class="flex gap-2 mb-3">
                            <button type="button" @click="createNew = false"
                                :class="!createNew ? 'bg-primary text-white' : 'bg-slate-100 text-slate-500'"
                                class="flex-1 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all">
                                Chọn hội viên
                            </button>
                            <button type="button" @click="createNew = true"
                                :class="createNew ? 'bg-primary text-white' : 'bg-slate-100 text-slate-500'"
                                class="flex-1 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all">
                                + Tạo hội viên mới
                            </button>
                        </div>

                        <!-- Select existing - inner x-data CHỈ cho dropdown search -->
                        <div x-show="!createNew">
                            <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Hội viên *</label>
                            <div class="relative mt-1" x-data="{
                                open: false,
                                search: '',
                                clients: [
                                    <% clients.forEach(c => { %>
                                        { id: '<%= c._id %>', name: '<%= (c.name || "").replace(/'/g, "\\'") %>', info: '<%= (c.phone || "—").replace(/'/g, "\\'") %>' },
                                    <% }) %>
                                ],
                                get filteredClients() {
                                    return this.clients.filter(c => c.name.toLowerCase().includes(this.search.toLowerCase()) || c.info.includes(this.search))
                                }
                            }" @click.away="open = false">
                                <input type="hidden" name="client" :value="!createNew ? clientId : ''" :required="!createNew">
                                <button type="button" @click="open = !open"
                                    class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 text-left flex justify-between items-center focus:border-primary outline-none transition-all">
                                    <div>
                                        <span class="font-bold block" x-text="clientLabel || 'Chọn hội viên...'"></span>
                                        <span class="text-[10px] text-slate-400 font-medium" x-show="clientId" x-text="clientInfo"></span>
                                    </div>
                                    <span class="material-symbols-outlined text-slate-400 transition-transform duration-300" :class="open ? 'rotate-180' : ''">expand_more</span>
                                </button>
                                <div x-show="open" class="absolute left-0 w-full mt-2 bg-white border border-slate-200 rounded-3xl shadow-2xl z-50 overflow-hidden py-2 glass" style="display: none;">
                                    <div class="px-4 pb-2 pt-1">
                                        <input type="text" x-model="search" placeholder="Tìm kiếm..." class="w-full bg-slate-50 border-none rounded-xl py-2 px-4 text-xs outline-none">
                                    </div>
                                    <div class="max-h-60 overflow-y-auto">
                                        <template x-for="c in filteredClients" :key="c.id">
                                            <button type="button" @click="clientId = c.id; clientLabel = c.name; clientInfo = c.info; open = false"
                                                class="w-full text-left px-6 py-3 hover:bg-primary/5 group flex items-center justify-between">
                                                <div>
                                                    <p class="text-sm font-bold group-hover:text-primary" x-text="c.name"></p>
                                                    <p class="text-[10px] text-slate-400" x-text="c.info"></p>
                                                </div>
                                                <span x-show="clientId === c.id" class="material-symbols-outlined text-primary text-sm">check_circle</span>
                                            </button>
                                        </template>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Create new client - NGOÀI inner x-data, đọc createNew từ outer scope -->
                        <div x-show="createNew" class="space-y-3" style="display:none;">
                            <input type="hidden" name="createNewClient" value="true" x-bind:disabled="!createNew">
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Họ tên *</label>
                                <input type="text" name="newClientName" x-model="newClientName" :required="createNew"
                                    class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 font-bold outline-none focus:border-primary mt-1"
                                    placeholder="Nguyễn Văn A">
                            </div>
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Số điện thoại *</label>
                                <input type="tel" name="newClientPhone" :required="createNew"
                                    class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 font-bold outline-none focus:border-primary mt-1"
                                    placeholder="09xx xxx xxx">
                            </div>
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Email</label>
                                <input type="email" name="newClientEmail"
                                    class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 font-bold outline-none focus:border-primary mt-1"
                                    placeholder="email@example.com">
                            </div>
                            <%# Bug 3.3 (2/7): CCCD / giới tính / SĐT khẩn cấp bắt buộc trước khi tạo pass tạm %>
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Số CCCD / Định danh *</label>
                                <input type="text" name="newClientCccd" :required="createNew"
                                    class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 font-bold outline-none focus:border-primary mt-1"
                                    placeholder="0123456789xx">
                            </div>
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Giới tính *</label>
                                <select name="newClientGender" :required="createNew"
                                    class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 font-bold outline-none focus:border-primary mt-1">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">SĐT liên hệ khẩn cấp *</label>
                                <input type="tel" name="newClientEmergencyPhone" :required="createNew"
                                    class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 font-bold outline-none focus:border-primary mt-1"
                                    placeholder="09xx xxx xxx">
                            </div>
                            <%# Bug 23/7 M3: đủ trường theo form HĐ mẫu %>
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Tên người liên hệ khẩn cấp</label>
                                <input type="text" name="newClientEmergencyName" class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 font-bold outline-none focus:border-primary mt-1" placeholder="Họ tên">
                            </div>
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Địa chỉ liên lạc</label>
                                <input type="text" name="newClientAddress" class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 font-bold outline-none focus:border-primary mt-1" placeholder="Số nhà, đường, phường...">
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Ngày sinh</label>
                                    <input type="date" name="newClientDob" class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-4 text-slate-900 font-bold outline-none focus:border-primary mt-1">
                                </div>
                                <div>
                                    <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Ngày cấp CCCD</label>
                                    <input type="date" name="newClientCccdIssueDate" class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-4 text-slate-900 font-bold outline-none focus:border-primary mt-1">
                                </div>
                            </div>
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Nơi cấp CCCD</label>
                                <input type="text" name="newClientCccdIssuePlace" class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 font-bold outline-none focus:border-primary mt-1" placeholder="VD: Cục CSQLHC">
                            </div>
                            <p class="text-[10px] text-slate-400 bg-slate-50 rounded-xl px-4 py-2">
                                Hội viên mới sẽ được tạo tự động với mật khẩu tạm thời gửi qua email.
                            </p>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Chi nhánh *</label>
                        <div class="relative">
                            <select name="branch" x-model="branchId" @change="branchLabel = $el.options[$el.selectedIndex].text" required class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-slate-900 font-bold outline-none appearance-none focus:border-primary">
                                <% branches.forEach(br => { %>
                                    <option value="<%= br._id %>"><%= br.name %></option>
                                <% }) %>
                            </select>
                            <span class="material-symbols-outlined absolute right-6 top-1/2 -translate-y-1/2 text-slate-300 pointer-events-none">expand_more</span>
                        </div>
                    </div>
                </section>
            </div>

            <!-- STEP 2: PACKAGE -->
            <div x-show="step === 2" x-transition.opacity.duration.300ms class="space-y-6" style="display: none;">
                <section class="glass p-8 rounded-[40px] space-y-6 shadow-sm border-slate-200/60">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-3">
                            <div class="size-8 rounded-full bg-primary/10 text-primary flex items-center justify-center">
                                <span class="material-symbols-outlined text-sm">inventory_2</span>
                            </div>
                            <h3 class="font-black text-xs uppercase tracking-widest text-slate-400">Gói dịch vụ</h3>
                        </div>
                        <div class="flex bg-slate-100 p-1 rounded-full">
                            <button type="button" @click="mode = 'template'" :class="mode === 'template' ? 'bg-white shadow-sm text-slate-900' : 'text-slate-400'" class="px-4 py-1.5 rounded-full text-[9px] font-black uppercase">Thư viện</button>
                            <button type="button" @click="mode = 'custom'" :class="mode === 'custom' ? 'bg-white shadow-sm text-slate-900' : 'text-slate-400'" class="px-4 py-1.5 rounded-full text-[9px] font-black uppercase">Tùy chỉnh</button>
                        </div>
                    </div>

                    <div x-show="mode === 'template'" class="space-y-4">
                        <div class="grid grid-cols-1 gap-3">
                            <% packages.forEach(pkg => { const pkgMo = pkg.durationMonths || Math.max(1, Math.round((pkg.duration || 30) / 30)); %>
                                <label class="cursor-pointer group">
                                    <input type="radio" name="servicePackage" value="<%= pkg._id %>" class="hidden peer" 
                                        @change="selectedPkgId = '<%= pkg._id %>'; selectedPkgName = '<%= pkg.name %>'; selectedPkgPrice = <%= pkg.price %>; selectedPkgSessions = <%= pkg.sessions || 0 %>; selectedPkgDetails = '<%= pkg.type %> • <%= pkgMo %> tháng • <%= pkg.sessions || 0 %> buổi'">
                                    <div class="bg-white border border-slate-100 p-5 rounded-3xl transition-all peer-checked:border-primary peer-checked:bg-primary/5 peer-checked:ring-2 peer-checked:ring-primary/20 shadow-sm">
                                        <div class="flex justify-between items-start mb-1">
                                            <span class="text-xs font-black text-slate-900 group-hover:text-primary transition-colors uppercase italic tracking-tight"><%= pkg.name %></span>
                                            <span class="text-[10px] font-bold text-primary bg-primary/10 px-2 py-0.5 rounded-full"><%= pkg.type %></span>
                                        </div>
                                        <div class="flex justify-between items-end">
                                            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider"><%= pkgMo %> tháng</p>
                                            <p class="font-black text-slate-900"><%= pkg.price.toLocaleString('vi-VN') %> đ/buổi</p>
                                        </div>
                                    </div>
                                </label>
                            <% }) %>
                        </div>
                    </div>

                    <%# Bug 3.1 (2/7): ô số tháng / số buổi chỉ hiện số trần — thêm label rõ nghĩa %>
                    <div x-show="mode === 'custom'" class="space-y-4" style="display: none;">
                        <div>
                            <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Tên gói tùy chỉnh *</label>
                            <input type="text" name="customPkgName" x-model="customPkgName" placeholder="Tên gói tùy chỉnh..." class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-sm font-bold outline-none focus:border-primary mt-1">
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Số tháng *</label>
                                <input type="number" name="customPkgDuration" x-model="customPkgDuration" min="1" placeholder="VD: 3" class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-sm font-bold outline-none focus:border-primary mt-1">
                            </div>
                            <div>
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Số buổi tập *</label>
                                <input type="number" name="customPkgSessions" x-model="customPkgSessions" min="1" placeholder="VD: 10" class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-sm font-bold outline-none focus:border-primary mt-1">
                            </div>
                            <div class="col-span-2">
                                <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Giá / buổi (VNĐ) *</label>
                                <input type="number" name="customPkgPrice" x-model="selectedPkgPrice" placeholder="VD: 500000" class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-sm font-black text-primary outline-none focus:border-primary mt-1">
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <!-- STEP 3: FINANCE -->
            <div x-show="step === 3" x-transition.opacity.duration.300ms class="space-y-6" style="display: none;">
                <section class="glass p-8 rounded-[40px] space-y-6 shadow-sm border-slate-200/60">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="size-8 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center">
                            <span class="material-symbols-outlined text-sm">payments</span>
                        </div>
                        <h3 class="font-black text-xs uppercase tracking-widest text-slate-400">Thanh toán</h3>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Chiết khấu (VNĐ)</label>
                        <input type="number" name="discount" x-model="discount" class="w-full bg-white border border-slate-200 rounded-2xl py-4 px-6 text-sm font-bold text-amber-600 outline-none focus:border-amber-400">
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-wider ml-1">Trạng thái *</label>
                        <div class="grid grid-cols-3 gap-2">
                            <label class="cursor-pointer">
                                <input type="radio" name="paymentStatus" value="Unpaid" class="hidden peer" x-model="paymentStatus" @change="paymentStatusLabel = 'Chưa thu'">
                                <div class="py-3 px-1 text-center rounded-2xl border border-slate-100 bg-white text-[9px] font-black uppercase peer-checked:bg-slate-800 peer-checked:text-white transition-all">Chưa thu</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="paymentStatus" value="Deposit" class="hidden peer" x-model="paymentStatus" @change="paymentStatusLabel = 'Đặt cọc'">
                                <div class="py-3 px-1 text-center rounded-2xl border border-slate-100 bg-white text-[9px] font-black uppercase peer-checked:bg-amber-500 peer-checked:text-white transition-all">Đặt cọc</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="paymentStatus" value="Paid" class="hidden peer" x-model="paymentStatus" @change="paymentStatusLabel = 'Đã thu đủ'">
                                <div class="py-3 px-1 text-center rounded-2xl border border-slate-100 bg-white text-[9px] font-black uppercase peer-checked:bg-primary peer-checked:text-white transition-all">Đã thu đủ</div>
                            </label>
                        </div>
                    </div>

                    <div class="bg-slate-900 rounded-3xl p-6 mt-4">
                        <span class="text-[9px] font-black uppercase tracking-widest text-slate-400 block mb-1">Tổng phí sau VAT (10%)</span>
                        <div class="flex justify-between items-end">
                            <h4 class="text-2xl font-black text-white italic" x-text="new Intl.NumberFormat('vi-VN').format(totalPrice)"></h4>
                            <span class="text-primary font-black">VNĐ</span>
                        </div>
                    </div>
                </section>
            </div>

            <!-- STEP 4: CONFIRMATION -->
            <div x-show="step === 4" x-transition.opacity.duration.300ms class="space-y-6" style="display: none;">
                <section class="glass p-8 rounded-[40px] space-y-6 shadow-sm border-slate-200/60 text-center">
                    <div class="size-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-2">
                        <span class="material-symbols-outlined text-3xl">verified</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-black italic uppercase tracking-tight">Xác nhận</h3>
                        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Vui lòng rà soát thông tin</p>
                    </div>

                    <div class="space-y-3 text-left">
                        <div class="bg-white/50 p-4 rounded-3xl border border-slate-100">
                            <p class="text-[9px] font-black text-slate-400 uppercase mb-1">Hội viên & Cơ sở</p>
                            <p class="font-bold text-slate-900" x-text="clientLabel"></p>
                            <p class="text-[10px] text-slate-500 italic" x-text="'Tại: ' + branchLabel"></p>
                        </div>
                        <div class="bg-white/50 p-4 rounded-3xl border border-slate-100">
                            <p class="text-[9px] font-black text-slate-400 uppercase mb-1">Gói dịch vụ</p>
                            <p class="font-bold text-slate-900" x-text="mode === 'template' ? selectedPkgName : customPkgName"></p>
                            <p class="text-[10px] text-primary font-black" x-text="mode === 'template' ? selectedPkgDetails : (customPkgDuration + ' tháng')"></p>
                        </div>
                        <div class="bg-slate-900 p-5 rounded-3xl text-white">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[9px] font-black text-slate-500 uppercase">Thanh toán</span>
                                <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-full" 
                                    :class="paymentStatus === 'Paid' ? 'bg-primary text-white' : 'bg-amber-500 text-white'" x-text="paymentStatusLabel"></span>
                            </div>
                            <p class="text-xl font-black text-primary italic" x-text="new Intl.NumberFormat('vi-VN').format(totalPrice) + ' VNĐ'"></p>
                        </div>
                    </div>
                </section>

                <input type="hidden" name="sales" value="<%= user.id %>">
                <input type="hidden" name="pt" value="<%= user.id %>">

                <button type="submit" class="w-full bg-primary text-white py-6 rounded-[30px] font-black text-lg shadow-2xl shadow-primary/30 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-3">
                    <span class="material-symbols-outlined">contract</span>
                    PHÁT HÀNH NGAY
                </button>
                <a href="/pt" class="w-full flex items-center justify-center gap-2 text-slate-500 text-xs font-bold uppercase tracking-widest py-3 hover:text-slate-900 transition-colors">
                    <span class="material-symbols-outlined text-sm">home</span>
                    Về trang chủ
                </a>
            </div>

            <!-- NAVIGATION BUTTONS -->
            <div class="mt-8 flex gap-4" x-show="step < totalSteps">
                <button type="button" @click="prevStep()" x-show="step > 1" class="flex-1 bg-white border border-slate-200 text-slate-700 py-5 rounded-[24px] font-black text-xs uppercase tracking-widest transition-all">
                    Quay lại
                </button>
                <button type="button" @click="nextStep()" class="flex-[2] bg-slate-900 text-white py-5 rounded-[24px] font-black text-xs uppercase tracking-widest transition-all shadow-lg">
                    Tiếp tục
                </button>
            </div>

        </form>
    </main>

    <%- include('../../partials/nav_pt', { activePage: 'contracts' }) %>
</body>
</html>
