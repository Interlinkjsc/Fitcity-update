<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Chấm công - FitCity PT</title>
    <%- include('../partials/pt-head') %>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32">
<%- include('../partials/flash') %>

<header class="flex justify-between items-start p-8 mb-2">
    <div>
        <h1 class="text-2xl font-black tracking-tighter uppercase italic text-slate-900">Chấm <span class="text-primary">công</span></h1>
        <p class="text-slate-500 text-[10px] font-bold uppercase tracking-widest mt-1">Check-in / Check-out ca dạy</p>
    </div>
    <a href="/pt" class="size-12 glass rounded-2xl flex items-center justify-center hover:bg-white transition-all shadow-sm border border-slate-200" aria-label="Về dashboard">
        <span class="material-symbols-outlined text-slate-500">close</span>
    </a>
</header>

<main class="px-6 space-y-6">
    <% const openEntry = summary.openEntry; %>
    <section class="glass p-8 rounded-[40px] border border-slate-200 shadow-sm relative overflow-hidden">
        <div class="absolute top-0 right-0 size-32 bg-primary/10 rounded-full blur-3xl"></div>
        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-4">Hôm nay</p>
        <% if (openEntry) { %>
            <div class="flex items-center gap-3 mb-6">
                <span class="size-3 rounded-full bg-emerald-500 animate-pulse"></span>
                <p class="text-sm font-bold text-slate-800">Đang trong ca — check-in lúc <%= new Date(openEntry.checkIn).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %></p>
            </div>
            <form action="/pt/attendance/check-out" method="POST">
                <button type="submit" class="w-full py-4 bg-slate-900 text-primary font-black uppercase tracking-widest rounded-2xl text-sm hover:scale-[1.02] transition-transform">
                    Check-out & gửi duyệt
                </button>
            </form>
        <% } else { %>
            <p class="text-sm text-slate-500 mb-6">Chưa có ca đang mở. Bấm check-in khi bắt đầu ca dạy tại chi nhánh.</p>
            <form action="/pt/attendance/check-in" method="POST">
                <button type="submit" class="w-full py-4 bg-primary text-slate-900 font-black uppercase tracking-widest rounded-2xl text-sm hover:scale-[1.02] transition-transform shadow-lg shadow-primary/30">
                    Check-in ca dạy
                </button>
            </form>
        <% } %>
    </section>

    <% if (summary.entries && summary.entries.length) { %>
    <section class="bg-white rounded-[32px] border border-slate-200 p-6">
        <h2 class="text-xs font-black uppercase tracking-widest text-slate-400 mb-4">Ca hôm nay</h2>
        <ul class="space-y-3">
            <% summary.entries.forEach(e => { %>
            <li class="flex justify-between items-center text-sm border-b border-slate-50 pb-2">
                <span><%= new Date(e.checkIn).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
                    <% if (e.checkOut) { %> → <%= new Date(e.checkOut).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %><% } %>
                </span>
                <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full <%= e.status === 'Approved' ? 'bg-emerald-100 text-emerald-700' : e.status === 'Pending_Approval' ? 'bg-amber-100 text-amber-700' : e.status === 'Rejected' ? 'bg-rose-100 text-rose-700' : 'bg-slate-100 text-slate-600' %>"><%= e.status %></span>
            </li>
            <% }) %>
        </ul>
    </section>
    <% } %>

    <section class="bg-white rounded-[32px] border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex flex-wrap justify-between items-center gap-3">
            <h2 class="font-black uppercase tracking-tighter text-sm">Lịch sử tháng <%= month %>/<%= year %></h2>
            <form method="GET" class="flex gap-2 items-center">
                <select name="month" class="text-xs border border-slate-200 rounded-xl py-2 px-2">
                    <% for (let m = 1; m <= 12; m++) { %>
                    <option value="<%= m %>" <%= m === month ? 'selected' : '' %>><%= m %></option>
                    <% } %>
                </select>
                <select name="year" class="text-xs border border-slate-200 rounded-xl py-2 px-2">
                    <% for (let y = 2024; y <= new Date().getFullYear()+5; y++) { %>
                    <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
                    <% } %>
                </select>
                <button type="submit" class="px-3 py-2 bg-slate-900 text-primary text-xs font-bold rounded-xl">Xem</button>
            </form>
        </div>
        <% if (!monthEntries.length) { %>
        <p class="px-6 py-12 text-center text-slate-400 text-sm">Chưa có ca trong tháng này.</p>
        <% } else { %>
        <ul class="divide-y divide-slate-100">
            <% monthEntries.forEach(e => { %>
            <li class="px-6 py-4 flex justify-between items-start gap-4">
                <div>
                    <p class="text-sm font-bold text-slate-800"><%= e.branch ? e.branch.name : '—' %></p>
                    <p class="text-xs text-slate-500 mt-0.5">
                        <%= new Date(e.checkIn).toLocaleDateString('vi-VN') %>
                        <%= new Date(e.checkIn).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
                        <% if (e.checkOut) { %> — <%= new Date(e.checkOut).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %><% } %>
                    </p>
                </div>
                <span class="text-[10px] font-bold uppercase px-2 py-1 rounded-full shrink-0 <%= e.status === 'Approved' ? 'bg-emerald-100 text-emerald-700' : e.status === 'Pending_Approval' ? 'bg-amber-100 text-amber-700' : e.status === 'Rejected' ? 'bg-rose-100 text-rose-700' : 'bg-blue-100 text-blue-700' %>"><%= e.status.replace('_', ' ') %></span>
            </li>
            <% }) %>
        </ul>
        <% } %>
    </section>
</main>

<%- include('../partials/nav_pt', { activePage: 'dashboard' }) %>
</body>
</html>
