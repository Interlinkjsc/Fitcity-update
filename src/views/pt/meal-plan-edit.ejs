<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Chỉnh sửa dinh dưỡng - FitCity PT</title>
    <%- include('../partials/pt-head') %>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32">
<%- include('../partials/flash') %>
<header class="p-8 pb-4">
    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Chỉnh sửa chế độ dinh dưỡng</h1>
    <p class="text-slate-500 text-sm mt-1">
        <a href="/pt/clients" class="text-primary hover:underline font-bold">Quay lại</a> /
        Khách: <span class="font-bold text-slate-700"><%= mealPlan.client ? mealPlan.client.name : 'N/A' %></span>
    </p>
</header>

<main class="px-8 space-y-6">
<div class="glass rounded-xl overflow-hidden shadow-sm max-w-2xl">
    <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/50">
        <h3 class="font-bold text-slate-900 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">restaurant</span>
            Mục tiêu & Dinh dưỡng
        </h3>
    </div>

    <form action="/pt/meal-plan/<%= mealPlan._id %>/update" method="POST" class="p-6 md:p-8 space-y-6">
        
        <!-- Mục tiêu tập -->
        <div>
            <label for="goal" class="block text-sm font-bold text-slate-700 mb-1">Mục tiêu tập luyện <span class="text-red-500">*</span></label>
            <select id="goal" name="goal" required
                class="block w-full rounded-lg border-slate-200 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm py-2 px-3 bg-white text-slate-900 font-medium">
                <option value="Weight Loss" <%= mealPlan.goal === 'Weight Loss' ? 'selected' : '' %>>Giảm cân (Weight Loss)</option>
                <option value="Muscle Gain" <%= mealPlan.goal === 'Muscle Gain' ? 'selected' : '' %>>Tăng cơ (Muscle Gain)</option>
                <option value="Maintenance" <%= mealPlan.goal === 'Maintenance' ? 'selected' : '' %>>Duy trì (Maintenance)</option>
                <option value="Endurance" <%= mealPlan.goal === 'Endurance' ? 'selected' : '' %>>Sức bền (Endurance)</option>
            </select>
        </div>

        <!-- Calories mỗi ngày -->
        <div>
            <label for="dailyCalories" class="block text-sm font-bold text-slate-700 mb-1">Calories/ngày</label>
            <div class="relative">
                <input type="number" id="dailyCalories" name="dailyCalories" min="800" max="5000"
                    value="<%= mealPlan.dailyCalories || 2000 %>"
                    class="block w-full rounded-lg border-slate-200 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm py-2 pl-3 pr-16 bg-white text-slate-900 font-medium">
                <span class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-500 font-bold text-sm">kcal</span>
            </div>
        </div>

        <!-- Macros -->
        <div>
            <h4 class="text-sm font-bold text-slate-900 mb-3">Tỷ lệ dinh dưỡng (%)</h4>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-1">Đạm (Protein)</label>
                    <input type="number" name="protein" min="0" max="100"
                        value="<%= mealPlan.macros ? mealPlan.macros.protein : 30 %>"
                        class="block w-full rounded-lg border-slate-200 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm py-2 px-3 text-center font-bold bg-white text-slate-900">
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-1">Tinh bột (Carbs)</label>
                    <input type="number" name="carbs" min="0" max="100"
                        value="<%= mealPlan.macros ? mealPlan.macros.carbs : 35 %>"
                        class="block w-full rounded-lg border-slate-200 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm py-2 px-3 text-center font-bold bg-white text-slate-900">
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-1">Béo (Fat)</label>
                    <input type="number" name="fat" min="0" max="100"
                        value="<%= mealPlan.macros ? mealPlan.macros.fat : 25 %>"
                        class="block w-full rounded-lg border-slate-200 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm py-2 px-3 text-center font-bold bg-white text-slate-900">
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-1">Chất xơ (Fiber)</label>
                    <input type="number" name="fiber" min="0" max="100"
                        value="<%= mealPlan.macros ? (mealPlan.macros.fiber || 10) : 10 %>"
                        class="block w-full rounded-lg border-slate-200 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm py-2 px-3 text-center font-bold bg-white text-slate-900">
                </div>
            </div>
            <p class="text-[10px] font-medium text-slate-500 mt-2">* Tổng tỷ lệ nên bằng 100%</p>
        </div>

        <div class="flex justify-end gap-3 pt-6 border-t border-slate-200">
            <a href="/pt/clients" class="px-5 py-2.5 text-sm font-bold rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors">Hủy</a>
            <button type="submit" class="px-5 py-2.5 text-sm font-bold rounded-xl bg-primary text-white shadow-lg shadow-primary/20 hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-primary/60 transition-all active:scale-95 uppercase tracking-widest">
                Lưu thay đổi
            </button>
        </div>
    </form>
</div>
</main>
<%- include('../partials/nav_pt', { activePage: 'meal-plans' }) %>
</body>
</html>
