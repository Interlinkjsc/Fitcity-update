<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/pt-head', { title: 'Theo dõi nhật ký ăn uống - FitCity PT' }) %>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32">
    <%- include('../partials/flash') %>

    <main class="max-w-5xl mx-auto px-4 py-8">
        <!-- Back link -->
        <a href="/pt/clients" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-800 mb-6 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Danh sách khách hàng
        </a>

        <!-- Client header -->
        <div class="flex items-center gap-4 mb-6">
            <% if (client && client.avatar) { %>
            <img src="<%= client.avatar %>" class="w-14 h-14 rounded-full object-cover border-2 border-emerald-300" alt="">
            <% } else { %>
            <div class="w-14 h-14 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-black text-2xl border-2 border-emerald-200">
                <%= client ? client.name.charAt(0).toUpperCase() : '?' %>
            </div>
            <% } %>
            <div>
                <h1 class="text-2xl font-black text-slate-800"><%= client ? client.name : 'Khách hàng' %></h1>
                <p class="text-sm text-slate-500">Nhật ký ăn uống · <%= days %> ngày gần nhất</p>
            </div>
        </div>

        <!-- Active meal plan -->
        <% if (activeMealPlan) { %>
        <div class="bg-white rounded-2xl border border-indigo-200 p-4 mb-6 flex items-center gap-4 shadow-sm">
            <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
            </div>
            <div>
                <p class="text-xs font-black text-indigo-500 uppercase tracking-widest">Kế hoạch đang áp dụng</p>
                <p class="font-bold text-slate-800 text-sm"><%= activeMealPlan.goal %> · <%= activeMealPlan.dailyCalories ? activeMealPlan.dailyCalories.toLocaleString('vi-VN') + ' kcal/ngày' : '' %></p>
            </div>
        </div>
        <% } %>

        <!-- Compliance summary -->
        <% if (logs && logs.length > 0) {
            const followed = logs.filter(l => l.compliance === 'Followed').length;
            const partial  = logs.filter(l => l.compliance === 'Partial').length;
            const skipped  = logs.filter(l => l.compliance === 'Skipped').length;
            const total = logs.length;
        %>
        <div class="grid grid-cols-3 gap-4 mb-6">
            <div class="bg-white rounded-2xl border border-emerald-200 p-4 text-center shadow-sm">
                <p class="text-3xl font-black text-emerald-600"><%= followed %></p>
                <p class="text-xs font-semibold text-emerald-500 uppercase tracking-wider mt-1">Đúng kế hoạch</p>
                <div class="mt-2 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full transition-all" style="width: <%= total > 0 ? Math.round(followed/total*100) : 0 %>%"></div>
                </div>
                <p class="text-xs text-slate-400 mt-1"><%= total > 0 ? Math.round(followed/total*100) : 0 %>%</p>
            </div>
            <div class="bg-white rounded-2xl border border-amber-200 p-4 text-center shadow-sm">
                <p class="text-3xl font-black text-amber-600"><%= partial %></p>
                <p class="text-xs font-semibold text-amber-500 uppercase tracking-wider mt-1">Một phần</p>
                <div class="mt-2 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-amber-400 rounded-full transition-all" style="width: <%= total > 0 ? Math.round(partial/total*100) : 0 %>%"></div>
                </div>
                <p class="text-xs text-slate-400 mt-1"><%= total > 0 ? Math.round(partial/total*100) : 0 %>%</p>
            </div>
            <div class="bg-white rounded-2xl border border-red-200 p-4 text-center shadow-sm">
                <p class="text-3xl font-black text-red-600"><%= skipped %></p>
                <p class="text-xs font-semibold text-red-500 uppercase tracking-wider mt-1">Bỏ bữa</p>
                <div class="mt-2 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-red-500 rounded-full transition-all" style="width: <%= total > 0 ? Math.round(skipped/total*100) : 0 %>%"></div>
                </div>
                <p class="text-xs text-slate-400 mt-1"><%= total > 0 ? Math.round(skipped/total*100) : 0 %>%</p>
            </div>
        </div>
        <% } %>

        <!-- Filter -->
        <div class="flex items-center gap-3 mb-4">
            <span class="text-sm font-semibold text-slate-600">Lọc:</span>
            <% [7, 14].forEach(d => { %>
            <a href="?days=<%= d %>"
               class="px-4 py-1.5 rounded-full text-xs font-bold border transition-colors <%= days === d ? 'bg-slate-800 text-white border-slate-800' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
                <%= d %> ngày
            </a>
            <% }) %>
        </div>

        <!-- Log table -->
        <% if (!logs || logs.length === 0) { %>
        <div class="flex flex-col items-center justify-center py-16 text-slate-400 bg-white rounded-2xl border border-slate-200">
            <svg class="w-12 h-12 mb-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <p class="text-base font-semibold">Chưa có nhật ký nào trong <%= days %> ngày qua</p>
        </div>
        <% } else { %>
        <%
            const csStyle = {
                Followed: 'bg-emerald-100 text-emerald-700',
                Partial:  'bg-amber-100 text-amber-700',
                Skipped:  'bg-red-100 text-red-600'
            };
            const csLabel = {
                Followed: 'Đúng KH',
                Partial:  'Một phần',
                Skipped:  'Bỏ bữa'
            };
        %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Ngày</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Bữa ăn</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Mô tả</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Calories</th>
                            <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Compliance</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% logs.forEach(log => { %>
                        <%
                            const lcs = log.compliance || '';
                            const lcsClass = csStyle[lcs] || 'bg-slate-100 text-slate-500';
                            const lcsLabel = csLabel[lcs] || lcs || '—';
                        %>
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 font-medium text-slate-600 whitespace-nowrap">
                                <%= log.logDate ? new Date(log.logDate).toLocaleDateString('vi-VN') : '—' %>
                            </td>
                            <td class="px-4 py-3 font-semibold text-slate-700"><%= log.mealType || '—' %></td>
                            <td class="px-4 py-3 text-slate-500 max-w-[180px] truncate" title="<%= log.description || '' %>">
                                <%= log.description || '—' %>
                            </td>
                            <td class="px-4 py-3 text-right font-bold text-slate-700">
                                <%= log.calories ? log.calories.toLocaleString('vi-VN') + ' kcal' : '—' %>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-bold <%= lcsClass %>">
                                    <%= lcsLabel %>
                                </span>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>
    </main>

    <%- include('../partials/nav_pt', { activePage: 'meal-plans' }) %>
</body>
</html>
