<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../../partials/pt-head', { title: 'Danh sách Thực đơn - FitCity PT' }) %>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32">
    <header class="p-6 pb-3 flex justify-between items-center">
        <div>
            <h1 class="screen-title">Kế hoạch <span class="text-primary tracking-normal">Dinh dưỡng</span></h1>
            <p class="text-slate-500 text-sm mt-2">Quản lý phác đồ ăn uống cho các hội viên của bạn.</p>
        </div>
        <a href="/pt/meal-plans/create" class="size-12 bg-primary rounded-2xl flex items-center justify-center text-white shadow-lg shadow-primary/20 hover:scale-105 transition-all">
            <span class="material-symbols-outlined font-bold">add</span>
        </a>
    </header>

    <main class="px-6 space-y-6">
        <% if (success_msg && success_msg.length > 0) { %>
            <div class="bg-primary/10 border border-primary/20 text-primary px-6 py-4 rounded-2xl flex items-center gap-3">
                <span class="material-symbols-outlined">check_circle</span>
                <span class="text-sm font-bold uppercase tracking-wider"><%= success_msg %></span>
            </div>
        <% } %>

        <div class="grid grid-cols-1 gap-4">
            <% mealPlans.forEach(plan => { %>
                <div class="glass p-6 rounded-[32px] group hover:border-primary/30 transition-all shadow-sm">
                    <div class="flex items-center gap-4 mb-6">
                        <img src="<%= plan.client.avatar || '/images/default-avatar-client.svg' %>" class="w-14 h-14 rounded-2xl object-cover border border-slate-200">
                        <div class="flex-1">
                            <h3 class="font-bold text-lg text-slate-900"><%= plan.client.name %></h3>
                            <div class="flex gap-2 mt-1">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-primary text-white uppercase">
                                    <%= plan.goal %>
                                </span>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-2xl font-black text-primary"><%= plan.dailyCalories %></p>
                            <p class="text-[10px] text-slate-500 uppercase font-bold tracking-widest">Kcal / Ngày</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-4 gap-3 mb-6">
                        <div class="bg-slate-50 p-3 rounded-2xl border border-slate-200">
                            <p class="text-[10px] text-slate-500 font-bold uppercase mb-1">🥩 Đạm</p>
                            <div class="flex items-end gap-1">
                                <span class="text-lg font-bold text-slate-900"><%= plan.macros.protein %></span><span class="text-xs text-slate-500 mb-1">%</span>
                            </div>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-2xl border border-slate-200">
                            <p class="text-[10px] text-slate-500 font-bold uppercase mb-1">🍚 T.Bột</p>
                            <div class="flex items-end gap-1">
                                <span class="text-lg font-bold text-slate-900"><%= plan.macros.carbs %></span><span class="text-xs text-slate-500 mb-1">%</span>
                            </div>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-2xl border border-slate-200">
                            <p class="text-[10px] text-slate-500 font-bold uppercase mb-1">🧈 Béo</p>
                            <div class="flex items-end gap-1">
                                <span class="text-lg font-bold text-slate-900"><%= plan.macros.fat %></span><span class="text-xs text-slate-500 mb-1">%</span>
                            </div>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-2xl border border-slate-200">
                            <p class="text-[10px] text-slate-500 font-bold uppercase mb-1">🥬 Xơ</p>
                            <div class="flex items-end gap-1">
                                <span class="text-lg font-bold text-slate-900"><%= plan.macros.fiber || 10 %></span><span class="text-xs text-slate-500 mb-1">%</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-between items-center bg-slate-50 p-4 rounded-2xl border border-slate-100">
                        <div class="flex items-center gap-2 text-slate-500">
                            <span class="material-symbols-outlined text-sm">schedule</span>
                            <span class="text-[10px] font-bold uppercase tracking-widest">
                                Có hiệu lực đến: <%= new Date(plan.endDate).toLocaleDateString('vi-VN') %>
                            </span>
                        </div>
                        <a href="/pt/meal-plans/<%= plan._id %>" class="text-[10px] font-black text-primary uppercase tracking-tighter hover:underline mr-2">Chi tiết</a>
                        <a href="/pt/meal-plan/<%= plan._id %>/edit" class="text-[10px] font-black text-slate-500 uppercase tracking-tighter hover:underline">
                            Chi tiết & Lịch trình
                        </a>
                    </div>
                </div>
            <% }) %>

            <% if (mealPlans.length === 0) { %>
                <div class="py-20 text-center glass rounded-3xl border border-dashed border-slate-300">
                    <span class="material-symbols-outlined text-4xl text-slate-400 mb-3">restaurant</span>
                    <p class="text-slate-500 text-sm italic tracking-tight">Chưa có phác đồ dinh dưỡng nào cho hội viên của bạn.</p>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../../partials/nav_pt', { activePage: 'meal-plans' }) %>
</body>
</html>
