<%# Expects: pt (object with _id, name), optional contract %>
<div id="ptChangeOverlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] opacity-0 pointer-events-none transition-opacity duration-300" onclick="closePtChangeModal()"></div>
<div id="ptChangeModal" class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white rounded-t-[36px] z-[110] transform translate-y-full transition-transform duration-300 shadow-[0_-10px_40px_rgba(0,0,0,0.12)] px-6 pt-6 pb-10">
    <div class="flex justify-between items-start mb-4">
        <div>
            <h2 class="text-xl font-black italic tracking-tighter uppercase text-slate-900">Đổi <span class="text-primary">PT</span></h2>
            <p class="text-[10px] text-slate-500 font-bold uppercase tracking-widest mt-1">HLV hiện tại: <%= pt.name %></p>
        </div>
        <button type="button" onclick="closePtChangeModal()" class="w-10 h-10 bg-slate-100 rounded-full flex items-center justify-center text-slate-500">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>
    <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Lý do thay đổi *</label>
    <textarea id="ptChangeReason" rows="4" class="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm resize-none focus:ring-2 focus:ring-primary/40 outline-none" placeholder="VD: Lịch không phù hợp, muốn đổi chuyên môn..."></textarea>
    <button type="button" id="ptChangeSubmitBtn" onclick="submitPtChangeRequest('<%= pt._id %>')" class="w-full mt-4 py-4 bg-primary text-white font-black uppercase rounded-2xl text-[10px] tracking-widest hover:brightness-110 transition-all">
        Gửi yêu cầu đổi PT
    </button>
    <p class="text-[10px] text-slate-400 text-center mt-3">Quản lý sẽ xem xét và phản hồi qua thông báo.</p>
</div>
<script>
    function openPtChangeModal() {
        const o = document.getElementById('ptChangeOverlay');
        const m = document.getElementById('ptChangeModal');
        if (!o || !m) return;
        o.classList.remove('opacity-0', 'pointer-events-none');
        m.classList.remove('translate-y-full');
    }
    function closePtChangeModal() {
        const o = document.getElementById('ptChangeOverlay');
        const m = document.getElementById('ptChangeModal');
        if (!o || !m) return;
        o.classList.add('opacity-0', 'pointer-events-none');
        m.classList.add('translate-y-full');
    }
    async function submitPtChangeRequest(currentPTId) {
        const reason = (document.getElementById('ptChangeReason')?.value || '').trim();
        if (!reason) { alert('Vui lòng nhập lý do thay đổi.'); return; }
        const btn = document.getElementById('ptChangeSubmitBtn');
        if (btn) { btn.disabled = true; btn.textContent = 'Đang gửi...'; }
        try {
            const res = await fetch('/client/pt-change-request', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ currentPTId, reason })
            });
            const data = await res.json();
            if (data.success) {
                alert(data.message || 'Đã gửi yêu cầu.');
                closePtChangeModal();
            } else {
                alert(data.message || 'Không gửi được yêu cầu.');
            }
        } catch (e) {
            alert('Lỗi kết nối.');
        } finally {
            if (btn) { btn.disabled = false; btn.textContent = 'Gửi yêu cầu đổi PT'; }
        }
    }
</script>
