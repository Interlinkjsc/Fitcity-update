<div id="clientMoreOverlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] opacity-0 pointer-events-none transition-opacity duration-200" onclick="closeClientMoreMenu()" aria-hidden="true"></div>

<div id="clientMoreSheet" class="fixed bottom-0 left-0 right-0 max-w-lg mx-auto bg-white rounded-t-[36px] z-[110] transform translate-y-full transition-transform duration-200 shadow-[0_-10px_40px_rgba(0,0,0,0.12)] px-6 pt-6 pb-8">
    <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
            <h3 class="text-sm font-black uppercase tracking-widest text-slate-500">Menu</h3>
            <p class="text-xs text-slate-500 mt-1">Các mục bổ sung & tài khoản</p>
        </div>
        <button type="button" class="w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 transition-all flex items-center justify-center text-slate-600" onclick="closeClientMoreMenu()" aria-label="Đóng menu">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>

    <div class="mt-5 grid grid-cols-2 gap-3">
        <a href="/client/contracts" class="glass rounded-2xl border border-slate-100 p-4 hover:bg-slate-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-slate-900/5 text-slate-700 flex items-center justify-center">
                    <span class="material-symbols-outlined">description</span>
                </div>
                <div class="min-w-0">
                    <p class="text-xs font-black text-slate-900 uppercase tracking-widest">Hợp đồng</p>
                    <p class="text-[10px] text-slate-500 mt-0.5">Gói tập & hóa đơn</p>
                </div>
            </div>
        </a>

        <a href="/client/rewards" class="glass rounded-2xl border border-slate-100 p-4 hover:bg-slate-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center">
                    <span class="material-symbols-outlined">redeem</span>
                </div>
                <div class="min-w-0">
                    <p class="text-xs font-black text-slate-900 uppercase tracking-widest">Ưu đãi</p>
                    <p class="text-[10px] text-slate-500 mt-0.5">Voucher của bạn</p>
                </div>
            </div>
        </a>

        <a href="/auth/profile" class="glass rounded-2xl border border-slate-100 p-4 hover:bg-slate-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div class="min-w-0">
                    <p class="text-xs font-black text-slate-900 uppercase tracking-widest">Hồ sơ</p>
                    <p class="text-[10px] text-slate-500 mt-0.5">Thông tin cá nhân</p>
                </div>
            </div>
        </a>

        <a href="/client/nutrition" class="glass rounded-2xl border border-slate-100 p-4 hover:bg-slate-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center">
                    <span class="material-symbols-outlined">restaurant</span>
                </div>
                <div class="min-w-0">
                    <p class="text-xs font-black text-slate-900 uppercase tracking-widest">Ăn uống</p>
                    <p class="text-[10px] text-slate-500 mt-0.5">Dinh dưỡng</p>
                </div>
            </div>
        </a>

        <a href="/client/progress" class="glass rounded-2xl border border-slate-100 p-4 hover:bg-slate-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-sky-500/10 text-sky-600 flex items-center justify-center">
                    <span class="material-symbols-outlined">monitoring</span>
                </div>
                <div class="min-w-0">
                    <p class="text-xs font-black text-slate-900 uppercase tracking-widest">Tiến độ</p>
                    <p class="text-[10px] text-slate-500 mt-0.5">Theo dõi</p>
                </div>
            </div>
        </a>

        <form action="/auth/logout" method="POST" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn đăng xuất?');">
            <button type="submit" class="w-full glass rounded-2xl border border-rose-200 p-4 hover:bg-rose-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500/60 text-left">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-rose-500/10 text-rose-600 flex items-center justify-center">
                        <span class="material-symbols-outlined">logout</span>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-black text-slate-900 uppercase tracking-widest">Đăng xuất</p>
                        <p class="text-[10px] text-slate-500 mt-0.5">Thoát tài khoản</p>
                    </div>
                </div>
            </button>
        </form>
    </div>
</div>

<script>
    function openClientMoreMenu() {
        const overlay = document.getElementById('clientMoreOverlay');
        const sheet = document.getElementById('clientMoreSheet');
        if (!overlay || !sheet) return;
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100');
        sheet.classList.remove('translate-y-full');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
    }
    function closeClientMoreMenu() {
        const overlay = document.getElementById('clientMoreOverlay');
        const sheet = document.getElementById('clientMoreSheet');
        if (!overlay || !sheet) return;
        overlay.classList.remove('opacity-100');
        overlay.classList.add('opacity-0', 'pointer-events-none');
        sheet.classList.add('translate-y-full');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    }
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeClientMoreMenu();
    });
</script>

