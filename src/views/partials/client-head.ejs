<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<script>
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                colors: {
                    "primary": "#16A34A",
                    "accent": "#F97316",
                    "background-light": "#F8FAF7",
                },
                fontFamily: {
                    "display": ["Inter", "sans-serif"]
                },
                borderRadius: {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "2xl": "1rem",
                    "full": "9999px"
                },
            },
        },
    }
</script>
<%- include('./theme-light') %>
<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #F8FAF7;
        color: #0F172A;
    }
    .glass {
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    }
    .card-glow {
        box-shadow: 0 0 24px rgba(22, 163, 74, 0.08);
    }
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
</style>

    <!-- Socket.io Client -->
    <script src="/socket.io/socket.io.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const socket = io();
        <% if (typeof user !== 'undefined' && user && user._id) { %>
            socket.emit('identify', { userId: '<%= user._id %>', role: '<%= user.role || 'Client' %>' });
        <% } %>

        // Realtime notifications
        socket.on('notification', (data) => {
            // Show a premium toast
            Swal.fire({
                title: data.title,
                text: data.message,
                icon: data.type.toLowerCase() === 'success' ? 'success' : (data.type.toLowerCase() === 'danger' ? 'error' : 'info'),
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 5000,
                timerProgressBar: true,
                background: '#ffffff',
                color: '#0f172a',
                iconColor: data.type.toLowerCase() === 'success' ? '#16A34A' : '#F97316'
            });

            // Trigger unread count refresh if the function exists (it's in dashboard.ejs)
            if (typeof fetchUnreadCount === 'function') {
                fetchUnreadCount();
            }
            
            // If drawer is open, refresh the list
            const drawer = document.getElementById('notiDrawer');
            if (drawer && !drawer.classList.contains('translate-x-full')) {
                 if (typeof openNotifications === 'function') {
                    openNotifications();
                 }
            }
        });
    </script>
