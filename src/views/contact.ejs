<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liên hệ - FitCity</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = { theme: { extend: { colors: { primary: '#16A34A' } } } }
    </script>
    <style>body { font-family: 'Inter', sans-serif; background: #F8FAF7; }</style>
</head>
<body>
    <nav class="px-6 py-4 flex justify-between items-center bg-white border-b border-slate-200">
        <a href="/" class="text-xl font-black text-primary">FITCITY</a>
        <div>
            <a href="/blog" class="text-sm font-semibold text-slate-600 hover:text-primary mr-4">Blog</a>
            <a href="/" class="text-sm font-semibold text-slate-600 hover:text-primary">Trang chủ</a>
        </div>
    </nav>

    <main class="max-w-xl mx-auto px-6 py-16">
        <h1 class="text-3xl font-black text-slate-900 mb-2">Liên hệ FitCity</h1>
        <p class="text-slate-600 mb-8">Gửi câu hỏi hoặc yêu cầu tư vấn — đội ngũ sẽ phản hồi trong 24h.</p>

        <% if (typeof success_msg !== 'undefined' && success_msg.length) { %>
        <div class="mb-6 p-4 bg-primary/10 border border-primary/20 rounded-xl text-primary text-sm font-bold"><%= success_msg %></div>
        <% } %>
        <% if (typeof error_msg !== 'undefined' && error_msg.length) { %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm font-bold"><%= error_msg %></div>
        <% } %>

        <form action="/register-lead" method="POST" class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm space-y-4">
            <input type="hidden" name="source" value="Contact">
            <input type="hidden" name="redirectTo" value="/contact">
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Họ tên</label>
                <input type="text" name="name" required class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">SĐT</label>
                    <input type="tel" name="phone" required class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Email</label>
                    <input type="email" name="email" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm">
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Chi nhánh</label>
                <select name="branchId" required class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm">
                    <% (branches || []).forEach(b => { %>
                    <option value="<%= b._id %>"><%= b.name %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Gói quan tâm</label>
                <select name="interestedPackage" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm">
                    <option value="Gym">Gym</option>
                    <option value="Pilates">Pilates</option>
                    <option value="PT">PT</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nội dung</label>
                <textarea name="notes" rows="4" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm"></textarea>
            </div>
            <button type="submit" class="w-full py-4 bg-primary text-white font-black rounded-xl uppercase tracking-tight">Gửi liên hệ</button>
        </form>
    </main>
</body>
</html>
