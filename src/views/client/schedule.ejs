<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Lịch buổi tập - FitCity</title>
    <%- include('../partials/client-head') %>
    
    <!-- FullCalendar JS & CSS -->
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js'></script>
    
    <style>
        /* Custom FullCalendar styling using Tailwind colors */
        :root {
            --fc-border-color: #E5E7EB;
            --fc-daygrid-event-dot-width: 8px;
            --fc-event-bg-color: #16A34A;
            --fc-event-border-color: #16A34A;
            --fc-today-bg-color: rgba(22, 163, 74, 0.05);
            --fc-page-bg-color: #FFFFFF;
            --fc-neutral-bg-color: #F8FAF7;
            --fc-neutral-text-color: #64748B;
        }
        
        #calendar {
            min-height: 500px;
            width: 100%;
            font-family: 'Inter', sans-serif;
        }
        
        /* Mobile-first toolbar layout */
        .fc .fc-toolbar.fc-header-toolbar {
            margin-bottom: 12px !important;
            gap: 8px;
            flex-wrap: wrap;
        }
        .fc .fc-toolbar-chunk {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        /* Bug 3.4/4.1 (2/7): event tràn ra ngoài ô ngày trên mobile — ép nằm gọn trong ô */
        .fc-daygrid-day-events { overflow: hidden; }
        .fc-daygrid-event, .fc-daygrid-event .fc-event-title, .fc-daygrid-event .fc-event-time {
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; max-width: 100%;
        }
        .fc-daygrid-event-harness { max-width: 100%; }
        .fc .fc-daygrid-more-link { font-size: 10px; font-weight: 700; }
        @media (max-width: 640px) {
            .fc-daygrid-event .fc-event-time, .fc-daygrid-event .fc-event-title { font-size: 9px; }
            .fc-daygrid-event { padding: 0 1px; }
        }
        .fc-toolbar-title {
            font-size: 1.25rem !important;
            font-weight: 800 !important;
            text-transform: capitalize;
            color: #0F172A;
            letter-spacing: -0.02em;
        }
        
        .fc-button-primary {
            background-color: #16A34A !important;
            border-color: #16A34A !important;
            text-transform: capitalize !important;
            border-radius: 0.5rem !important;
            font-weight: 600 !important;
        }
        .fc .fc-button {
            padding: 0.35rem 0.55rem !important;
            font-size: 0.75rem !important;
            line-height: 1 !important;
        }
        .fc .fc-button .fc-icon {
            font-size: 1rem !important;
        }

        @media (max-width: 480px) {
            .fc-toolbar-title {
                font-size: 1rem !important;
            }
            .fc .fc-button {
                padding: 0.3rem 0.5rem !important;
                font-size: 0.7rem !important;
            }
        }
        .fc-button-primary:not(:disabled):active, .fc-button-primary:not(:disabled).fc-button-active {
            background-color: #15803D !important;
            border-color: #15803D !important;
        }
        .fc-button-primary:disabled {
            background-color: #86EFAC !important;
            border-color: #86EFAC !important;
        }
        
        .fc-event {
            border-radius: 6px !important;
            padding: 2px 4px !important;
            font-size: 0.75rem !important;
            border: none !important;
            cursor: pointer;
            transition: transform 0.1s ease-in-out;
        }
        .fc-event:hover {
            transform: scale(1.02);
            filter: brightness(1.05);
        }
        
        .fc-event-title, .fc-event-time {
            font-weight: 700 !important;
        }
        
        /* Modal background */
        #eventModal {
            display: none;
            backdrop-filter: blur(4px);
            background-color: rgba(0,0,0,0.4);
        }
        #eventModal.active {
            display: flex;
        }
    </style>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32">
    <header class="px-6 md:px-12 pt-6 md:pt-12 pb-3 mb-4">
        <h1 class="text-4xl font-black italic tracking-tighter uppercase leading-none"><span class="text-primary tracking-normal">LỊCH</span> BUỔI TẬP</h1>
        <p class="text-slate-500 text-sm mt-2">Đặt lịch, xem lịch sử buổi tập với huấn luyện viên.</p>
    </header>

    <% if (typeof pt !== 'undefined' && pt) { %>
    <section class="px-6 md:px-12 mb-4">
        <div class="bg-white border border-slate-200 rounded-[28px] p-5 flex items-center gap-4 shadow-sm">
            <img src="<%= pt.avatar || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(pt.name || 'PT')) %>" alt="" class="w-14 h-14 rounded-2xl object-cover border border-slate-200">
            <div class="flex-1 min-w-0">
                <p class="text-[10px] font-black uppercase tracking-widest text-slate-500">Huấn luyện viên</p>
                <p class="font-black text-slate-900 truncate"><%= pt.name %></p>
            </div>
            <button type="button" onclick="openPtChangeModal()" class="shrink-0 px-4 py-2.5 rounded-xl border border-slate-200 text-[10px] font-black uppercase tracking-widest text-slate-600 hover:border-primary hover:text-primary transition-all">
                Đổi PT
            </button>
        </div>
    </section>
    <% } %>

    <main class="px-6 md:px-12 relative space-y-6">
        <section class="bg-white/90 backdrop-blur-xl border border-slate-200 rounded-[28px] p-2 shadow-sm">
            <div class="grid grid-cols-2 gap-2">
                <button type="button" class="schedule-tab px-4 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest bg-primary text-white" data-target="tab-calendar">
                    Lịch
                </button>
                <button type="button" class="schedule-tab px-4 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest bg-white text-slate-600 border border-slate-200" data-target="tab-history">
                    Lịch sử buổi
                </button>
            </div>
        </section>

        <section id="tab-calendar">
            <div class="bg-white border border-slate-200 rounded-[32px] p-4 md:p-6 mb-2 overflow-hidden shadow-sm">
                <!-- Simple view switcher (replaces FullCalendar right toolbar) -->
                <div class="flex items-center justify-between gap-3 mb-4 relative z-10">
                    <div class="bg-slate-50 border border-slate-200 rounded-full p-1 flex items-center gap-1">
                        <button type="button" id="viewMonthBtn" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-primary text-white">
                            Tháng
                        </button>
                        <button type="button" id="viewWeekBtn" class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-transparent text-slate-600">
                            Tuần
                        </button>
                    </div>
                    <button type="button" id="todayBtn" onclick="goToday()" class="px-3 py-2 rounded-2xl text-[10px] font-black uppercase tracking-widest bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">
                        Hôm nay
                    </button>
                </div>

                <div class="mb-4 rounded-2xl border border-slate-100 bg-slate-50/80 px-3 py-3" role="note" aria-label="Chú thích màu trạng thái buổi tập">
                    <p class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-2">Màu trạng thái trên lịch</p>
                    <div class="flex flex-wrap gap-x-3 gap-y-2">
                        <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-black/5" style="background:#3788d8"></span>Đã lên lịch
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-black/5" style="background:#f59e0b"></span>Chờ PT duyệt hủy
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-black/5" style="background:#f39c12"></span>Đang tập
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-black/5" style="background:#2ecc71"></span>Hoàn thành
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-black/5" style="background:#10b981"></span>Đã xác nhận
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-black/5" style="background:#e74c3c"></span>Đã hủy
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-black/5" style="background:#95a5a6"></span>Vắng mặt
                        </span>
                    </div>
                </div>

                <div id='calendar'></div>
            </div>
        </section>

        <section id="tab-history" class="hidden">
            <div class="space-y-3">
                <%
                    const getSessionSortTime = (session) => {
                        if (session.endTime) return new Date(session.endTime).getTime();
                        if (session.startTime) return new Date(session.startTime).getTime();
                        return new Date(session.scheduledTime).getTime();
                    };
                    const pastSorted = (pastSessions || []).slice().sort((a, b) => getSessionSortTime(b) - getSessionSortTime(a));
                    const initialHistoryCount = 8;
                %>

                <% if (pastSorted.length > 0) { %>
                    <% pastSorted.forEach((session, idx) => { %>
                        <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm schedule-history-item <%= idx >= initialHistoryCount ? 'hidden' : '' %>">
                            <div class="flex items-start justify-between gap-4">
                                <div class="min-w-0">
                                    <h4 class="text-base font-black text-slate-900 truncate"><%= session.workoutPlan || 'Giáo án định kỳ' %></h4>
                                    <p class="text-[10px] text-slate-500 font-bold uppercase tracking-widest mt-1">
                                        <span class="material-symbols-outlined text-[12px] align-middle">schedule</span>
                                        <% const histAt = session.endTime || session.startTime || session.scheduledTime; %>
                                        <%= new Date(histAt).toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }) %>
                                    </p>
                                </div>
                                <%
                                    const histStatusClass = {
                                        Pending_Admin: 'bg-amber-100 text-amber-700',
                                        Scheduled: 'bg-blue-100 text-blue-700',
                                        Cancel_Requested: 'bg-amber-100 text-amber-700',
                                        In_Progress: 'bg-orange-500/20 text-orange-700',
                                        Completed: 'bg-primary/20 text-primary',
                                        Confirmed: 'bg-emerald-100 text-emerald-700',
                                        Cancelled: 'bg-red-500/20 text-red-600',
                                        No_Show: 'bg-slate-300 text-slate-700'
                                    };
                                    const histStatusLabel = {
                                        Pending_Admin: 'Chờ duyệt',
                                        Scheduled: 'Đã lên lịch',
                                        In_Progress: 'Đang tập',
                                        Completed: 'Hoàn thành',
                                        Confirmed: 'Đã xác nhận',
                                        Cancel_Requested: 'Chờ PT duyệt hủy',
                                        Cancelled: 'Đã hủy',
                                        No_Show: 'Vắng mặt'
                                    };
                                    const hst = session.status || '';
                                %>
                                <span class="shrink-0 px-3 py-1 <%= histStatusClass[hst] || 'bg-slate-200 text-slate-500' %> text-[10px] font-black rounded-full uppercase">
                                    <%= histStatusLabel[hst] || hst || 'Khác' %>
                                </span>
                            </div>
                            <% if (hst === 'Pending_Admin') { %>
                                <p class="text-xs text-amber-600 mt-1.5 flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    Lịch tập này đang chờ Admin phê duyệt.
                                </p>
                            <% } %>

                            <% if (session.notes) { %>
                                <div class="bg-slate-50 rounded-2xl p-4 mt-3">
                                    <p class="text-[10px] font-black text-slate-400 tracking-widest uppercase mb-1">Ghi chú từ PT</p>
                                    <p class="text-sm font-medium text-slate-700 whitespace-pre-wrap"><%= session.notes %></p>
                                </div>
                            <% } else { %>
                                <div class="bg-slate-50 rounded-2xl p-4 mt-3">
                                    <p class="text-xs italic text-slate-400">PT chưa để lại ghi chú cho buổi tập này.</p>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>

                    <% if (pastSorted.length > initialHistoryCount) { %>
                        <button type="button" id="scheduleHistoryLoadMore" class="w-full bg-white rounded-3xl border border-slate-200 px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-600 hover:text-primary hover:border-primary/30 transition-all shadow-sm">
                            Xem thêm lịch sử
                        </button>
                    <% } %>
                <% } else { %>
                    <p class="text-sm text-slate-500 font-medium">Bạn chưa có lịch sử tập luyện nào.</p>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Modal Xem Chi Tiết Sự Kiện -->
    <div id="eventModal" class="fixed inset-0 z-[100] items-center justify-center p-4">
        <div class="bg-white rounded-[24px] shadow-2xl w-full max-w-md p-6 transform transition-all scale-95 opacity-0 duration-200" id="modalDialog">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <h3 id="modalTitle" class="text-xl font-black text-slate-900">Chi tiết buổi tập</h3>
                    <p id="modalWorkout" class="text-sm font-extrabold text-slate-900 mt-1">---</p>
                    <p id="modalBranch" class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-1">Cơ sở...</p>
                </div>
                <button onclick="closeModal()" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 transition-colors">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>
            
            <div class="space-y-4 mb-8">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">schedule</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Thời gian</p>
                        <p id="modalTime" class="font-bold text-slate-900">--:--</p>
                    </div>
                </div>
                
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">fitness_center</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Huấn luyện viên</p>
                        <p id="modalPT" class="font-bold text-slate-900">---</p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">info</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Trạng thái</p>
                        <span id="modalStatus" class="inline-block mt-1 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest">---</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">badge</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Mã buổi</p>
                        <p id="modalId" class="font-bold text-slate-900 font-mono text-sm">---</p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">hourglass</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Thời lượng</p>
                        <p id="modalDuration" class="font-bold text-slate-900">---</p>
                    </div>
                </div>

                <div id="modalNotesWrap" class="bg-slate-50 border border-slate-200 rounded-2xl p-4 hidden">
                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Ghi chú từ PT</p>
                    <p id="modalNotes" class="text-sm font-medium text-slate-700 whitespace-pre-wrap"></p>
                </div>
            </div>

            <div class="flex gap-3" id="modalActions">
                <button onclick="closeModal()" class="flex-1 py-3 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-bold rounded-xl transition-all">Đóng</button>
                <button id="cancelBtn" onclick="cancelEvent()" class="flex-1 py-3 px-4 bg-red-100 hover:bg-red-200 text-red-700 text-sm font-bold rounded-xl transition-all hidden">Yêu cầu hủy buổi tập</button>
            </div>
            <p id="cancelNote" class="text-center text-xs text-slate-500 mt-4 hidden">Không thể gửi yêu cầu hủy khi buổi tập đã bắt đầu.</p>
        </div>
    </div>

    <script>
        let currentEventId = null;
        let currentEventStart = null;
        let calendarApp = null;

        document.addEventListener('DOMContentLoaded', function() {
            const calendarEl = document.getElementById('calendar');
            calendarApp = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next',
                    center: 'title',
                    right: ''
                },
                locale: 'vi',
                slotMinTime: '06:00:00',
                slotMaxTime: '22:00:00',
                allDaySlot: false,
                height: 'auto',
                dayMaxEvents: 3, // Bug 3.4/4.1: quá 3 event gộp thành '+n xem thêm' — không tràn ô
                moreLinkContent: (args) => '+' + args.num + ' xem thêm',
                events: '/api/calendar/sessions', // Fetch events from API
                eventClick: function(info) {
                    showEventModal(info.event);
                }
            });
            calendarApp.render();

            // Hook custom view buttons
            const monthBtn = document.getElementById('viewMonthBtn');
            const weekBtn = document.getElementById('viewWeekBtn');
            const todayBtn = document.getElementById('todayBtn');
            function setViewButtons(active) {
                if (!monthBtn || !weekBtn) return;
                const monthActive = active === 'month';
                monthBtn.className = monthActive
                    ? 'px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-primary text-white'
                    : 'px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-transparent text-slate-600';
                weekBtn.className = !monthActive
                    ? 'px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-primary text-white'
                    : 'px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-transparent text-slate-600';
            }
            if (monthBtn) monthBtn.addEventListener('click', () => { calendarApp.changeView('dayGridMonth'); setViewButtons('month'); });
            if (weekBtn) weekBtn.addEventListener('click', () => { calendarApp.changeView('timeGridWeek'); setViewButtons('week'); });
            setViewButtons('month');
        });

        function goToday() {
            try {
                // Ensure user is on Calendar tab
                if (typeof setScheduleTab === 'function') {
                    setScheduleTab('tab-calendar');
                }
                if (!calendarApp) return;
                const now = new Date();
                // Force a consistent view so user sees the jump
                if (typeof calendarApp.changeView === 'function') {
                    calendarApp.changeView('dayGridMonth');
                }
                if (typeof calendarApp.gotoDate === 'function') {
                    calendarApp.gotoDate(now);
                } else if (typeof calendarApp.today === 'function') {
                    calendarApp.today();
                }
                if (typeof calendarApp.updateSize === 'function') {
                    setTimeout(() => calendarApp.updateSize(), 30);
                }
            } catch (e) {
                console.error('goToday error', e);
            }
        }

        function showEventModal(event) {
            currentEventId = event.id;
            currentEventStart = event.start;
            
            const workoutTitle = (event.extendedProps && event.extendedProps.workoutTitle) ? String(event.extendedProps.workoutTitle).trim() : '';
            const ptName = (event.extendedProps && event.extendedProps.ptName) ? String(event.extendedProps.ptName).trim() : 'N/A';
            const timeStr = event.start
                ? event.start.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })
                : '--:--';
            document.getElementById('modalTitle').innerText = `${timeStr} · ${ptName}`;
            document.getElementById('modalWorkout').innerText = workoutTitle || 'Buổi tập';
            document.getElementById('modalBranch').innerText = event.extendedProps.branchName || 'Cơ sở';
            document.getElementById('modalPT').innerText = ptName;
            document.getElementById('modalId').innerText = (event.id || '---').toString().slice(-10);
            
            if (event.start) {
                const startTime = event.start.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                if (event.end) {
                    const endTime = event.end.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                    document.getElementById('modalTime').innerText = `${event.start.toLocaleDateString('vi-VN')} | ${startTime} - ${endTime}`;
                } else {
                    document.getElementById('modalTime').innerText = `${event.start.toLocaleDateString('vi-VN')} | ${startTime}`;
                }
            }

            const durationEl = document.getElementById('modalDuration');
            if (event.start && event.end) {
                const mins = Math.max(0, Math.round((event.end.getTime() - event.start.getTime()) / (1000 * 60)));
                durationEl.innerText = mins ? `${mins} phút` : '---';
            } else {
                durationEl.innerText = '---';
            }

            const notesWrap = document.getElementById('modalNotesWrap');
            const notesEl = document.getElementById('modalNotes');
            const notes = (event.extendedProps && event.extendedProps.notes) ? String(event.extendedProps.notes).trim() : '';
            if (notes) {
                notesEl.innerText = notes;
                notesWrap.classList.remove('hidden');
            } else {
                notesEl.innerText = '';
                notesWrap.classList.add('hidden');
            }

            const statusBadge = document.getElementById('modalStatus');
            const status = event.extendedProps.status;
            let bgColor = 'bg-slate-200';
            let textColor = 'text-slate-600';
            let statusText = status;

            if (status === 'Pending_Admin') {
                bgColor = 'bg-amber-100'; textColor = 'text-amber-700'; statusText = 'Chờ duyệt';
            } else if (status === 'Completed') {
                bgColor = 'bg-primary/20'; textColor = 'text-primary'; statusText = 'Đã tập xong';
            } else if (status === 'In_Progress') {
                bgColor = 'bg-orange-500/20'; textColor = 'text-orange-700'; statusText = 'Đang tập';
            } else if (status === 'Scheduled') {
                bgColor = 'bg-blue-100'; textColor = 'text-blue-700'; statusText = 'Đang chờ';
            } else if (status === 'Cancelled') {
                 bgColor = 'bg-red-100'; textColor = 'text-red-700'; statusText = 'Đã hủy';
            } else if (status === 'No_Show') {
                bgColor = 'bg-slate-300'; textColor = 'text-slate-700'; statusText = 'Vắng mặt';
            } else if (status === 'Cancel_Requested') {
                bgColor = 'bg-amber-100'; textColor = 'text-amber-700'; statusText = 'Chờ PT duyệt hủy';
            } else if (status === 'Confirmed') {
                bgColor = 'bg-emerald-100'; textColor = 'text-emerald-700'; statusText = 'Đã xác nhận';
            }
            
            statusBadge.className = `inline-block mt-1 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${bgColor} ${textColor}`;
            statusBadge.innerText = statusText;

            // Chỉ cho gửi yêu cầu hủy khi buổi đang Scheduled và chưa bắt đầu
            const cancelBtn = document.getElementById('cancelBtn');
            const cancelNote = document.getElementById('cancelNote');
            const now = new Date();
            const canRequestCancel = status === 'Scheduled' && currentEventStart && currentEventStart > now;

            if (canRequestCancel) {
                cancelBtn.classList.remove('hidden');
                cancelNote.classList.add('hidden');
            } else {
                cancelBtn.classList.add('hidden');
                if (status === 'Scheduled' || status === 'In_Progress') {
                    cancelNote.classList.remove('hidden');
                } else if (status === 'Cancelled') {
                    cancelNote.classList.add('hidden');
                }
            }

            // Hiển thị modal với animation
            const modal = document.getElementById('eventModal');
            const dialog = document.getElementById('modalDialog');
            modal.classList.add('active');
            setTimeout(() => {
                dialog.classList.remove('scale-95', 'opacity-0');
                dialog.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeModal() {
            const modal = document.getElementById('eventModal');
            const dialog = document.getElementById('modalDialog');
            dialog.classList.remove('scale-100', 'opacity-100');
            dialog.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.remove('active');
                currentEventId = null;
            }, 200);
        }

        async function cancelEvent() {
            if (!currentEventId) return;
            if (!confirm('Bạn muốn gửi yêu cầu hủy buổi tập này tới PT?')) return;

            try {
                const res = await fetch(`/client/sessions/${currentEventId}/cancel-request`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
                });
                const data = await res.json();
                
                if (res.ok) {
                    closeModal(); // Ẩn modal
                    calendarApp.refetchEvents(); // Rerender schedule
                    alert(data.message || 'Đã gửi yêu cầu hủy. Vui lòng chờ PT phản hồi.');
                } else {
                    alert(`Lỗi: ${data.message || 'Không thể hủy lịch'}`);
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi hệ thống khi tải dữ liệu');
            }
        }

        // === In-page Tabs (Calendar / History) ===
        function setScheduleTab(targetId) {
            const targets = ['tab-calendar', 'tab-history'];
            targets.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                if (id === targetId) el.classList.remove('hidden');
                else el.classList.add('hidden');
            });
            document.querySelectorAll('.schedule-tab').forEach(btn => {
                const isActive = btn.dataset.target === targetId;
                btn.className = isActive
                    ? 'schedule-tab px-4 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest bg-primary text-white'
                    : 'schedule-tab px-4 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest bg-white text-slate-600 border border-slate-200';
            });
        }
        document.querySelectorAll('.schedule-tab').forEach(btn => {
            btn.addEventListener('click', () => {
                setScheduleTab(btn.dataset.target);
                history.replaceState(null, '', '#' + btn.dataset.target.replace('tab-', ''));
                if (btn.dataset.target === 'tab-calendar') {
                    setTimeout(() => calendarApp && calendarApp.updateSize && calendarApp.updateSize(), 30);
                }
            });
        });
        (function bootScheduleTabs() {
            const hash = (location.hash || '').replace('#', '');
            const map = { calendar: 'tab-calendar', history: 'tab-history' };
            setScheduleTab(map[hash] || 'tab-calendar');
        })();

        // === History Load More ===
        (function initScheduleHistoryMore() {
            const btn = document.getElementById('scheduleHistoryLoadMore');
            if (!btn) return;
            const items = Array.from(document.querySelectorAll('.schedule-history-item'));
            let shown = 8;
            btn.onclick = () => {
                const step = 8;
                const next = Math.min(items.length, shown + step);
                for (let i = shown; i < next; i++) items[i].classList.remove('hidden');
                shown = next;
                if (shown >= items.length) btn.classList.add('hidden');
            };
        })();
    </script>

    <% if (typeof pt !== 'undefined' && pt) { %>
    <%- include('../partials/client-pt-change-modal', { pt }) %>
    <% } %>
    <%- include('../partials/client-bottom-nav', { activePage: 'schedule' }) %>
</body>
</html>
