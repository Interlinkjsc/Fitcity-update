<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Chương trình tập - FitCity</title>
    <%- include('../partials/client-head') %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-32 overflow-x-hidden">
    <header class="px-6 md:px-12 pt-6 md:pt-12 pb-3 mb-4 flex items-start justify-between gap-4">
        <div>
            <h1 class="text-4xl font-black italic tracking-tighter uppercase leading-none"><span class="text-primary tracking-normal">CHƯƠNG</span> TRÌNH TẬP</h1>
            <p class="text-slate-500 text-sm mt-2">Buổi sắp tới & lịch sử chương trình tập.</p>
        </div>
        <a href="/client" aria-label="Về trang chủ" class="w-11 h-11 bg-white/90 backdrop-blur-xl border border-slate-200 rounded-full flex items-center justify-center hover:bg-white transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
            <span class="material-symbols-outlined">close</span>
        </a>
    </header>

    <main class="px-6 md:px-12 space-y-6">
        <% if (typeof weekAssignment !== 'undefined' && weekAssignment && weekAssignment.program) { %>
        <section class="bg-white border border-primary/30 rounded-[28px] p-6 shadow-sm">
            <h2 class="text-xs font-black uppercase tracking-[0.2em] text-primary mb-2 flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">calendar_month</span> Lộ trình tuần (PT gán)
            </h2>
            <h3 class="text-lg font-black text-slate-900"><%= weekAssignment.program.title %></h3>
            <p class="text-xs text-slate-500 mt-1"><%= weekAssignment.program.goal %> · HLV: <%= weekAssignment.pt ? weekAssignment.pt.name : 'PT' %></p>
            <div class="mt-4 space-y-2">
                <% (weekAssignment.weekSchedule || []).forEach(day => { %>
                <div class="border border-slate-100 rounded-xl p-3">
                    <p class="text-[10px] font-black text-slate-500 uppercase">Thứ <%= day.dayOfWeek %></p>
                    <p class="font-bold text-sm text-slate-800"><%= day.sessionTitle %></p>
                    <p class="text-xs text-slate-500 mt-1"><%= (day.exercises || []).length %> bài tập</p>
                </div>
                <% }) %>
            </div>
        </section>
        <% } %>

        <!-- In-page Tabs -->
        <section class="bg-white/90 backdrop-blur-xl border border-slate-200 rounded-[28px] p-2 shadow-sm">
            <div class="grid grid-cols-2 gap-2">
                <button type="button" class="workout-tab px-4 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest bg-primary text-white" data-target="tab-overview">
                    Gần nhất
                </button>
                <button type="button" class="workout-tab px-4 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest bg-white text-slate-600 border border-slate-200" data-target="tab-library">
                    Lịch sử CT
                </button>
            </div>
        </section>

        <!-- Next/Recent Session -->
        <section id="tab-overview">
            <h2 class="text-xs font-black uppercase tracking-[0.2em] text-slate-500 mb-4 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-primary"></span> Buổi tập gần nhất / sắp tới
            </h2>
            
            <% if (sessions && sessions.length > 0) { %>
                <%
                    const nowMs = Date.now();
                    const inProgressSession = sessions.find(s => s.status === 'In_Progress');
                    const upcomingScheduled = sessions
                        .filter(s => s.status === 'Scheduled' && new Date(s.scheduledTime).getTime() >= nowMs)
                        .sort((a, b) => new Date(a.scheduledTime).getTime() - new Date(b.scheduledTime).getTime())[0];
                    const fallbackScheduled = sessions.find(s => s.status === 'Scheduled');
                    const qrSession = inProgressSession || upcomingScheduled || fallbackScheduled || null;
                    const displaySession = qrSession || sessions[0];
                %>
                <div class="bg-white border border-slate-200 rounded-[32px] p-6 md:p-8 shadow-sm relative overflow-hidden group">
                    <div class="absolute -right-12 -top-12 w-48 h-48 bg-accent/10 rounded-full blur-3xl group-hover:bg-accent/20 transition-all duration-700"></div>
                    
                    <div class="flex flex-col gap-6 relative z-10">
                        <!-- Upper: Info -->
                        <div class="flex gap-4 items-center">
                            <div class="h-14 w-14 rounded-2xl overflow-hidden shadow-sm border border-slate-200 shrink-0 bg-white">
                                <img src="<%= displaySession.pt.avatar || 'https://ui-avatars.com/api/?name=Coach&background=333&color=fff' %>" class="w-full h-full object-cover">
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-lg font-black text-slate-900 truncate"><%= displaySession.workoutPlan || 'Giáo án linh hoạt' %></h3>
                                <p class="text-[10px] text-slate-500 font-bold uppercase tracking-widest mt-0.5 truncate">HLV: <%= displaySession.pt.name %></p>
                                <div class="flex items-center gap-2 mt-2">
                                    <span class="text-[10px] text-slate-500 font-bold uppercase tracking-widest flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[12px]">schedule</span>
                                        <%= new Date(displaySession.scheduledTime).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }) %>
                                    </span>
                                    <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                                    <span class="px-2 py-0.5 <%= displaySession.status === 'Completed' ? 'bg-primary/20 text-primary' : (displaySession.status === 'Confirmed' ? 'bg-emerald-500/20 text-emerald-700' : (displaySession.status === 'Scheduled' ? 'bg-blue-500/20 text-blue-500' : (displaySession.status === 'Cancel_Requested' ? 'bg-amber-500/20 text-amber-700' : (displaySession.status === 'Cancelled' ? 'bg-red-500/20 text-red-500' : 'bg-orange-500/20 text-orange-500')))) %> text-[10px] font-black rounded-full uppercase">
                                        <%= displaySession.status === 'Scheduled' ? 'Sắp tới' : (displaySession.status === 'In_Progress' ? 'Đang tập' : (displaySession.status === 'Completed' ? 'Hoàn thành' : (displaySession.status === 'Confirmed' ? 'Đã xác nhận' : (displaySession.status === 'Cancel_Requested' ? 'Chờ duyệt hủy' : displaySession.status)))) %>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Lower: Actions -->
                        <div class="flex flex-col gap-2 mt-1 pt-4 border-t border-slate-100">
                            <% if (qrSession && qrSession.status === 'Scheduled') { %>
                                <button type="button" onclick="openQrModal('<%= qrSession._id %>', 'start')"
                                   class="w-full text-center px-4 py-3 bg-primary text-white font-black uppercase rounded-2xl hover:brightness-110 active:scale-[0.99] transition-all text-[10px] tracking-widest shadow-sm">
                                    HIỂN THỊ QR BẮT ĐẦU
                                </button>
                                <form action="/client/sessions/<%= qrSession._id %>/cancel-request" method="POST" class="m-0">
                                    <button type="submit" class="w-full text-center px-4 py-3 bg-rose-100 text-rose-700 font-black uppercase rounded-2xl hover:bg-rose-200 active:scale-[0.99] transition-all text-[10px] tracking-widest border border-rose-200">
                                        GỬI YÊU CẦU HỦY
                                    </button>
                                </form>
                            <% } %>
                            <% if (qrSession && qrSession.status === 'Cancel_Requested') { %>
                                <button type="button" disabled class="w-full px-4 py-3 bg-amber-100 text-amber-700 font-black uppercase rounded-2xl cursor-not-allowed text-[10px] tracking-widest border border-amber-200">
                                    ĐANG CHỜ PT PHẢN HỒI YÊU CẦU HỦY
                                </button>
                            <% } %>
                            <% if (qrSession && qrSession.status === 'In_Progress') { %>
                                <button type="button" onclick="openQrModal('<%= qrSession._id %>', 'end')"
                                   class="w-full text-center px-4 py-3 bg-primary text-white font-black uppercase rounded-2xl hover:brightness-110 active:scale-[0.99] transition-all text-[10px] tracking-widest shadow-sm">
                                    HIỂN THỊ QR KẾT THÚC
                                </button>
                            <% } %>
                            <button type="button" disabled class="w-full px-4 py-3 bg-slate-50 text-slate-400 font-black uppercase rounded-2xl cursor-not-allowed text-[10px] tracking-widest border border-slate-200">
                                CHI TIẾT BÀI TẬP (Sắp ra mắt)
                            </button>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="glass p-12 rounded-[40px] text-center">
                    <p class="text-slate-500 font-bold uppercase tracking-widest">Bạn chưa có lịch tập nào được lên!</p>
                </div>
            <% } %>
        </section>

        <!-- THƯ VIỆN BÀI TẬP -->
        <section id="tab-library" class="hidden">
            <% if (programs && programs.length > 0) { %>
                <%
                    const goalIcons = { 'Giảm cân': 'local_fire_department', 'Tăng cơ': 'fitness_center', 'Sức bền': 'cardiology', 'Dẻo dai': 'self_improvement', 'Tổng hợp': 'psychology' };
                    const goalColors = { 'Giảm cân': 'text-orange-500 bg-orange-500/10', 'Tăng cơ': 'text-blue-500 bg-blue-500/10', 'Sức bền': 'text-red-500 bg-red-500/10', 'Dẻo dai': 'text-emerald-500 bg-emerald-500/10', 'Tổng hợp': 'text-purple-500 bg-purple-500/10' };
                    const levelLabels = { 'Beginner': 'Cơ bản', 'Intermediate': 'Trung bình', 'Advanced': 'Nâng cao' };
                    const goals = [...new Set(programs.map(p => p.goal))];
                %>

                <!-- Goal Tabs -->
                <div class="flex gap-2 overflow-x-auto pb-2 mb-5 -mx-2 px-2 scrollbar-hide">
                    <button type="button" onclick="filterPrograms('all')" data-goal="all"
                        class="program-tab shrink-0 px-4 py-2 rounded-full text-[10px] font-black uppercase tracking-widest border transition-all bg-primary text-white border-primary">
                        Tất cả
                    </button>
                    <% goals.forEach(goal => { %>
                        <button type="button" onclick="filterPrograms('<%= goal %>')" data-goal="<%= goal %>"
                            class="program-tab shrink-0 px-4 py-2 rounded-full text-[10px] font-black uppercase tracking-widest border transition-all bg-white text-slate-600 border-slate-200 hover:border-primary hover:text-primary">
                            <span class="material-symbols-outlined text-[14px] align-middle mr-0.5"><%= goalIcons[goal] || 'sports' %></span>
                            <%= goal %>
                        </button>
                    <% }) %>
                </div>

                <!-- Programs List -->
                <div class="space-y-4" id="programsList">
                    <% programs.forEach((prog, idx) => { %>
                        <div class="program-card bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm" data-goal="<%= prog.goal %>">
                            <!-- Header (clickable) -->
                            <button type="button" data-idx="<%= idx %>" class="program-toggle w-full text-left p-4 flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 <%= goalColors[prog.goal] || 'bg-slate-100 text-slate-500' %>">
                                    <span class="material-symbols-outlined text-[20px]"><%= goalIcons[prog.goal] || 'sports' %></span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-sm font-black text-slate-900 truncate"><%= prog.title %></h4>
                                    <div class="flex items-center gap-2 mt-1 flex-wrap">
                                        <span class="text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full <%= goalColors[prog.goal] || 'bg-slate-100 text-slate-500' %>"><%= prog.goal %></span>
                                        <span class="text-[9px] font-bold uppercase tracking-widest text-slate-400"><%= levelLabels[prog.level] || prog.level %></span>
                                        <span class="text-[9px] text-slate-400">•</span>
                                        <span class="text-[9px] font-bold text-slate-400"><%= prog.duration %> · <%= prog.sessionsPerWeek %> buổi/tuần</span>
                                    </div>
                                </div>
                                <span class="material-symbols-outlined text-slate-400 text-[20px] transition-transform program-chevron" id="chevron-<%= idx %>">expand_more</span>
                            </button>

                            <!-- Body (collapsible) -->
                            <div class="hidden border-t border-slate-100" id="program-body-<%= idx %>">
                                <% if (prog.description) { %>
                                    <div class="px-4 pt-4 pb-2">
                                        <p class="text-xs text-slate-600 leading-relaxed"><%= prog.description %></p>
                                    </div>
                                <% } %>

                                <!-- Exercises Table -->
                                <div class="px-4 pb-5 pt-2">
                                    <h5 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">Danh sách bài tập (<%= prog.exercises.length %> bài)</h5>
                                    <div class="space-y-2">
                                        <% prog.exercises.forEach((ex, exIdx) => { %>
                                            <div class="bg-slate-50 rounded-2xl p-3">
                                                <div class="flex items-start gap-3">
                                                    <span class="w-5 h-5 rounded-full bg-white border border-slate-200 flex items-center justify-center text-[9px] font-black text-slate-500 shrink-0 mt-0.5"><%= exIdx + 1 %></span>
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-xs font-bold text-slate-800"><%= ex.name %></p>
                                                        <div class="flex items-center gap-3 mt-1 flex-wrap">
                                                            <% if (ex.sets) { %>
                                                                <span class="text-[10px] text-slate-500"><span class="font-bold text-slate-700"><%= ex.sets %></span> set</span>
                                                            <% } %>
                                                            <% if (ex.reps) { %>
                                                                <span class="text-[10px] text-slate-500">× <span class="font-bold text-slate-700"><%= ex.reps %></span></span>
                                                            <% } %>
                                                            <% if (ex.rest && ex.rest !== '-') { %>
                                                                <span class="text-[10px] text-slate-500">nghỉ <span class="font-bold text-slate-700"><%= ex.rest %></span></span>
                                                            <% } %>
                                                        </div>
                                                        <% if (ex.notes) { %>
                                                            <p class="text-[10px] text-slate-400 italic mt-1 leading-relaxed"><%= ex.notes %></p>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="glass p-12 rounded-[40px] text-center">
                    <p class="text-slate-500 font-bold uppercase tracking-widest">Chưa có chương trình tập nào.</p>
                </div>
            <% } %>
        </section>
    </main>

    <!-- Navigation Bar -->
    <% const activePage = 'workouts'; %>
    <%- include('../partials/client-bottom-nav', { activePage }) %>

    <!-- Slide-up Modal for QR -->
    <div id="qrModalOverlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] opacity-0 pointer-events-none transition-opacity duration-300" onclick="closeQrModal()"></div>
    
    <div id="qrModal" class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white rounded-t-[40px] z-[110] transform translate-y-full transition-transform duration-300 shadow-[0_-10px_40px_rgba(0,0,0,0.1)] flex flex-col items-center pt-8 pb-10 px-8">
        <button type="button" class="absolute top-6 right-6 w-10 h-10 bg-slate-100 rounded-full flex items-center justify-center text-slate-500 hover:bg-slate-200 transition-all" onclick="closeQrModal()">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
        
        <h2 id="qrModalTitle" class="text-2xl font-black italic tracking-tighter uppercase text-slate-900 mb-1"><span class="text-primary tracking-normal">QR</span> BẮT ĐẦU</h2>
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest text-center mb-6">Đưa màn hình cho PT quét. Mã tự hết hạn.</p>
        
        <div class="relative w-64 h-64 bg-slate-50 rounded-[32px] border-2 border-slate-200 p-6 flex flex-col items-center justify-center shadow-inner">
            <!-- Loading Spinner -->
            <div id="qrLoading" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-50 rounded-[30px] z-10 transition-opacity duration-300">
                <div class="w-10 h-10 border-4 border-slate-200 border-t-primary rounded-full animate-spin mb-3"></div>
                <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Đang tạo mã...</p>
            </div>
            
            <div id="qrcode" class="w-full h-full flex items-center justify-center"></div>
        </div>
        
        <div class="w-full mt-8">
            <button type="button" id="copyBtn" class="w-full px-4 py-3.5 bg-primary text-white font-black uppercase rounded-2xl hover:brightness-110 active:scale-[0.98] transition-all text-sm tracking-widest shadow-lg shadow-accent/20" onclick="copyToken()">
                COPY MÃ (FALLBACK)
            </button>
            <div id="tokenDisplay" class="mt-3 p-3 bg-slate-100 rounded-xl text-[8px] text-slate-500 font-mono break-all hidden max-h-24 overflow-y-auto"></div>
            <p class="text-[8px] font-bold text-slate-400 uppercase tracking-widest text-center mt-3 leading-relaxed">
                NẾU PT KHÔNG QUÉT ĐƯỢC CAMERA, COPY MÃ NÀY GỬI CHO PT.
            </p>
        </div>
    </div>

    <script>
        let currentToken = '';

        async function openQrModal(sessionId, action) {
            const overlay = document.getElementById('qrModalOverlay');
            const modal = document.getElementById('qrModal');
            const qrContainer = document.getElementById('qrcode');
            const loading = document.getElementById('qrLoading');
            const title = document.getElementById('qrModalTitle');
            const tokenDisplay = document.getElementById('tokenDisplay');
            const copyBtn = document.getElementById('copyBtn');
            
            // Set title
            title.innerHTML = action === 'start' ? '<span class="text-primary tracking-normal">QR</span> BẮT ĐẦU' : '<span class="text-primary tracking-normal">QR</span> KẾT THÚC';
            
            // Reset state
            qrContainer.innerHTML = '';
            loading.style.opacity = '1';
            loading.style.pointerEvents = 'auto';
            currentToken = '';
            tokenDisplay.classList.add('hidden');
            tokenDisplay.textContent = '';
            copyBtn.innerHTML = 'COPY MÃ (FALLBACK)';
            copyBtn.classList.remove('bg-emerald-500');
            copyBtn.classList.add('bg-primary');
            
            // Show modal (slide up)
            overlay.classList.remove('opacity-0', 'pointer-events-none');
            overlay.classList.add('opacity-100');
            modal.classList.remove('translate-y-full');
            
            try {
                // Fetch fresh token
                const res = await fetch(`/client/sessions/${sessionId}/qr?action=${action}`, {
                    headers: { 'Accept': 'application/json' }
                });
                const data = await res.json();
                
                if (data.success && data.token) {
                    currentToken = data.token;
                    // Generate QR
                    new QRCode(qrContainer, {
                        text: currentToken,
                        width: 200,
                        height: 200,
                        colorDark : "#0f172a",
                        colorLight : "#f8fafc",
                        correctLevel : QRCode.CorrectLevel.H
                    });
                    // Hide loading smoothly
                    setTimeout(() => { 
                        loading.style.opacity = '0'; 
                        loading.style.pointerEvents = 'none';
                    }, 400);
                } else {
                    alert(data.message || 'Lỗi tạo mã QR');
                    closeQrModal();
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối. Vui lòng thử lại.');
                closeQrModal();
            }
        }

        function closeQrModal() {
            const overlay = document.getElementById('qrModalOverlay');
            const modal = document.getElementById('qrModal');
            
            overlay.classList.remove('opacity-100');
            overlay.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.add('translate-y-full');
        }

        function copyToken() {
            if (!currentToken) return;
            
            const btn = document.getElementById('copyBtn');
            const display = document.getElementById('tokenDisplay');
            
            navigator.clipboard.writeText(currentToken).catch(err => console.log('Lỗi copy:', err));
            
            // Hiện mã trực tiếp lên màn hình
            display.textContent = currentToken;
            display.classList.remove('hidden');
            
            // Đổi giao diện nút để báo thành công
            btn.innerHTML = '<span class="flex items-center justify-center gap-2"><span class="material-symbols-outlined text-[18px]">check_circle</span> ĐÃ COPY MÃ</span>';
            btn.classList.remove('bg-primary');
            btn.classList.add('bg-emerald-500');
            
            // Trả lại nút cũ sau 3 giây
            setTimeout(() => {
                btn.innerHTML = 'COPY MÃ (FALLBACK)';
                btn.classList.remove('bg-emerald-500');
                btn.classList.add('bg-primary');
            }, 3000);
        }

        // === THƯ VIỆN BÀI TẬP ===
        function toggleProgram(idx) {
            const body = document.getElementById('program-body-' + idx);
            const chevron = document.getElementById('chevron-' + idx);
            if (body.classList.contains('hidden')) {
                body.classList.remove('hidden');
                chevron.style.transform = 'rotate(180deg)';
            } else {
                body.classList.add('hidden');
                chevron.style.transform = 'rotate(0deg)';
            }
        }

        // Attach click handlers via data-idx
        document.querySelectorAll('.program-toggle').forEach(btn => {
            btn.addEventListener('click', () => toggleProgram(btn.dataset.idx));
        });

        function filterPrograms(goal) {
            // Update tabs
            document.querySelectorAll('.program-tab').forEach(tab => {
                if (tab.dataset.goal === goal) {
                    tab.className = tab.className.replace(/bg-white text-slate-600 border-slate-200/, 'bg-primary text-white border-primary');
                } else {
                    tab.className = tab.className.replace(/bg-primary text-white border-primary/, 'bg-white text-slate-600 border-slate-200');
                }
            });
            // Filter cards
            document.querySelectorAll('.program-card').forEach(card => {
                if (goal === 'all' || card.dataset.goal === goal) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // === In-page Tabs ===
        function setWorkoutTab(targetId) {
            const targets = ['tab-overview', 'tab-library'];
            targets.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                if (id === targetId) el.classList.remove('hidden');
                else el.classList.add('hidden');
            });
            document.querySelectorAll('.workout-tab').forEach(btn => {
                const isActive = btn.dataset.target === targetId;
                btn.className = isActive
                    ? 'workout-tab px-4 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest bg-primary text-white'
                    : 'workout-tab px-4 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest bg-white text-slate-600 border border-slate-200';
            });
        }
        document.querySelectorAll('.workout-tab').forEach(btn => {
            btn.addEventListener('click', () => {
                setWorkoutTab(btn.dataset.target);
                history.replaceState(null, '', '#' + btn.dataset.target.replace('tab-', ''));
            });
        });
        // Default tab from hash
        (function bootWorkoutTabs() {
            const hash = (location.hash || '').replace('#', '');
            const map = { overview: 'tab-overview', library: 'tab-library' };
            setWorkoutTab(map[hash] || 'tab-overview');
        })();
    </script>
</body>
</html>
