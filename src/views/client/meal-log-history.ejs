<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Lịch sử nhật ký ăn uống - FitCity</title>
    <%- include('../partials/client-head') %>
</head>
<body class="p-6 md:p-12 mb-20 overflow-x-hidden">
    <%- include('../partials/flash') %>

    <header class="flex justify-between items-start mb-8">
        <div>
            <h1 class="text-3xl font-black italic tracking-tighter uppercase leading-none"><span class="text-primary">NHẬT KÝ</span> ĂN UỐNG</h1>
            <p class="text-slate-500 text-sm mt-1">Lịch sử ghi log bữa ăn của bạn.</p>
        </div>
        <a href="/client/nutrition" aria-label="Quay lại"
           class="w-12 h-12 glass rounded-full flex items-center justify-center hover:bg-slate-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
            <span class="material-symbols-outlined">close</span>
        </a>
    </header>

    <!-- Active meal plan info -->
    <% if (activeMealPlan) { %>
    <div class="bg-white rounded-2xl border border-emerald-200 shadow-sm p-4 mb-6 flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 shrink-0">
            <span class="material-symbols-outlined text-lg">restaurant_menu</span>
        </div>
        <div class="flex-1 min-w-0">
            <p class="text-xs font-black text-emerald-500 uppercase tracking-widest">Kế hoạch đang áp dụng</p>
            <p class="font-bold text-slate-800 text-sm"><%= activeMealPlan.goal %> · <%= activeMealPlan.dailyCalories ? activeMealPlan.dailyCalories.toLocaleString('vi-VN') + ' kcal/ngày' : '' %></p>
            <% if (activeMealPlan.pt) { %>
            <p class="text-xs text-slate-400">PT: <%= activeMealPlan.pt.name %></p>
            <% } %>
        </div>
    </div>
    <% } %>

    <!-- Filter + action row -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-6">
        <form method="GET" action="/client/meal-log/history" class="flex items-center gap-2">
            <label class="text-sm font-semibold text-slate-600">Xem</label>
            <select name="days" onchange="this.form.submit()"
                    class="border border-slate-200 rounded-xl px-3 py-1.5 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-primary/30 bg-white">
                <option value="7"  <%= days === 7  ? 'selected' : '' %>>7 ngày qua</option>
                <option value="14" <%= days === 14 ? 'selected' : '' %>>14 ngày qua</option>
                <option value="30" <%= days === 30 ? 'selected' : '' %>>30 ngày qua</option>
            </select>
        </form>
        <a href="/client/meal-log"
           class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white text-sm font-bold rounded-xl hover:bg-primary/90 transition-colors shadow-sm">
            <span class="material-symbols-outlined text-base">edit_note</span>
            Ghi nhật ký hôm nay
        </a>
    </div>

    <!-- Log table -->
    <% if (!logs || logs.length === 0) { %>
    <div class="flex flex-col items-center justify-center py-20 text-slate-400">
        <span class="material-symbols-outlined text-5xl mb-3 text-slate-300">no_meals</span>
        <p class="text-base font-semibold">Chưa có nhật ký nào trong <%= days %> ngày qua</p>
        <p class="text-sm mt-1">Hãy ghi lại bữa ăn hôm nay để theo dõi tiến độ!</p>
    </div>
    <% } else { %>
    <%
        const complianceStyle = {
            Followed: 'bg-emerald-100 text-emerald-700',
            Partial:  'bg-amber-100 text-amber-700',
            Skipped:  'bg-red-100 text-red-600'
        };
        const complianceLabel = {
            Followed: 'Đúng kế hoạch',
            Partial:  'Một phần',
            Skipped:  'Bỏ bữa'
        };
    %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Ngày</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Bữa ăn</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Mô tả</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Calories</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Compliance</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% logs.forEach(log => { %>
                    <%
                        const cs = log.compliance || '';
                        const csClass = complianceStyle[cs] || 'bg-slate-100 text-slate-500';
                        const csLabel = complianceLabel[cs] || cs || '—';
                    %>
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-4 py-3 text-slate-600 font-medium whitespace-nowrap">
                            <%= log.logDate ? new Date(log.logDate).toLocaleDateString('vi-VN') : '—' %>
                        </td>
                        <td class="px-4 py-3 text-slate-700 font-semibold"><%= log.mealType || '—' %></td>
                        <td class="px-4 py-3 text-slate-500 max-w-[200px] truncate" title="<%= log.description || '' %>">
                            <%= log.description || '—' %>
                        </td>
                        <td class="px-4 py-3 text-right font-bold text-slate-700">
                            <%= log.calories ? log.calories.toLocaleString('vi-VN') + ' kcal' : '—' %>
                        </td>
                        <td class="px-4 py-3 text-center">
                            <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-bold <%= csClass %>">
                                <%= csLabel %>
                            </span>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

    <%- include('../partials/client-bottom-nav', { activePage }) %>
</body>
</html>
