<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Hồ sơ cá nhân - FitCity</title>
    <%- include('../partials/client-head') %>
</head>
<body class="p-6 md:p-12 mb-32 overflow-x-hidden bg-[#F8FAF7] text-slate-900 min-h-screen">
    <%- include('../partials/flash') %>

    <header class="flex justify-between items-start mb-10">
        <div>
            <h1 class="text-4xl font-black italic tracking-tighter uppercase leading-none"><span class="text-primary tracking-normal">HỒ SƠ</span> CÁ NHÂN</h1>
            <p class="text-slate-500 text-sm mt-2">Quản lý thông tin cá nhân và thanh toán.</p>
        </div>
        <a href="/client" aria-label="Về trang chủ" class="w-12 h-12 glass rounded-full flex items-center justify-center hover:bg-slate-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
            <span class="material-symbols-outlined">close</span>
        </a>
    </header>

    <main class="space-y-8">
        <form action="/auth/profile" method="POST" class="space-y-6">
            <!-- Card: Thông tin cá nhân -->
            <section class="glass p-6 md:p-8 rounded-[32px] border border-slate-100">
                <div class="flex flex-col md:flex-row gap-6 items-start">
                    <div class="flex items-center gap-4 w-full md:w-auto">
                        <div class="h-16 w-16 rounded-2xl overflow-hidden shadow-sm border border-slate-200 shrink-0 bg-white">
                            <img src="<%= user.avatar || '/images/default-avatar-client.svg' %>"
                                 alt="Avatar"
                                 class="w-full h-full object-cover"
                                 onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&background=f1f5f9&color=475569&bold=true'">
                        </div>
                        <div class="min-w-0">
                            <h2 class="text-lg font-black text-slate-900 truncate"><%= user.name %></h2>
                            <p class="text-[10px] text-slate-500 font-bold uppercase tracking-widest mt-1 truncate"><%= user.email %></p>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-[10px] font-black rounded-full uppercase border border-slate-200">
                                    <%= user.role %>
                                </span>
                                <span class="px-2 py-0.5 bg-emerald-50 text-emerald-600 text-[10px] font-black rounded-full uppercase border border-emerald-100">
                                    Active
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="flex-1 w-full grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Số điện thoại liên hệ</label>
                            <input type="tel" name="phone" value="<%= user.phone || '' %>"
                                   class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
                                   placeholder="09xx xxx xxx">
                        </div>
                        <div>
                            <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">CCCD / Passport (Bị khóa)</label>
                            <input type="text" value="<%= user.cccdHash || 'Chưa cập nhật' %>" disabled
                                   class="block w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-mono italic text-slate-400">
                        </div>
                    </div>
                </div>
            </section>

            <% if (typeof affiliate !== 'undefined' && affiliate) { %>
            <section class="glass p-6 md:p-8 rounded-[32px] border border-slate-100">
                <div class="flex items-center gap-2 mb-5">
                    <span class="material-symbols-outlined text-primary">groups</span>
                    <h3 class="text-sm font-black uppercase tracking-widest text-slate-500">Giới thiệu bạn bè</h3>
                </div>
                <div class="bg-primary/5 border border-primary/20 rounded-2xl p-4 mb-4">
                    <p class="text-[10px] font-black uppercase text-slate-500">Mã giới thiệu của bạn</p>
                    <p class="text-2xl font-mono font-black text-primary mt-1"><%= affiliate.referralCode || '—' %></p>
                    <p class="text-xs text-slate-500 mt-2">F1 ký HĐ và thanh toán → bạn nhận quà 200.000đ</p>
                </div>
                <div class="grid grid-cols-2 gap-3 mb-4 text-center">
                    <div class="bg-white rounded-xl border border-slate-200 p-3">
                        <p class="text-2xl font-black text-slate-800"><%= affiliate.f1Users ? affiliate.f1Users.length : 0 %></p>
                        <p class="text-[10px] font-bold text-slate-500 uppercase">F1 (trực tiếp)</p>
                    </div>
                    <div class="bg-white rounded-xl border border-slate-200 p-3">
                        <p class="text-2xl font-black text-slate-800"><%= affiliate.f2Count || 0 %></p>
                        <p class="text-[10px] font-bold text-slate-500 uppercase">F2 (hiển thị)</p>
                    </div>
                </div>
                <% if (affiliate.f1Users && affiliate.f1Users.length) { %>
                <p class="text-[10px] font-black uppercase text-slate-400 mb-2">Danh sách F1</p>
                <ul class="text-sm text-slate-700 space-y-1 max-h-32 overflow-y-auto">
                    <% affiliate.f1Users.forEach(u => { %>
                    <li>• <%= u.name %> <span class="text-slate-400 text-xs">(<%= new Date(u.createdAt).toLocaleDateString('vi-VN') %>)</span></li>
                    <% }) %>
                </ul>
                <% } %>
            </section>
            <% } %>

            <!-- Card: Ngân hàng -->
            <section class="glass p-6 md:p-8 rounded-[32px] border border-slate-100">
                <div class="flex items-center gap-2 mb-5">
                    <span class="material-symbols-outlined text-slate-400">account_balance</span>
                    <h3 class="text-sm font-black uppercase tracking-widest text-slate-500">Thanh toán</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Ngân hàng</label>
                        <select name="bankName" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
                            <option value="">-- Chọn ngân hàng --</option>
                            <option value="Vietcombank" <%= user.bankInfo && user.bankInfo.bankName === 'Vietcombank' ? 'selected' : '' %>>Vietcombank</option>
                            <option value="Techcombank" <%= user.bankInfo && user.bankInfo.bankName === 'Techcombank' ? 'selected' : '' %>>Techcombank</option>
                            <option value="MB Bank" <%= user.bankInfo && user.bankInfo.bankName === 'MB Bank' ? 'selected' : '' %>>MB Bank</option>
                            <option value="BIDV" <%= user.bankInfo && user.bankInfo.bankName === 'BIDV' ? 'selected' : '' %>>BIDV</option>
                            <option value="TPBank" <%= user.bankInfo && user.bankInfo.bankName === 'TPBank' ? 'selected' : '' %>>TPBank</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Số tài khoản</label>
                        <input type="text" name="accountNumber" value="<%= user.bankInfo ? user.bankInfo.accountNumber : '' %>"
                               class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-mono text-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
                               placeholder="Nhập số tài khoản">
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Tên chủ tài khoản</label>
                        <input type="text" name="accountName" value="<%= user.bankInfo ? user.bankInfo.accountName : '' %>"
                               class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold uppercase text-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
                               placeholder="NGUYEN VAN A">
                    </div>
                </div>
            </section>

            <!-- Actions -->
            <section class="flex flex-col sm:flex-row gap-3 sm:justify-end">
                <button type="button" onclick="openChangePassword()"
                        class="w-full sm:w-auto px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-black uppercase rounded-2xl transition-all text-[10px] tracking-widest flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">lock_reset</span>
                    Đổi mật khẩu
                </button>
                <button type="submit"
                        class="w-full sm:w-auto px-8 py-3 bg-primary text-white font-black uppercase rounded-2xl hover:brightness-110 active:scale-[0.99] transition-all text-[10px] tracking-widest shadow-lg shadow-accent/20">
                    Lưu hồ sơ
                </button>
            </section>
        </form>
    </main>

    <!-- Bottom Nav -->
    <% const activePage = 'dashboard'; %>
    <%- include('../partials/client-bottom-nav', { activePage }) %>

    <!-- Password Modal (reuse same endpoint + script) -->
    <div id="passwordModal" class="hidden fixed inset-0 z-[120] overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm" onclick="closeChangePassword()"></div>
            <div class="relative bg-white rounded-[28px] shadow-2xl w-full max-w-md overflow-hidden border border-slate-200">
                <div class="px-6 py-5 border-b border-slate-200 bg-slate-50 flex justify-between items-center">
                    <h3 class="font-black text-slate-900 uppercase tracking-widest text-xs">Đổi mật khẩu</h3>
                    <button type="button" onclick="closeChangePassword()" class="text-slate-400 hover:text-slate-600 w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>
                <form id="changePasswordForm" class="p-6 space-y-4">
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Mật khẩu hiện tại</label>
                        <input type="password" name="oldPassword" required class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Mật khẩu mới</label>
                        <input type="password" name="newPassword" required minlength="6" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Xác nhận mật khẩu</label>
                        <input type="password" name="confirmPassword" required minlength="6" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
                    </div>
                    <div class="pt-2 flex gap-3">
                        <button type="button" onclick="closeChangePassword()" class="flex-1 px-4 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-black uppercase rounded-2xl transition-all text-[10px] tracking-widest">
                            Hủy
                        </button>
                        <button type="submit" class="flex-1 px-4 py-3 bg-primary hover:brightness-110 text-white font-black uppercase rounded-2xl transition-all text-[10px] tracking-widest">
                            Xác nhận
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function openChangePassword() { document.getElementById('passwordModal').classList.remove('hidden'); }
        function closeChangePassword() { document.getElementById('passwordModal').classList.add('hidden'); }

        document.getElementById('changePasswordForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());
            if (data.newPassword !== data.confirmPassword) { alert('Mật khẩu mới không khớp!'); return; }
            try {
                const res = await fetch('/auth/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (result.status === 'success') { alert('Đổi mật khẩu thành công!'); closeChangePassword(); }
                else { alert(result.message || 'Có lỗi xảy ra'); }
            } catch (err) { alert('Lỗi kết nối server'); }
        });
    </script>
</body>
</html>

