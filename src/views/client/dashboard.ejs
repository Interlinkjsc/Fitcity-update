<!DOCTYPE html>
<html lang="vi">
<head>
    <title>FITCITY - Trang chủ</title>
    <%- include('../partials/client-head') %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        .progress-ring { transform: rotate(-90deg); }
    </style>
</head>
<body class="bg-[#F8FAF7] text-slate-900 min-h-screen pb-24">
<%- include('../partials/flash') %>
<!-- Top navigation removed (use bottom bar actions) -->
<main class="px-6 pt-6 space-y-6">
<!-- Hero Area: Progress Arc -->
<section class="glass p-8 rounded-[40px] flex flex-col items-center text-center relative overflow-hidden group">
    <div class="absolute -right-12 -top-12 w-48 h-48 bg-accent/10 rounded-full blur-3xl group-hover:bg-accent/20 transition-all duration-700"></div>
    <div class="relative flex items-center justify-center mb-4 z-10">
        <!-- SVG Semi-circle Progress -->
        <svg class="w-48 h-28" viewbox="0 0 100 60">
            <path class="text-accent/20" d="M 10 50 A 40 40 0 1 1 90 50" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="8"></path>
            <path class="text-primary drop-shadow-[0_0_8px_rgba(204,255,0,0.5)]" d="M 10 50 A 40 40 0 0 1 50 10" fill="none" stroke="currentColor" stroke-dasharray="126" stroke-dashoffset="<%= typeof sessionsCompleted !== 'undefined' && typeof totalSessions !== 'undefined' && totalSessions > 0 ? (126 - (126 * (sessionsCompleted / totalSessions))) : 126 %>" stroke-linecap="round" stroke-width="8"></path>
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-end pb-2">
            <span class="text-4xl font-black text-slate-900 tracking-tighter"><%= typeof sessionsCompleted !== 'undefined' ? sessionsCompleted : 0 %><span class="text-xl text-slate-400">/<%= typeof totalSessions !== 'undefined' ? totalSessions : 0 %></span></span>
            <span class="text-[10px] uppercase tracking-widest text-primary font-bold mt-1">Đã hoàn thành</span>
            <% if (typeof remainingSessions !== 'undefined' && totalSessions > 0) { %>
            <span class="text-[9px] uppercase tracking-widest text-slate-500 font-bold">Còn lại: <strong class="text-slate-900"><%= remainingSessions %></strong> buổi</span>
            <% } %>
        </div>
    </div>
    <h3 class="text-slate-900 text-lg font-black tracking-tight relative z-10"><%= typeof packageName !== 'undefined' ? packageName : 'Chưa đăng ký Gói' %></h3>
    <p class="text-slate-500 text-xs mt-1 relative z-10 uppercase tracking-widest font-bold">
        <%= typeof sessionsCompleted !== 'undefined' && typeof totalSessions !== 'undefined' && sessionsCompleted >= totalSessions ? 'Bạn đã hoàn tất lộ trình gói tập!' : 'Giữ vững phong độ nhé!' %>
    </p>
</section>

<!-- Next action (Home = trợ lý hôm nay) -->
<section class="bg-white border border-slate-200 rounded-[32px] p-6 md:p-8 shadow-sm relative overflow-hidden">
    <div class="absolute -right-10 -top-10 w-32 h-32 bg-primary/5 rounded-full blur-2xl"></div>
    <div class="relative z-10 flex items-start justify-between gap-4">
        <div class="min-w-0">
            <h2 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Hôm nay</h2>
            <% if (typeof pendingConfirmation !== 'undefined' && pendingConfirmation) { %>
                <p class="text-lg font-black text-slate-900 mt-1">Xác nhận buổi tập</p>
                <p class="text-slate-600 text-xs mt-2 leading-relaxed">
                    HLV <strong><%= pendingConfirmation.pt.name %></strong> vừa hoàn thành buổi tập lúc
                    <%= new Date(pendingConfirmation.endTime).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', hour12: false }) %>.
                </p>
            <% } else if (typeof pendingFeedback !== 'undefined' && pendingFeedback) { %>
                <p class="text-lg font-black text-slate-900 mt-1">Đánh giá huấn luyện viên</p>
                <p class="text-slate-600 text-xs mt-2 leading-relaxed">
                    Buổi với HLV <strong><%= pendingFeedback.pt.name %></strong> — giúp FitCity cải thiện chất lượng.
                </p>
            <% } else if (typeof nextSession !== 'undefined' && nextSession) { %>
                <p class="text-lg font-black text-slate-900 mt-1">Buổi sắp tới</p>
                <p class="text-slate-600 text-xs mt-2 leading-relaxed">
                    <strong><%= nextSession.workoutPlan || 'Buổi tập cá nhân' %></strong>
                    · HLV <%= nextSession.pt && nextSession.pt.name ? nextSession.pt.name : '—' %>
                    · <%= new Date(nextSession.scheduledTime).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', hour12: false, day: '2-digit', month: '2-digit' }) %>
                </p>
            <% } else { %>
                <p class="text-lg font-black text-slate-900 mt-1">Chưa có lịch</p>
                <p class="text-slate-600 text-xs mt-2 leading-relaxed">Bạn chưa có buổi tập sắp tới. Kiểm tra lịch để đặt slot với PT.</p>
            <% } %>
        </div>
        <div class="shrink-0">
            <% if ((typeof pendingConfirmation !== 'undefined' && pendingConfirmation) || (typeof pendingFeedback !== 'undefined' && pendingFeedback)) { %>
                <span class="px-3 py-1 rounded-full bg-accent/10 text-accent text-[10px] font-black uppercase tracking-widest">Ưu tiên</span>
            <% } else { %>
                <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-black uppercase tracking-widest">Gợi ý</span>
            <% } %>
        </div>
    </div>

    <div class="relative z-10 mt-5">
        <% if (typeof pendingConfirmation !== 'undefined' && pendingConfirmation) { %>
            <div id="confirmSessionWrapper">
                <button type="button" onclick="confirmWorkoutSession('<%= pendingConfirmation._id %>')" class="w-full bg-primary hover:brightness-110 text-white font-black py-4 rounded-2xl text-center transition-all active:scale-[0.98] uppercase tracking-widest text-xs shadow-sm flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">task_alt</span>
                    XÁC NHẬN ĐÃ TẬP XONG
                </button>
            </div>
        <% } else if (typeof pendingFeedback !== 'undefined' && pendingFeedback) { %>
            <div id="feedbackWrapper" class="space-y-3">
                    <div class="flex justify-center gap-2" id="starRating">
                    <% for (let s = 1; s <= 5; s++) { %>
                    <button type="button" onclick="setFeedbackRating(<%= s %>)" class="feedback-star text-3xl text-slate-300 hover:text-amber-400 transition-colors" aria-label="<%= s %> sao">&#9733;</button>
                    <% } %>
                </div>
                <textarea id="feedbackComment" rows="2" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm" placeholder="Ghi chú (tuỳ chọn)"></textarea>
                <button type="button" onclick="submitSessionFeedback('<%= pendingFeedback._id %>')" class="w-full bg-primary text-white font-black py-4 rounded-2xl uppercase tracking-widest text-xs">GỬI ĐÁNH GIÁ</button>
            </div>
        <% } else if (typeof qrSession !== 'undefined' && qrSession) { %>
            <% if (qrSession.status === 'Scheduled') { %>
                <button type="button" onclick="openQrModal('<%= qrSession._id %>', 'start')" class="w-full inline-flex items-center justify-center gap-2 bg-primary text-white font-black py-4 rounded-2xl uppercase tracking-widest text-xs transition-all shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">qr_code_2</span>
                    QR CHECK-IN
                </button>
                <form action="/client/sessions/<%= qrSession._id %>/cancel-request" method="POST" class="mt-2">
                    <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-rose-100 hover:bg-rose-200 text-rose-700 font-black py-3 rounded-2xl uppercase tracking-widest text-[10px] transition-all border border-rose-200">
                        <span class="material-symbols-outlined text-[16px]">event_busy</span>
                        Gửi yêu cầu hủy
                    </button>
                </form>
            <% } else if (qrSession.status === 'In_Progress') { %>
                <button type="button" onclick="openQrModal('<%= qrSession._id %>', 'end')" class="w-full inline-flex items-center justify-center gap-2 bg-primary text-white font-black py-4 rounded-2xl uppercase tracking-widest text-xs transition-all shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">qr_code_2</span>
                    QR CHECK-OUT
                </button>
            <% } else if (qrSession.status === 'Cancel_Requested') { %>
                <button type="button" disabled class="w-full inline-flex items-center justify-center gap-2 bg-amber-100 text-amber-700 font-black py-4 rounded-2xl uppercase tracking-widest text-xs border border-amber-200 cursor-not-allowed">
                    <span class="material-symbols-outlined text-[18px]">hourglass_top</span>
                    Đang chờ PT phản hồi hủy
                </button>
            <% } %>
            <a href="/client/schedule" class="w-full inline-flex items-center justify-center gap-2 mt-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-black py-3 rounded-2xl uppercase tracking-widest text-[10px] transition-all">
                <span class="material-symbols-outlined text-[16px]">calendar_month</span>
                Lịch buổi tập
            </a>
        <% } else { %>
            <a href="/client/schedule" class="w-full inline-flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-black py-4 rounded-2xl uppercase tracking-widest text-xs transition-all">
                <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                Lịch buổi tập
            </a>
        <% } %>
    </div>
</section>

<% if (typeof contract !== 'undefined' && contract && contract.pt) { %>
<section class="bg-white border border-slate-200 rounded-[28px] p-5 flex items-center gap-4 shadow-sm">
    <img src="<%= contract.pt.avatar || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(contract.pt.name || 'PT')) %>" alt="" class="w-14 h-14 rounded-2xl object-cover border border-slate-200">
    <div class="flex-1 min-w-0">
        <p class="text-[10px] font-black uppercase tracking-widest text-slate-500">Huấn luyện viên</p>
        <p class="font-black text-slate-900 truncate"><%= contract.pt.name %></p>
    </div>
    <button type="button" onclick="openPtChangeModal()" class="shrink-0 px-4 py-2.5 rounded-xl border border-slate-200 text-[10px] font-black uppercase tracking-widest text-slate-600 hover:border-primary hover:text-primary transition-all">
        Đổi PT
    </button>
</section>
<% } %>
<!-- Nutrition Summary Area -->
<% if (typeof mealPlan !== 'undefined' && mealPlan) { %>
<section class="glass rounded-[32px] p-6 md:p-8 shadow-sm">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h2 class="text-xl font-black italic text-slate-900 tracking-tighter uppercase">Phác đồ dinh dưỡng</h2>
            <p class="text-[10px] text-primary font-bold uppercase tracking-widest mt-1"><%= mealPlan.goal %></p>
        </div>
        <div class="text-right">
            <span class="text-3xl font-black text-primary leading-none"><%= mealPlan.dailyCalories %></span>
            <p class="text-[9px] text-slate-500 font-bold uppercase tracking-widest mt-1">Kcal / Ngày</p>
        </div>
    </div>

    <!-- Macro Breakdown -->
    <div class="grid grid-cols-3 gap-3">
        <div class="bg-white/50 backdrop-blur-md p-4 rounded-2xl border border-slate-200/50 text-center transition-all hover:border-primary/20 cursor-default">
            <p class="text-[9px] text-slate-500 font-bold uppercase tracking-widest mb-1">Đạm</p>
            <div class="flex items-end justify-center gap-0.5">
                <span class="text-xl font-black text-slate-900"><%= mealPlan.macros.protein %></span>
                <span class="text-[10px] text-slate-600 mb-1 font-black">%</span>
            </div>
        </div>
        <div class="bg-white/50 backdrop-blur-md p-4 rounded-2xl border border-slate-200/50 text-center transition-all hover:border-primary/20 cursor-default">
            <p class="text-[9px] text-slate-500 font-bold uppercase tracking-widest mb-1">Tinh bột</p>
            <div class="flex items-end justify-center gap-0.5">
                <span class="text-xl font-black text-slate-900"><%= mealPlan.macros.carbs %></span>
                <span class="text-[10px] text-slate-600 mb-1 font-black">%</span>
            </div>
        </div>
        <div class="bg-white/50 backdrop-blur-md p-4 rounded-2xl border border-slate-200/50 text-center transition-all hover:border-primary/20 cursor-default">
            <p class="text-[9px] text-slate-500 font-bold uppercase tracking-widest mb-1">Chất béo</p>
            <div class="flex items-end justify-center gap-0.5">
                <span class="text-xl font-black text-slate-900"><%= mealPlan.macros.fat %></span>
                <span class="text-[10px] text-slate-600 mb-1 font-black">%</span>
            </div>
        </div>
    </div>
    
    <!-- Next Meal Hint -->
    <div class="mt-6 flex items-center justify-between px-2">
        <div class="flex items-center gap-3">
            <div class="size-2 rounded-full bg-primary animate-pulse shadow-[0_0_10px_rgba(204,255,0,0.8)]"></div>
            <span class="text-[10px] uppercase tracking-widest font-bold text-slate-500">Xem lịch chi tiết</span>
        </div>
        <a href="/client/nutrition" class="w-8 h-8 flex items-center justify-center bg-slate-100 rounded-full text-slate-500 hover:bg-primary hover:text-white transition-all">
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
    </div>
</section>
<% } %>

<!-- Ưu đãi -->
<section class="bg-white border border-slate-200 rounded-[32px] p-6 shadow-sm flex items-center justify-between gap-4">
    <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center border border-amber-200/50">
            <span class="material-symbols-outlined">redeem</span>
        </div>
        <div>
            <h3 class="text-slate-900 font-black text-sm uppercase tracking-tight">Ưu đãi của bạn</h3>
            <p class="text-slate-500 text-[10px] font-bold uppercase tracking-widest mt-0.5">
                <%= typeof activeRewardsCount !== 'undefined' ? activeRewardsCount : 0 %> ưu đãi còn hiệu lực
            </p>
        </div>
    </div>
    <a href="/client/rewards" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-black rounded-xl uppercase tracking-widest text-[10px] transition-all">
        XEM
    </a>
</section>
</main>
<!-- Bottom Navigation -->
<% const activePage = 'dashboard'; %>
<%- include('../partials/client-bottom-nav', { activePage }) %>
<% if (typeof contract !== 'undefined' && contract && contract.pt) { %>
<%- include('../partials/client-pt-change-modal', { pt: contract.pt }) %>
<% } %>
<%- include('../partials/client-qr-modal') %>

<script>
    let selectedFeedbackRating = 0;
    function setFeedbackRating(n) {
        selectedFeedbackRating = n;
        document.querySelectorAll('.feedback-star').forEach((el, i) => {
            el.classList.toggle('text-amber-400', i < n);
            el.classList.toggle('text-slate-300', i >= n);
        });
    }
    async function submitSessionFeedback(sessionId) {
        if (!selectedFeedbackRating) {
            alert('Vui lòng chọn số sao từ 1 đến 5.');
            return;
        }
        const comment = document.getElementById('feedbackComment')?.value || '';
        const res = await fetch(`/client/sessions/${sessionId}/feedback`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ rating: selectedFeedbackRating, comment })
        });
        const data = await res.json();
        if (data.success) {
            document.getElementById('feedbackWrapper')?.remove();
            alert('Cảm ơn bạn đã đánh giá!');
        } else {
            alert(data.message || 'Có lỗi xảy ra');
        }
    }
    async function confirmWorkoutSession(sessionId) {
        const btn = document.querySelector('#confirmSessionWrapper button');
        const card = btn.closest('section');
        
        // UI Loading state
        btn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span> ĐANG XÁC NHẬN...';
        btn.classList.add('opacity-80', 'cursor-not-allowed');
        btn.disabled = true;
        
        try {
            const res = await fetch(`/client/sessions/confirm/${sessionId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                }
            });
            
            const data = await res.json();
            if (data.success) {
                // Success animation
                btn.classList.remove('bg-primary', 'opacity-80', 'cursor-not-allowed');
                btn.classList.add('bg-emerald-500');
                btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check_circle</span> HOÀN THÀNH!';
                
                // Slide out and remove card after delay
                setTimeout(() => {
                    card.style.transition = 'all 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
                    card.style.transform = 'translateY(-20px) scale(0.95)';
                    card.style.opacity = '0';
                    card.style.height = '0';
                    card.style.padding = '0';
                    card.style.margin = '0';
                    card.style.borderWidth = '0';
                    setTimeout(() => card.remove(), 500);
                }, 800);
            } else {
                alert(data.message || 'Có lỗi xảy ra!');
                btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">task_alt</span> XÁC NHẬN ĐÃ TẬP XONG';
                btn.classList.remove('opacity-80', 'cursor-not-allowed');
                btn.disabled = false;
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối. Vui lòng thử lại sau!');
            btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">task_alt</span> XÁC NHẬN ĐÃ TẬP XONG';
            btn.classList.remove('opacity-80', 'cursor-not-allowed');
            btn.disabled = false;
        }
    }
</script>
</body></html>