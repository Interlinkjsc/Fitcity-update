# FitCity — production environment (EXAMPLE ONLY)
# Copy to server: /opt/fitcity/env/.env.production
# chmod 600 — never commit the real file

NODE_ENV=production
PORT=3000

# MongoDB — use auth in production; bind mongo to 127.0.0.1 only
# Example: mongodb://fitcity_app:CHANGE_ME@127.0.0.1:27017/Fitcity?authSource=Fitcity
# Bare metal: mongodb://127.0.0.1:27017/Fitcity
# Docker Compose overrides to mongodb://mongo:27017/Fitcity in compose file
MONGODB_URI=mongodb://127.0.0.1:27017/Fitcity

# Required in production (app exits if missing when NODE_ENV=production)
SESSION_SECRET=generate_openssl_rand_hex_32
# Must be exactly 32 characters (AES-256)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
QR_HMAC_SECRET=generate_openssl_rand_hex_32

# Google Drive (contracts / uploads)
GOOGLE_APPLICATION_CREDENTIALS=/opt/fitcity/secrets/google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# Set on host .env if needed; Compose sets TRUST_PROXY=1 for Docker deploy
# TRUST_PROXY=1
# HTTP by IP only (no SSL): COOKIE_SECURE=false — Compose sets this until you use HTTPS
# COOKIE_SECURE=false
